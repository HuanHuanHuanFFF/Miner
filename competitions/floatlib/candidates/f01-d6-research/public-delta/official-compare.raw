te_admin":false},"parents":[{"sha":"21e42d8f93cd3ecdf5dc4a84c7951ad4c17b185c","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/21e42d8f93cd3ecdf5dc4a84c7951ad4c17b185c","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/21e42d8f93cd3ecdf5dc4a84c7951ad4c17b185c"},{"sha":"eff6e0fdc66f447de926d6544a14b3a92afef737","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/eff6e0fdc66f447de926d6544a14b3a92afef737","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/eff6e0fdc66f447de926d6544a14b3a92afef737"}]},{"sha":"dd1f4cc624e621cb472757d642c988a210dea742","node_id":"C_kwDOU-E3Y9oAKGRkMWY0Y2M2MjRlNjIxY2I0NzI3NTdkNjQyYzk4OGEyMTBkZWE3NDI","commit":{"author":{"name":"rob-dendrite","email":"rg@dendrite.holdings","date":"2026-10-22T13:34:02Z"},"committer":{"name":"rob-dendrite","email":"rg@dendrite.holdings","date":"2026-10-22T13:34:02Z"},"message":"Hide the private suite file from every build and bench sandbox\n\nThe sandbox binds / read-only and hides only HOME, the checkout and the runtime dir, so a suite\nkept where OPERATIONS suggests (/etc/floatlib/suites) was readable from inside it by the gate's own\nuser. The policy's banned tokens stop the known ways a Kernel.lean reads files, but the file should\nnot be there to read: bwrap now binds /dev/null over GATE_FULL_SUITE, as named and as resolved,\nunless HOME's, the checkout's or /tmp's tmpfs already covers it. Benches get their cases through\nBENCH_PLAN, so nothing in the sandbox needs the file.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"39ef852e654f55eb560d9ae082e87f2db3a2496c","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/git/trees/39ef852e654f55eb560d9ae082e87f2db3a2496c"},"url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/git/commits/dd1f4cc624e621cb472757d642c988a210dea742","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/dd1f4cc624e621cb472757d642c988a210dea742","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/dd1f4cc624e621cb472757d642c988a210dea742","comments_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/dd1f4cc624e621cb472757d642c988a210dea742/comments","author":{"login":"rob-dendrite","id":289653679,"node_id":"U_kgDOEUPDrw","avatar_url":"https://avatars.githubusercontent.com/u/289653679?v=4","gravatar_id":"","url":"https://api.github.com/users/rob-dendrite","html_url":"https://github.com/rob-dendrite","followers_url":"https://api.github.com/users/rob-dendrite/followers","following_url":"https://api.github.com/users/rob-dendrite/following{/other_user}","gists_url":"https://api.github.com/users/rob-dendrite/gists{/gist_id}","starred_url":"https://api.github.com/users/rob-dendrite/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rob-dendrite/subscriptions","organizations_url":"https://api.github.com/users/rob-dendrite/orgs","repos_url":"https://api.github.com/users/rob-dendrite/repos","events_url":"https://api.github.com/users/rob-dendrite/events{/privacy}","received_events_url":"https://api.github.com/users/rob-dendrite/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"rob-dendrite","id":289653679,"node_id":"U_kgDOEUPDrw","avatar_url":"https://avatars.githubusercontent.com/u/289653679?v=4","gravatar_id":"","url":"https://api.github.com/users/rob-dendrite","html_url":"https://github.com/rob-dendrite","followers_url":"https://api.github.com/users/rob-dendrite/followers","following_url":"https://api.github.com/users/rob-dendrite/following{/other_user}","gists_url":"https://api.github.com/users/rob-dendrite/gists{/gist_id}","starred_url":"https://api.github.com/users/rob-dendrite/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rob-dendrite/subscriptions","organizations_url":"https://api.github.com/users/rob-dendrite/orgs","repos_url":"https://api.github.com/users/rob-dendrite/repos","events_url":"https://api.github.com/users/rob-dendrite/events{/privacy}","received_events_url":"https://api.github.com/users/rob-dendrite/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"70d6da176d8ab5524ec2b44e81c6230162ec7362","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/70d6da176d8ab5524ec2b44e81c6230162ec7362","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/70d6da176d8ab5524ec2b44e81c6230162ec7362"}]},{"sha":"a0e80de64aa5394a42b1c9a237c15047ec766f73","node_id":"C_kwDOU-E3Y9oAKGEwZTgwZGU2NGFhNTM5NGE0MmIxYzlhMjM3YzE1MDQ3ZWM3NjZmNzM","commit":{"author":{"name":"rob-dendrite","email":"rg@dendrite.holdings","date":"2026-10-22T13:38:20Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-22T13:38:20Z"},"message":"Merge pull request #18 from conjectures-io/fix/sandbox-hides-suite\n\nHide the private suite file from every build and bench sandbox","tree":{"sha":"39ef852e654f55eb560d9ae082e87f2db3a2496c","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/git/trees/39ef852e654f55eb560d9ae082e87f2db3a2496c"},"url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/git/commits/a0e80de64aa5394a42b1c9a237c15047ec766f73","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq2hHMCRC1aQ7uu5UhlAAAu1kQADxm+Nf9SCvY86euLbl1hXyz\nDe7XHZpkEKwELLrHUxvNbJ/LPq0cD5IOcwMeb1zz8uNqVqlbqQi1sP0DRTgYH8R8\nbY2KpIeq5W1dzuTS7xoqq/GLE9exnUjJ