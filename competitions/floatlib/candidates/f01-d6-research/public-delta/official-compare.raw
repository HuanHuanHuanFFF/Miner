thub.com/users/dendrite-belps/followers","following_url":"https://api.github.com/users/dendrite-belps/following{/other_user}","gists_url":"https://api.github.com/users/dendrite-belps/gists{/gist_id}","starred_url":"https://api.github.com/users/dendrite-belps/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dendrite-belps/subscriptions","organizations_url":"https://api.github.com/users/dendrite-belps/orgs","repos_url":"https://api.github.com/users/dendrite-belps/repos","events_url":"https://api.github.com/users/dendrite-belps/events{/privacy}","received_events_url":"https://api.github.com/users/dendrite-belps/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"978cc5b445edb9943fd9953b0a9037d97a9f33a8","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/978cc5b445edb9943fd9953b0a9037d97a9f33a8","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/978cc5b445edb9943fd9953b0a9037d97a9f33a8"},{"sha":"a631d500381d89cc0a20a257e40e788c79787101","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/a631d500381d89cc0a20a257e40e788c79787101","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/a631d500381d89cc0a20a257e40e788c79787101"}]},{"sha":"eff6e0fdc66f447de926d6544a14b3a92afef737","node_id":"C_kwDOU-E3Y9oAKGVmZjZlMGZkYzY2ZjQ0N2RlOTI2ZDY1NDRhMTRiM2E5MmFmZWY3Mzc","commit":{"author":{"name":"rob-dendrite","email":"rg@dendrite.holdings","date":"2026-10-22T12:37:20Z"},"committer":{"name":"rob-dendrite","email":"rg@dendrite.holdings","date":"2026-10-22T12:37:20Z"},"message":"Score the full entry on a wider, private test set, behind GATE_FULL_SUITE\n\nThe full entry is timed on twelve fixed public classes: one exponent band, one sum length, one bmm\nshape, no NaN, infinity or subnormal input timed and no zeros in mul. A fast path whose fallback\nthe benchmark never meets wins. With GATE_FULL_SUITE set the full entry is instead timed on a\nfresh plan of about 200 cases drawn per run from a suite: groups of value families (ML-like\nmagnitudes, zeros, subnormals, specials by rate, stride, burst or row edge, bf16/fp16 rounding,\ncodebooks, block scales, tied operands) and wide sum lengths and bmm shapes, built by\nlean/bench/BenchSuite.lean.\n\nOnly the inputs change. The ratio is the legacy total of fastest times, submission over champion,\nthe rounds are the legacy per-round totals, and admission, the verdict's fields and validator/ are\nunchanged. Cases are sized to take about equal time on the shipped baseline: a poisoned\naccumulation costs it 30-100 times a clean step, so each case's budget is divided by\n1 + fallback_cost × slow_share, estimated from its drawn parameters (specials, single-product and\naccumulated overflow, accumulation length), never from a timing. The verdict carries per-cell times\nand the suite's version and hash, never the plan.\n\nsuites/public-v2.json is the public suite for tuning; the paid board's suite stays private. Unset,\nnothing changes. validator/tools/kings.py writes the paid kings and what each beat, to re-time them\non the suite before switching.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"ed61b1b212064db99286c2b9ba2a2331100f5d68","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/git/trees/ed61b1b212064db99286c2b9ba2a2331100f5d68"},"url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/git/commits/eff6e0fdc66f447de926d6544a14b3a92afef737","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/eff6e0fdc66f447de926d6544a14b3a92afef737","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/eff6e0fdc66f447de926d6544a14b3a92afef737","comments_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/eff6e0fdc66f447de926d6544a14b3a92afef737/comments","author":{"login":"rob-dendrite","id":289653679,"node_id":"U_kgDOEUPDrw","avatar_url":"https://avatars.githubusercontent.com/u/289653679?v=4","gravatar_id":"","url":"https://api.github.com/users/rob-dendrite","html_url":"https://github.com/rob-dendrite","followers_url":"https://api.github.com/users/rob-dendrite/followers","following_url":"https://api.github.com/users/rob-dendrite/following{/other_user}","gists_url":"https://api.github.com/users/rob-dendrite/gists{/gist_id}","starred_url":"https://api.github.com/users/rob-dendrite/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rob-dendrite/subscriptions","organizations_url":"https://api.github.com/users/rob-dendrite/orgs","repos_url":"https://api.github.com/users/rob-dendrite/repos","events_url":"https://api.github.com/users/rob-dendrite/events{