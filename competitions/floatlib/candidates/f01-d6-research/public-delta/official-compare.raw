ub.com/users/dendrite-belps/subscriptions","organizations_url":"https://api.github.com/users/dendrite-belps/orgs","repos_url":"https://api.github.com/users/dendrite-belps/repos","events_url":"https://api.github.com/users/dendrite-belps/events{/privacy}","received_events_url":"https://api.github.com/users/dendrite-belps/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3e8015b3c904c2b3217e55b95f1aed59991148b6","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/3e8015b3c904c2b3217e55b95f1aed59991148b6","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/3e8015b3c904c2b3217e55b95f1aed59991148b6"}]},"merge_base_commit":{"sha":"978cc5b445edb9943fd9953b0a9037d97a9f33a8","node_id":"C_kwDOU-E3Y9oAKDk3OGNjNWI0NDVlZGI5OTQzZmQ5OTUzYjBhOTAzN2Q5N2E5ZjMzYTg","commit":{"author":{"name":"dendrite-belps","email":"ac@dendrite.holdings","date":"2026-10-15T13:19:13Z"},"committer":{"name":"dendrite-belps","email":"ac@dendrite.holdings","date":"2026-10-15T13:19:13Z"},"message":"Revert \"Add the exact-runtime slot: thirteen proved neural-network kernels scored on a calibrated model suite, with fixtures, tests, a showcase benchmark and its guide.\"\n\nThis reverts commit 3e8015b3c904c2b3217e55b95f1aed59991148b6.","tree":{"sha":"d790bec3b28ddf83e341a1c4e427622985a045b6","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/git/trees/d790bec3b28ddf83e341a1c4e427622985a045b6"},"url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/git/commits/978cc5b445edb9943fd9953b0a9037d97a9f33a8","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/978cc5b445edb9943fd9953b0a9037d97a9f33a8","html_url":"https://github.com/conjectures-io/conj