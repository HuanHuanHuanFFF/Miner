s://api.github.com/users/rob-dendrite/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rob-dendrite/subscriptions","organizations_url":"https://api.github.com/users/rob-dendrite/orgs","repos_url":"https://api.github.com/users/rob-dendrite/repos","events_url":"https://api.github.com/users/rob-dendrite/events{/privacy}","received_events_url":"https://api.github.com/users/rob-dendrite/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"70d6da176d8ab5524ec2b44e81c6230162ec7362","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/70d6da176d8ab5524ec2b44e81c6230162ec7362","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/70d6da176d8ab5524ec2b44e81c6230162ec7362"},{"sha":"dd1f4cc624e621cb472757d642c988a210dea742","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/dd1f4cc624e621cb472757d642c988a210dea742","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/dd1f4cc624e621cb472757d642c988a210dea742"}]}],"files":[{"sha":"d2ab3a110fd76e81f1b35fd34c4fab162670685a","filename":".env.example","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/.env.example","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/.env.example","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/.env.example?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -16,6 +16,10 @@\n # The core both benches run on; pick an idle one on the validator.\n #BENCH_CPU=3\n #BENCH_ROUNDS=25\n+# The suite the full entry is scored on (docs/BENCHMARKING.md#suite-scoring); unset, the legacy\n+# twelve classes. On the paid board this is the operator's private suite, kept outside the checkout\n+# and readable only by the gate's account; suites/public-v2.json is the public one.\n+#GATE_FULL_SUITE=/etc/floatlib/suites/scoring.json\n # Per-command caps for the gate's sandbox, applied through a user systemd scope (no swap).\n # 0 lifts a memory cap; a host without a user systemd session needs `loginctl enable-linger`.\n #GATE_BUILD_MEMORY_MB=4096"},{"sha":"73bb804188dfe03fdf655d9bb1f1540c29d00100","filename":".github/workflows/ci.yml","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/.github%2Fworkflows%2Fci.yml","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/.github%2Fworkflows%2Fci.yml","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/.github%2Fworkflows%2Fci.yml?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -35,9 +35,11 @@ jobs:\n       - uses: actions/setup-python@v5\n         with:\n           python-version: \"3.12\"\n-      - run: pip install -r requirements/gate.txt -r requirements/test.txt ruff==0.16.9\n+      - run: pip install -r requirements/gate.txt -r requirements/test.txt ruff==0.16.9 reuse==5.0.2\n       - run: ruff check .\n       - run: ruff format --check .\n+      # Every file's copyright and licence, from REUSE.toml: a new file outside its annotations fails here.\n+      - run: reuse lint\n       # -rs lists why the db suite skipped, if it did: a silent skip would pass the job.\n       - run: python -m pytest -q -m \"not slow\" -rs\n "},{"sha":"4cbbea334cfa64cfbd92fddbad7b4c5bfa29c883","filename":"LICENSE","status":"added","additions":21,"deletions":0,"changes":21,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/LICENSE","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/LICENSE","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/LICENSE?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -0,0 +1,21 @@\n+MIT License\n+\n+Copyright (c) 2026 Conjectures.io\n+\n+Permission is hereby granted, free of charge, to any person obtaining a copy\n+of this software and associated documentation files (the \"Software\"), to deal\n+in the Software without restriction, including without limitation the rights\n+to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n+copies of the Software, and to permit persons to whom the Software is\n+furnished to do so, subject to the following conditions:\n+\n+The above copyright notice and this permission notice shall be included in all\n+copies or substantial portions of the Software.\n+\n+THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n+IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n+FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n+AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n+LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n+OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n+SOFTWARE."},{"sha":"d817195dad53ec992418c28ffca5fbd1cd86502a","filename":"LICENSES/MIT.txt","status":"added","additions":18,"deletions":0,"changes":18,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/LICENSES%2FMIT.txt","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/LICENSES%2FMIT.txt","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/LICENSES%2FMIT.txt?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -0,0 +1,18 @@\n+MIT License\n+\n+Copyright (c) <year> <copyright holders>\n+\n+Permission is hereby granted, free of charge, to any person obtaining a copy of this software and\n+associated documentation files (the \"Software\"), to deal in the Software without restriction, including\n+without limitation the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n+copies of the Software, and to permit persons to whom the Software is furnished to do so, subject to the\n+following conditions:\n+\n+The above copyright notice and this permission notice shall be included in all copies or substantial\n+portions of the Software.\n+\n+THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT\n+LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO\n+EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER\n+IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\n+USE OR OTHER DEALINGS IN THE SOFTWARE."},{"sha":"02bab44ef6da6a34b035359158fa0b8ef7ada00c","filename":"MANUAL.md","status":"modified","additions":24,"deletions":0,"changes":24,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/MANUAL.md","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/MANUAL.md","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/MANUAL.md?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -86,6 +86,18 @@ BENCH_SEED=42 python gate.py --slot full --bench my-entry\n \n Inspect all class timings, not only the headline ratio. See\n [Benchmarking](docs/BENCHMARKING.md) for aggregation and statistical admission.\n+\n+The paid board is scored on a private suite of inputs: ML-like magnitudes,\n+zeros, subnormals, NaN and infinities, paired operands and many vector lengths and\n+matrix shapes. Tune on the public suite with the same groups:\n+\n+```bash\n+GATE_FULL_SUITE=suites/public-v2.json BENCH_SEED=42 python gate.py --slot full --bench my-entry\n+```\n+\n+The ratio and promotion rules are the same as on the legacy classes; only the\n+inputs differ, so a fast path with a slow fallback pays for every case that hits\n+the fallback. See [Suite scoring](docs/BENCHMARKING.md#suite-scoring).\n Logs are under `logs/`; verdicts and paired timings are under `results/`.\n \n ## 4. Submit\n@@ -181,6 +193,18 @@ ranks. The shipped baseline currently has no selectable submission ID.\n See the [live competition](https://conjectures.io/competitions/floatlib) for current\n champions and measurements.\n \n+## 7. Licence\n+\n+This repository is under the [MIT licence](LICENSE). The shipped kernels and the contracts also\n+reproduce or restate code from FloatLib and TorchLean, both MIT-licensed, so their notices apply as\n+well: [THIRD_PARTY_NOTICES.md](THIRD_PARTY_NOTICES.md) has them, and [REUSE.toml](REUSE.toml) says\n+which files each covers. If you start from a shipped kernel, as `cp -r kernels/full/incumbent`\n+does, your entry contains that code, and those notices go with it.\n+\n+When you submit a `Kernel.lean`, you license it under the MIT licence, so that the competition can\n+store, build, benchmark and publish it, and a promoted entry can become the reference later entries\n+are timed against. Submit only code you have the right to license this way.\n+\n ## Troubleshooting\n \n | Symptom | Next step |"},{"sha":"17c5ce4de5fe16f026a4e68c8e16ba51568091d6","filename":"README.md","status":"modified","additions":10,"deletions":1,"changes":11,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/README.md","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/README.md","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/README.md?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -94,9 +94,10 @@ experiments and historical reads.\n ## Development checks\n \n ```bash\n-.venv/bin/pip install -r requirements/test.txt ruff==0.16.9\n+.venv/bin/pip install -r requirements/test.txt ruff==0.16.9 reuse==5.0.2\n .venv/bin/python -m ruff check .\n .venv/bin/python -m ruff format --check .\n+.venv/bin/reuse lint\n .venv/bin/python -m pytest -q -m \"not slow\"\n ```\n \n@@ -107,3 +108,11 @@ Timing assertions can fail on a busy host.\n \n CI runs lint and fast tests on pushes and pull requests. Scheduled and manually\n triggered gate jobs also run setup, real-gate tests, and the self-test.\n+\n+## Licence\n+\n+MIT; see [LICENSE](LICENSE). The contracts, the kernels and stage 2 restate or adapt\n+[FloatLib](https://github.com/lean-dojo/FloatLib) and [TorchLean](https://github.com/lean-dojo/TorchLean)\n+code, both MIT-licensed, and the migrations use Alembic's template: their notices are in\n+[THIRD_PARTY_NOTICES.md](THIRD_PARTY_NOTICES.md), and [REUSE.toml](REUSE.toml) says which files each\n+covers. Submissions are made under the same licence; see the [miner guide](MANUAL.md#7-licence)."},{"sha":"7f4235c4ba5cd5c20c6d4a1431c470e008638f1a","filename":"REUSE.toml","status":"added","additions":42,"deletions":0,"changes":42,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/REUSE.toml","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/REUSE.toml","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/REUSE.toml?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -0,0 +1,42 @@\n+# Copyright and licence of every file, in the REUSE format (https://reuse.software), so that\n+# `reuse lint` can check it. It is kept here rather than in a header in each file because the\n+# verifier fingerprint (fingerprint.py) hashes gate.py, the Lake files and the contract, verify and\n+# bench modules, and the shipped kernels are the champions boards are measured against: a header\n+# would change those bytes. When several annotations match a file, the last one applies.\n+# THIRD_PARTY_NOTICES.md says what each upstream notice covers.\n+version = 1\n+\n+# Everything is this project's, under the MIT licence in LICENSE.\n+[[annotations]]\n+path = \"**\"\n+SPDX-FileCopyrightText = \"2026 Conjectures.io\"\n+SPDX-License-Identifier = \"MIT\"\n+\n+# The contract restates FloatLib's specification, and the kernels and stage 2 reproduce or adapt its\n+# certified word kernels and their helpers (\"step for step\" in `kernels/add/mirror`, and every\n+# kernel built from it). FloatLib is MIT-licensed.\n+[[annotations]]\n+path = [\"kernels/**/*.lean\", \"lean/contract/*.lean\", \"lean/stage2/**/*.lean\"]\n+SPDX-FileCopyrightText = [\"2026 Conjectures.io\", \"2026 FloatLib\"]\n+SPDX-License-Identifier = \"MIT\"\n+\n+# The tensor slots also restate TorchLean's `reduceSumLeftSpec` and `bmmSpec` and its obligations\n+# (`lean/contract/ContractTensor.lean`, proved equal to TorchLean's in `lean/stage2/Stage2/Link.lean`).\n+# TorchLean is MIT-licensed.\n+[[annotations]]\n+path = [\n+    \"kernels/sum/**/*.lean\",\n+    \"kernels/bmm/**/*.lean\",\n+    \"kernels/full/**/*.lean\",\n+    \"lean/contract/ContractTensor.lean\",\n+    \"lean/stage2/**/*.lean\",\n+]\n+SPDX-FileCopyrightText = [\"2026 Conjectures.io\", \"2026 FloatLib\", \"2026 TorchLean\"]\n+SPDX-License-Identifier = \"MIT\"\n+\n+# Alembic's migration template, and the environment script written from Alembic's own. Alembic is\n+# MIT-licensed.\n+[[annotations]]\n+path = [\"deploy/migrate/alembic/script.py.mako\", \"deploy/migrate/alembic/env.py\"]\n+SPDX-FileCopyrightText = [\"2026 Conjectures.io\", \"2009-2026 Michael Bayer\"]\n+SPDX-License-Identifier = \"MIT\""},{"sha":"5ccf7fa27348ef8f8f451c187ff0065bb56b448c","filename":"THIRD_PARTY_NOTICES.md","status":"added","additions":120,"deletions":0,"changes":120,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/THIRD_PARTY_NOTICES.md","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/THIRD_PARTY_NOTICES.md","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/THIRD_PARTY_NOTICES.md?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -0,0 +1,120 @@\n+# Third-party notices\n+\n+This repository is under the MIT licence in [LICENSE](LICENSE). Some of its files reproduce, adapt\n+or restate code from the projects below, whose licences ask that their notices travel with that\n+code; those notices are reproduced here in full. [REUSE.toml](REUSE.toml) records, file by file,\n+which notices apply, and `reuse lint` checks it.\n+\n+If you copy a shipped kernel, contract or migration file into your own work, a submission\n+included, keep the notices that apply to it.\n+\n+## Included in this repository\n+\n+### FloatLib\n+\n+[FloatLib](https://github.com/lean-dojo/FloatLib), MIT licence. The contract\n+(`lean/contract/`) restates FloatLib's IEEE 754 specification as the obligations a kernel must meet,\n+and the kernels (`kernels/`) and stage 2 (`lean/stage2/`) reproduce or adapt FloatLib's certified\n+binary32 word kernels and their helpers: `kernels/add/mirror` runs FloatLib's word addition step\n+for step on bare words, and the faster kernels are built from it.\n+\n+```text\n+MIT License\n+\n+Copyright (c) 2026 FloatLib\n+\n+Permission is hereby granted, free of charge, to any person obtaining a copy\n+of this software and associated documentation files (the \"Software\"), to deal\n+in the Software without restriction, including without limitation the rights\n+to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n+copies of the Software, and to permit persons to whom the Software is\n+furnished to do so, subject to the following conditions:\n+\n+The above copyright notice and this permission notice shall be included in all\n+copies or substantial portions of the Software.\n+\n+THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n+IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n+FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n+AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n+LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n+OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n+SOFTWARE.\n+```\n+\n+### TorchLean\n+\n+[TorchLean](https://github.com/lean-dojo/TorchLean), MIT licence. The tensor contract\n+(`lean/contract/ContractTensor.lean`) restates TorchLean's `reduceSumLeftSpec` and `bmmSpec`, and\n+the `sum`, `bmm` and full-entry kernels and `lean/stage2/` are written against those definitions;\n+`lean/stage2/Stage2/Link.lean` proves the restatements equal to TorchLean's own.\n+\n+```text\n+MIT License\n+\n+Copyright (c) 2026 TorchLean\n+\n+Permission is hereby granted, free of charge, to any person obtaining a copy\n+of this software and associated documentation files (the \"Software\"), to deal\n+in the Software without restriction, including without limitation the rights\n+to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n+copies of the Software, and to permit persons to whom the Software is\n+furnished to do so, subject to the following conditions:\n+\n+The above copyright notice and this permission notice shall be included in all\n+copies or substantial portions of the Software.\n+\n+THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n+IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n+FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n+AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n+LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n+OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n+SOFTWARE.\n+```\n+\n+### Alembic\n+\n+[Alembic](https://github.com/sqlalchemy/alembic), MIT licence. `deploy/migrate/alembic/script.py.mako`\n+is Alembic's migration template, and `deploy/migrate/alembic/env.py` is written from Alembic's\n+environment template.\n+\n+```text\n+Copyright 2009-2026 Michael Bayer.\n+\n+Permission is hereby granted, free of charge, to any person obtaining a copy of\n+this software and associated documentation files (the \"Software\"), to deal in\n+the Software without restriction, including without limitation the rights to\n+use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies\n+of the Software, and to permit persons to whom the Software is furnished to do\n+so, subject to the following conditions:\n+\n+The above copyright notice and this permission notice shall be included in all\n+copies or substantial portions of the Software.\n+\n+THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n+IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n+FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n+AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n+LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n+OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n+SOFTWARE.\n+```\n+\n+## Used but not included\n+\n+These are downloaded by `setup.sh`, the Lean build, `scripts/install-bubblewrap.sh` or `pip`, and\n+none of their code is part of this repository. Each comes under its own licence, which applies to\n+anyone who downloads, builds or redistributes it, including in a container image.\n+\n+| Component | Fetched by | Licence |\n+| --- | --- | --- |\n+| [Lean 4](https://github.com/leanprover/lean4) toolchain and [elan](https://github.com/leanprover/elan) | `setup.sh` | Apache-2.0 |\n+| [FloatLib](https://github.com/lean-dojo/FloatLib) and [TorchLean](https://github.com/lean-dojo/TorchLean) as Lake packages | `lean/lake-manifest.json` | MIT |\n+| [Mathlib](https://github.com/leanprover-community/mathlib4), [Batteries](https://github.com/leanprover-community/batteries), [Aesop](https://github.com/leanprover-community/aesop), [Qq](https://github.com/leanprover-community/quote4), [ProofWidgets](https://github.com/leanprover-community/ProofWidgets4), [Plausible](https://github.com/leanprover-community/plausible), [LeanSearchClient](https://github.com/leanprover-community/LeanSearchClient), [import-graph](https://github.com/leanprover-community/import-graph), [doc-gen4](https://github.com/leanprover/doc-gen4), [leansqlite](https://github.com/leanprover/leansqlite), [UnicodeBasic](https://github.com/fgdorais/lean4-unicode-basic), [BibtexQuery](https://github.com/dupuisf/BibtexQuery) | `lean/lake-manifest.json` | Apache-2.0 |\n+| [lean4-cli](https://github.com/leanprover/lean4-cli), [MD4Lean](https://github.com/acmepjz/md4lean) | `lean/lake-manifest.json` | MIT |\n+| [bubblewrap](https://github.com/containers/bubblewrap) | `scripts/install-bubblewrap.sh` | LGPL-2.0-or-later |\n+| bittensor, requests, python-multipart | `requirements/` | Apache-2.0 |\n+| alembic, bittensor-wallet, fastapi, loguru, pydantic, pydantic-settings, pytest, SQLAlchemy | `requirements/` | MIT |\n+| httpx | `requirements/` | BSD-3-Clause |\n+| psycopg | `requirements/` | LGPL-3.0-only |"},{"sha":"cd1d3d2bec17db66bdb369e8b81e839b8c7d73ad","filename":"benchmark_suite.py","status":"added","additions":483,"deletions":0,"changes":483,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/benchmark_suite.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/benchmark_suite.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/benchmark_suite.py?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -0,0 +1,483 @@\n+\"\"\"Benchmark suites for the full entry: a suite file describes kinds of input, a plan draws cases.\n+\n+A suite is a JSON file. Its *groups* are the published headings results are reported under (a\n+group's name is public, as are the scores under it); its *families* are the value generators inside\n+a group, with parameter ranges each case draws from. The paid board is scored on a private suite\n+the operator keeps outside the repository (GATE_FULL_SUITE); `suites/public-v2.json` is the public\n+suite for local tuning, built from the same generators. Without GATE_FULL_SUITE the gate times the\n+legacy twelve classes, as before.\n+\n+`make_plan` turns a suite, a seed and a work budget into concrete cases for the Lean harness\n+(`lean/bench/BenchSuite.lean`, which reads them from BENCH_PLAN). The plan never leaves the gate:\n+the verdict carries each cell's (kernel and group's) times, never a case's parameters or its size.\n+Cases are sized to take about equal time on the shipped baseline (`_equal_time`), so a kind of\n+input counts by its number of cases, not by how slow the baseline is on it.\n+\n+`summarise` scores the timed rounds exactly as the gate scores the legacy classes: per case the\n+fastest round of each side, and the ratio is the submission's total over the incumbent's, so a case\n+counts by the time it takes. Only the inputs change; admission reads the same per-round totals.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import hashlib\n+import json\n+import math\n+import os\n+import random\n+from pathlib import Path\n+\n+KERNELS = (\"add\", \"mul\", \"sum\", \"bmm\")\n+SCALAR = (\"add\", \"mul\")\n+\n+# Enumerations the Lean harness reads as numbers; the suite file names them.\n+MAGNITUDES = {\"uniform\": 0, \"geometric\": 1, \"raw\": 2}\n+ZERO_KINDS = {\"pos\": 0, \"neg\": 1, \"signed\": 2, \"leak\": 3}\n+PLACEMENTS = {\"random\": 0, \"stride\": 1, \"burst\": 2, \"edge\": 3}\n+SPECIALS = {\"inf\": 1, \"nan\": 2, \"max\": 4, \"sub\": 8, \"zero\": 16}\n+RELATIONS = {\n+    \"independent\": 0,\n+    \"equal\": 1,\n+    \"negate\": 2,\n+    \"cancel\": 3,\n+    \"broadcast\": 4,\n+    \"identity\": 5,\n+    \"offset\": 6,\n+    \"near\": 7,\n+}\n+\n+# Value parameters with their defaults (each one off), in the order the harness's Case lists them.\n+DEFAULTS: dict[str, object] = {\n+    \"magnitude\": \"uniform\",\n+    \"center\": 127,\n+    \"spread\": 3,\n+    \"positive\": 50,\n+    \"mantissa_bits\": 23,\n+    \"codebook\": 0,\n+    \"scale_block\": 0,\n+    \"scale_shift\": 0,\n+    \"zero_pct\": 0,\n+    \"zero_cluster\": 1,\n+    \"zero_kind\": \"pos\",\n+    \"sub_pct\": 0,\n+    \"sub_block\": 1,\n+    \"special_rate\": 0,\n+    \"special_place\": \"random\",\n+    \"special_period\": 64,\n+    \"special_burst\": 8,\n+    \"specials\": [\"inf\", \"nan\", \"max\", \"sub\", \"zero\"],\n+    \"relation\": \"independent\",\n+    \"relation_param\": 0,\n+}\n+SIZE_KEYS = {\"sum\": (\"length\",), \"bmm\": (\"m\", \"n\", \"p\")}\n+# A plan's JSON travels in the bench's environment, which caps one string at 128 KiB.\n+MAX_PLAN_BYTES = 100_000\n+# A guard on every drawn size, so a suite typo cannot ask for a gigabyte buffer.\n+MAX_DIM = 1 << 16\n+MAX_ELEMENTS = 1 << 22\n+\n+\n+class SuiteError(ValueError):\n+    \"\"\"A suite file the gate refuses to time with.\"\"\"\n+\n+\n+def load(path: str | os.PathLike[str] | None = None) -> dict | None:\n+    # The suite GATE_FULL_SUITE names, validated, with its file hash; None for the legacy bench.\n+    path = path if path is not None else os.environ.get(\"GATE_FULL_SUITE\") or None\n+    if path is None:\n+        return None\n+    raw = Path(path).read_bytes()\n+    try:\n+        spec = json.loads(raw)\n+    except json.JSONDecodeError as exc:\n+        raise SuiteError(f\"{path}: not JSON: {exc}\") from exc\n+    validate(spec)\n+    return {**spec, \"sha256\": hashlib.sha256(raw).hexdigest()}\n+\n+\n+def file_sha256() -> str | None:\n+    # The hash of the suite GATE_FULL_SUITE names, for the verifier fingerprint; None if unset.\n+    path = os.environ.get(\"GATE_FULL_SUITE\")\n+    return hashlib.sha256(Path(path).read_bytes()).hexdigest() if path else None\n+\n+\n+def validate(spec: dict) -> None:\n+    # Refuses a suite that could not be drawn from, before any bench runs.\n+    if not isinstance(spec.get(\"version\"), str) or not spec[\"version\"]:\n+        raise SuiteError(\"suite needs a version\")\n+    # The score is total time over total time, as for the legacy classes: a kernel or a group\n+    # counts by its work and its cases, so a weight would claim a say it does not have.\n+    if \"kernel_weights\" in spec or any(\"weight\" in g for g in spec.get(\"groups\") or []):\n+        raise SuiteError(\"suites carry no score weights; give a group more cases or work instead\")\n+    work = spec.get(\"work\", {})\n+    if set(work) != set(KERNELS) or any(not _positive(w) for w in work.values()):\n+        raise SuiteError(f\"work must give a positive multiple of BENCH_PAIRS to each of {KERNELS}\")\n+    fallback = spec.get(\"fallback_cost\", {})\n+    if set(fallback) != set(KERNELS) or any(\n+        not (_positive(c) or c == 0) for c in fallback.values()\n+    ):\n+        raise SuiteError(f\"fallback_cost must give a number >= 0 to each of {KERNELS}\")\n+    groups = spec.get(\"groups\")\n+    if not isinstance(groups, list) or not groups:\n+        raise SuiteError(\"suite needs groups\")\n+    names = [g.get(\"name\") for g in groups]\n+    if len(set(names)) != len(names) or not all(isinstance(n, str) and n for n in names):\n+        raise SuiteError(\"group names must be distinct, non-empty strings\")\n+    for name in names:\n+        if \":\" in name or name == \"check\":\n+            raise SuiteError(f\"group name {name!r} is reserved or contains ':'\")\n+    covered = set()\n+    for g in groups:\n+        kernels = g.get(\"kernels\", list(KERNELS))\n+        if not set(kernels) <= set(KERNELS) or not kernels:\n+            raise SuiteError(f\"group {g['name']}: unknown kernels {kernels}\")\n+        covered |= set(kernels)\n+        if not isinstance(g.get(\"cases\", 1), int):\n+            raise SuiteError(f\"group {g['name']}: cases must be an integer\")\n+        if g.get(\"cases\", 1) < 1:\n+            raise SuiteError(f\"group {g['name']}: at least one case per run\")\n+        families = g.get(\"families\")\n+        if not isinstance(families, list) or not families:\n+            raise SuiteError(f\"group {g['name']}: needs families\")\n+        for f in families:\n+            unknown = set(f) - set(DEFAULTS) - {\"weight\", \"kernels\"}\n+            if unknown:\n+                raise SuiteError(f\"group {g['name']}: unknown family keys {sorted(unknown)}\")\n+    if covered != set(KERNELS):\n+        raise SuiteError(f\"no group times {sorted(set(KERNELS) - covered)}\")\n+    sizes = spec.get(\"sizes\", {})\n+    for kernel, keys in SIZE_KEYS.items():\n+        options = sizes.get(kernel)\n+        if not isinstance(options, list) or not options:\n+            raise SuiteError(f\"sizes.{kernel} must list at least one size distribution\")\n+        for option in options:\n+            if set(keys) - set(option):\n+                raise SuiteError(f\"sizes.{kernel}: each option needs {keys}\")\n+\n+\n+def _positive(x: object) -> bool:\n+    return isinstance(x, (int, float)) and not isinstance(x, bool) and x > 0\n+\n+\n+def draw(rng: random.Random, value: object) -> object:\n+    # One parameter: a constant, [lo, hi] inclusive, {\"choices\": [...]} or {\"loguniform\": [lo, hi]}.\n+    if isinstance(value, list) and len(value) == 2 and all(isinstance(v, int) for v in value):\n+        lo, hi = sorted(value)\n+        return rng.randint(lo, hi)\n+    if isinstance(value, dict) and \"choices\" in value:\n+        return rng.choice(value[\"choices\"])\n+    if isinstance(value, dict) and \"loguniform\" in value:\n+        lo, hi = value[\"loguniform\"]\n+        return max(lo, min(hi, round(math.exp(rng.uniform(math.log(lo), math.log(hi))))))\n+    return value\n+\n+\n+def _pick(rng: random.Random, options: list[dict]) -> dict:\n+    # One option, by its \"weight\" (1 when absent).\n+    return rng.choices(options, weights=[o.get(\"weight\", 1) for o in options])[0]\n+\n+\n+def _encode(params: dict, kernel: str) -> dict:\n+    # Drawn family parameters as the numbers BenchSuite.lean reads.\n+    mask = 0\n+    for name in params[\"specials\"]:\n+        mask |= SPECIALS[name]\n+    relation = params[\"relation\"] if kernel in SCALAR else \"independent\"\n+    return {\n+        \"mag\": MAGNITUDES[params[\"magnitude\"]],\n+        \"center\": int(params[\"center\"]),\n+        \"spread\": int(params[\"spread\"]),\n+        \"positive\": int(params[\"positive\"]),\n+        \"mantBits\": int(params[\"mantissa_bits\"]),\n+        \"codebook\": int(params[\"codebook\"]),\n+        \"scaleBlock\": int(params[\"scale_block\"]),\n+        \"scaleShift\": int(params[\"scale_shift\"]),\n+        \"zeroPct\": int(params[\"zero_pct\"]),\n+        \"zeroCluster\": max(1, int(params[\"zero_cluster\"])),\n+        \"zeroKind\": ZERO_KINDS[params[\"zero_kind\"]],\n+        \"subPct\": int(params[\"sub_pct\"]),\n+        \"subBlock\": max(1, int(params[\"sub_block\"])),\n+        \"specRate\": int(params[\"special_rate\"]),\n+        \"specPlace\": PLACEMENTS[params[\"special_place\"]],\n+        \"specPeriod\": max(1, int(params[\"special_period\"])),\n+        \"specBurst\": max(1, int(params[\"special_burst\"])),\n+        \"specMask\": mask or SPECIALS[\"nan\"],\n+        \"relation\": RELATIONS[relation],\n+        \"relParam\": int(params[\"relation_param\"]),\n+    }\n+\n+\n+def _check_ranges(case: dict) -> None:\n+    # Bounds the harness relies on; a suite that draws outside them is a suite bug.\n+    ok = (\n+        1 <= case[\"center\"] <= 254\n+        and 0 <= case[\"spread\"] <= 253\n+        and 0 <= case[\"positive\"] <= 100\n+        and 0 <= case[\"mantBits\"] <= 23\n+        and 0 <= case[\"zeroPct\"] <= 100\n+        and 0 <= case[\"subPct\"] <= 100\n+        and 0 <= case[\"specRate\"] <= 100_000\n+        and 0 <= case[\"scaleShift\"] <= 126\n+        and 0 <= case[\"relParam\"] <= 253\n+    )\n+    if not ok:\n+        raise SuiteError(f\"case {case['name']} drew a parameter out of range: {case}\")\n+\n+\n+# Specials that send an accumulation down the slow path for the rest of it: ±inf, NaN and ±max\n+# (whose sums and products overflow). ±0 and subnormal specials do not.\n+POISON = SPECIALS[\"inf\"] | SPECIALS[\"nan\"] | SPECIALS[\"max\"]\n+\n+\n+def _poison_share(mask: int) -> float:\n+    # The share of a case's specials that poison an accumulation.\n+    return bin(mask & POISON).count(\"1\") / bin(mask).count(\"1\")\n+\n+\n+def _start_rate(case: dict) -> float:\n+    # Per position, the chance a poisoning special starts there (a burst starts once per block;\n+    # row-edge specials are counted per row, in slow_share).\n+    if case[\"specRate\"] == 0:\n+        return 0.0\n+    share = _poison_share(case[\"specMask\"])\n+    if case[\"specPlace\"] == PLACEMENTS[\"stride\"]:\n+        return share / case[\"specPeriod\"]\n+    if case[\"specPlace\"] == PLACEMENTS[\"burst\"]:\n+        return case[\"specRate\"] / 100_000 * share / case[\"specBurst\"]\n+    if case[\"specPlace\"] == PLACEMENTS[\"edge\"]:\n+        return 0.0\n+    return case[\"specRate\"] / 100_000 * share\n+\n+\n+def _exponents(case: dict) -> dict[int, float]:\n+    # The distribution of an ordinary value's biased exponent, its block scale included, as\n+    # BenchSuite.ordinary draws it.\n+    c, s = case[\"center\"], case[\"spread\"]\n+    if case[\"mag\"] == MAGNITUDES[\"geometric\"]:\n+        pmf = {c - k: 2.0 ** -(k + 1) for k in range(s)}\n+        pmf[c - s] = pmf.get(c - s, 0.0) + 2.0**-s\n+    else:\n+        pmf = {c - s + k: 1 / (2 * s + 1) for k in range(2 * s + 1)}\n+    if case[\"scaleBlock\"]:\n+        shift = case[\"scaleShift\"]\n+        scaled: dict[int, float] = {}\n+        for e, p in pmf.items():\n+            for d in range(-shift, shift + 1):\n+                scaled[e + d] = scaled.get(e + d, 0.0) + p / (2 * shift + 1)\n+        pmf = scaled\n+    clamped: dict[int, float] = {}\n+    for e, p in pmf.items():\n+        clamped[max(1, min(254, e))] = clamped.get(max(1, min(254, e)), 0.0) + p\n+    return clamped\n+\n+\n+def _ordinary_share(case: dict) -> float:\n+    # The share of positions holding an ordinary value, not a zero or a subnormal.\n+    return (1 - case[\"zeroPct\"] / 100) * (1 - case[\"subPct\"] / 100)\n+\n+\n+def _product_overflow_rate(case: dict) -> float:\n+    # For `bmm`, the chance one product is past the largest finite value.\n+    if case[\"kernel\"] != \"bmm\":\n+        return 0.0\n+    pmf = _exponents(case)\n+    tail = sum(pa * pb for ea, pa in pmf.items() for eb, pb in pmf.items() if ea + eb >= 381)\n+    return _ordinary_share(case) ** 2 * tail\n+\n+\n+def _accumulated_overflow(case: dict, steps: int) -> float:\n+    # The share of an accumulation's steps after its running sum passes the largest finite value\n+    # (2^128). Terms are the addends for `sum`, the products for `bmm`. One huge term does not\n+    # overflow; many terms near one size do. So for each size band (the terms at or above an\n+    # exponent), the sum of that band's terms is taken to grow like a random walk with mixed signs\n+    # (two standard deviations) or a line with one sign, and the earliest band to cross counts.\n+    pmf = _exponents(case)\n+    positive = case[\"positive\"] / 100\n+    if case[\"kernel\"] == \"bmm\":\n+        products: dict[int, float] = {}\n+        for ea, pa in pmf.items():\n+            for eb, pb in pmf.items():\n+                products[ea + eb - 127] = products.get(ea + eb - 127, 0.0) + pa * pb\n+        pmf = products\n+        positive = positive * positive + (1 - positive) * (1 - positive)\n+    limit, share, tail = 2.0**128, _ordinary_share(case), 0.0\n+    first = math.inf\n+    # Finite terms only: a product that overflows on its own is _product_overflow_rate's.\n+    for e, p in sorted(((e, p) for e, p in pmf.items() if e <= 254), reverse=True):\n+        tail += p * share\n+        term = 1.5 * 2.0 ** (e - 127)\n+        first = min(first, (limit / 2 / term) ** 2 / tail)\n+        if positive != 0.5:\n+            first = min(first, limit / (abs(2 * positive - 1) * term * tail))\n+    return max(0.0, 1 - first / steps)\n+\n+\n+def _after_first(q: float, steps: int) -> float:\n+    # The expected share of `steps` accumulation steps at or after the first that has chance `q`.\n+    if q <= 0 or steps <= 0:\n+        return 0.0\n+    if q >= 1:\n+        return 1.0\n+    return 1 - (1 - q) * (1 - (1 - q) ** steps) / (q * steps)\n+\n+\n+def slow_share(case: dict) -> float:\n+    # The expected share of a case's steps that take the slow path: specials for `add` and `mul`;\n+    # for `sum` and `bmm`, the rest of every accumulation after a poisoning special or an overflow.\n+    if case[\"mag\"] == MAGNITUDES[\"raw\"]:\n+        return 0.0\n+    rate = case[\"specRate\"] / 100_000 * _poison_share(case[\"specMask\"]) if case[\"specRate\"] else 0\n+    if case[\"kernel\"] in SCALAR:\n+        if case[\"specPlace\"] == PLACEMENTS[\"stride\"]:\n+            return _poison_share(case[\"specMask\"]) / case[\"specPeriod\"]\n+        if case[\"specPlace\"] == PLACEMENTS[\"edge\"]:\n+            return rate * 2 / 31\n+        return rate\n+    steps = case[\"length\"] if case[\"kernel\"] == \"sum\" else case[\"n\"]\n+    q = _start_rate(case) * (1 if case[\"kernel\"] == \"sum\" else 2) + _product_overflow_rate(case)\n+    edge = rate if case[\"specPlace\"] == PLACEMENTS[\"edge\"] else 0.0\n+    clean = (1 - edge) * (1 - _after_first(q, steps)) * (1 - _accumulated_overflow(case, steps))\n+    return 1 - clean\n+\n+\n+def _fit(case: dict, budget: int) -> dict:\n+    # The case's drawn size, shrunk to a smaller budget, and the batch and work that fill it.\n+    if case[\"kernel\"] in SCALAR:\n+        return {\"work\": max(1, budget)}\n+    if case[\"kernel\"] == \"sum\":\n+        length = max(1, min(case[\"length\"], budget))\n+        batch = max(1, budget // length)\n+        return {\"length\": length, \"batch\": batch, \"work\": batch * length}\n+    dims = [case[\"m\"], case[\"n\"], case[\"p\"]]\n+    while dims[0] * dims[1] * dims[2] > 2 * budget and max(dims) > 1:\n+        k = dims.index(max(dims))\n+        dims[k] = max(1, dims[k] // 2)\n+    m, n, p = dims\n+    batch = max(1, budget // (m * n * p))\n+    return {\"m\": m, \"n\": n, \"p\": p, \"batch\": batch, \"work\": batch * m * n * p}\n+\n+\n+def _equal_time(case: dict, spec: dict, budget: int) -> dict:\n+    # Sizes a case so it takes about as long as a clean one on the shipped baseline: its budget is\n+    # divided by its estimated cost, 1 + fallback_cost × slow_share. Without this a few poisoned\n+    # accumulations, 30-100 times slower per step, would take most of the run's time.\n+    k = spec[\"fallback_cost\"][case[\"kernel\"]]\n+    for _ in range(2):\n+        scaled = max(1, round(budget / (1 + k * slow_share(case))))\n+        case = {**case, **_fit(case, scaled)}\n+    return case\n+\n+\n+def _size(rng: random.Random, kernel: str, spec: dict, group: dict, budget: int) -> dict:\n+    # A drawn size within the case's budget: scalar steps, vectors of a length, or matrices.\n+    if kernel in SCALAR:\n+        return {\"length\": 1, \"m\": 1, \"n\": 1, \"p\": 1, \"batch\": 1, \"work\": budget}\n+    option = _pick(rng, group.get(\"sizes\", {}).get(kernel) or spec[\"sizes\"][kernel])\n+    if kernel == \"sum\":\n+        length = min(int(draw(rng, option[\"length\"])), MAX_DIM)\n+        length = max(1, min(length, budget))\n+        batch = max(1, budget // length)\n+        return {\"length\": length, \"m\": 1, \"n\": 1, \"p\": 1, \"batch\": batch, \"work\": batch * length}\n+    dims = [max(1, min(int(draw(rng, option[k])), MAX_DIM)) for k in (\"m\", \"n\", \"p\")]\n+    # A shape over twice the budget is halved along its largest side until it fits.\n+    while dims[0] * dims[1] * dims[2] > 2 * budget and max(dims) > 1:\n+        k = dims.index(max(dims))\n+        dims[k] = max(1, dims[k] // 2)\n+    m, n, p = dims\n+    batch = max(1, budget // (m * n * p))\n+    return {\"length\": 1, \"m\": m, \"n\": n, \"p\": p, \"batch\": batch, \"work\": batch * m * n * p}\n+\n+\n+def cells(spec: dict) -> list[str]:\n+    # The cells a plan times and a verdict reports under: each kernel with each group that times it.\n+    return [\n+        f\"{kernel}:{g['name']}\"\n+        for kernel in KERNELS\n+        for g in spec[\"groups\"]\n+        if kernel in g.get(\"kernels\", KERNELS)\n+    ]\n+\n+\n+def make_plan(spec: dict, seed: int, work: int) -> dict:\n+    # Concrete cases for one gate run: per cell its group's number of cases, each drawing a family,\n+    # its parameters and a size, plus one untimed raw-bits case per kernel for the checksum.\n+    if work < 1:\n+        raise SuiteError(\"BENCH_PAIRS must be positive\")\n+    rng = random.Random(f\"{spec['version']}:{seed}:{work}\")\n+    cases: list[dict] = []\n+    for kernel in KERNELS:\n+        groups = [g for g in spec[\"groups\"] if kernel in g.get(\"kernels\", KERNELS)]\n+        n_cases = sum(g.get(\"cases\", 1) for g in groups)\n+        budget = max(1, int(spec[\"work\"][kernel] * work) // n_cases)\n+        for g in groups:\n+            families = [f for f in g[\"families\"] if kernel in f.get(\"kernels\", KERNELS)]\n+            if not families:\n+                raise SuiteError(f\"group {g['name']} has no family for {kernel}\")\n+            for j in range(g.get(\"cases\", 1)):\n+                family = _pick(rng, families)\n+                params = {k: draw(rng, family.get(k, d)) for k, d in DEFAULTS.items()}\n+                case = {\n+                    \"name\": f\"{kernel}:{g['name']}:{j}\",\n+                    \"kernel\": kernel,\n+                    \"timed\": True,\n+                    \"seed\": rng.getrandbits(32),\n+                    **_encode(params, kernel),\n+                    **_size(rng, kernel, spec, g, budget),\n+                }\n+                _check_ranges(case)\n+                cases.append(_equal_time(case, spec, budget))\n+        check = {\n+            \"name\": f\"{kernel}:check\",\n+            \"kernel\": kernel,\n+            \"timed\": False,\n+            \"seed\": rng.getrandbits(32),\n+            **_encode({**DEFAULTS, \"magnitude\": \"raw\"}, kernel),\n+            **_size(rng, kernel, spec, {}, min(budget, 4096)),\n+        }\n+        cases.append(check)\n+    for case in cases:\n+        elements = case[\"batch\"] * max(\n+            case[\"length\"], case[\"m\"] * case[\"n\"] + case[\"n\"] * case[\"p\"]\n+        )\n+        if case[\"work\"] < 1 or elements > MAX_ELEMENTS:\n+            raise SuiteError(f\"case {case['name']} is empty or too large: {case}\")\n+    plan = {\"version\": \"suite-v2\", \"cases\": cases}\n+    if len(json.dumps(plan, separators=(\",\", \":\"))) > MAX_PLAN_BYTES:\n+        raise SuiteError(\"plan too large for the bench environment; fewer cases per run\")\n+    return plan\n+\n+\n+def summarise(\n+    spec: dict,\n+    plan: dict,\n+    inc: list[dict[str, tuple[int, int]]],\n+    sub: list[dict[str, tuple[int, int]]],\n+) -> tuple[float, dict[str, dict[str, float]], list[list[int]]]:\n+    # The verdict's ratio, its per-cell classes and its per-round totals, as for the legacy classes:\n+    # per case the fastest round of each side, summed. A cell's times are per unit of work.\n+    timed = [c for c in plan[\"cases\"] if c[\"timed\"]]\n+    members: dict[str, list[dict]] = {cell: [] for cell in cells(spec)}\n+    for case in timed:\n+        members[case[\"name\"].rsplit(\":\", 1)[0]].append(case)\n+    best = {\n+        c[\"name\"]: (min(r[c[\"name\"]][0] for r in inc), min(r[c[\"name\"]][0] for r in sub))\n+        for c in timed\n+    }\n+    classes: dict[str, dict[str, float]] = {}\n+    for cell, cs in members.items():\n+        total_i = sum(best[c[\"name\"]][0] for c in cs)\n+        total_s = sum(best[c[\"name\"]][1] for c in cs)\n+        work = sum(c[\"work\"] for c in cs)\n+        classes[cell] = {\n+            \"incumbent_ns\": total_i / work,\n+            \"submission_ns\": total_s / work,\n+            \"ratio\": total_s / total_i,\n+            \"spread_inc\": max(max(r[c[\"name\"]][0] for r in inc) / best[c[\"name\"]][0] for c in cs),\n+            \"spread_sub\": max(max(r[c[\"name\"]][0] for r in sub) / best[c[\"name\"]][1] for c in cs),\n+        }\n+    ratio = sum(s for _, s in best.values()) / sum(i for i, _ in best.values())\n+    rounds = [\n+        [sum(i[c[\"name\"]][0] for c in timed), sum(s[c[\"name\"]][0] for c in timed)]\n+        for i, s in zip(inc, sub)\n+    ]\n+    return ratio, classes, rounds"},{"sha":"e136550da07673c8e0735285ede731d73440c191","filename":"docs/BENCHMARKING.md","status":"modified","additions":74,"deletions":4,"changes":78,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/docs%2FBENCHMARKING.md","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/docs%2FBENCHMARKING.md","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/docs%2FBENCHMARKING.md?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -17,9 +17,72 @@ champion.\n be timed. Checksum checks still run; the result is not a verification verdict or\n promotion decision.\n \n-## Current workloads\n-\n-The full entry measures twelve classes, three per kernel:\n+## Suite scoring\n+\n+When the operator sets `GATE_FULL_SUITE`, the full entry is timed on cases drawn\n+from a *suite* instead of the twelve legacy classes below. Only the inputs\n+change: the ratio and admission are the legacy ones, described further down.\n+Practice boards keep their legacy classes.\n+\n+- **A suite** is a JSON file. It names *groups* (`dense`, `ml`, `sparse`,\n+  `specials`, `subnormal`, `paired`, `extremes`) and gives each group *families* of\n+  inputs, with parameter ranges and size distributions.\n+- **Per evaluation**, the gate draws a fresh plan from the seed: several cases per\n+  kernel and group, each with its own family, parameters and size. One untimed\n+  raw-bits case per kernel is only checksummed. Champion and entry run the same plan.\n+- **The paid board is scored on a private suite.** It has the public suite's\n+  groups, but its families, parameter ranges and sizes are not published, and\n+  every evaluation draws new ones.\n+- **[suites/public-v2.json](../suites/public-v2.json)** is the public suite. It\n+  uses the same generators and groups, so tune on it, then expect the private\n+  suite to differ in detail.\n+- **What is published:** results. The verdict gives each cell's (kernel and\n+  group's) times and ratio, the per-round totals, and the suite's version and file\n+  hash. It does not give a case's parameters, its size or the plan.\n+- **What the cases are made of:** [BenchSuite.lean](../lean/bench/BenchSuite.lean)\n+  builds them. Ordinary values have uniform or normal-like magnitudes. On top of\n+  those it can place:\n+  - zeros, in runs, signed or as tiny leaked values;\n+  - blocks of subnormals;\n+  - ±∞, NaN, ±largest finite and ±0, at random, on a stride, in bursts or at row\n+    ends;\n+  - fractions rounded to bf16 or fp16 precision;\n+  - small codebooks of repeated values;\n+  - per-block scales.\n+\n+  For `add` and `mul`, the second operand can also be tied to the first: equal,\n+  negated, nearly cancelling, constant, an identity, or a set number of binades\n+  below it. `sum` lengths and `bmm` shapes are drawn from wide ranges, from\n+  single elements to long vectors and tall, skinny or degenerate matrices.\n+\n+**How a suite is scored:** like the legacy classes. Each case is one class: the\n+fastest round of each side, summed over all timed cases, submission total over\n+reference total ([What the ratio measures](#what-the-ratio-measures)). A cell's\n+ratio in the verdict is its cases' total over total. Admission reads the same\n+per-round totals as for the legacy classes ([Statistical\n+admission](#statistical-admission)).\n+\n+**How cases are sized:** so that each takes about as long as any other on the\n+shipped baseline, as the legacy classes do. Then a kind of input counts by how\n+many cases the suite gives it, not by how slow the baseline happens to be on it.\n+- A kernel's work (the suite's `work`, a multiple of `BENCH_PAIRS`) is split\n+  evenly over its cases.\n+- A case that sends accumulations down the slow path gets proportionally fewer\n+  steps. Its estimated cost is `1 + fallback_cost × slow_share`. `slow_share` is\n+  the expected share of its steps that are slow: special operands for `add` and\n+  `mul`, and for `sum` and `bmm` the rest of each accumulation after a ±∞, NaN or\n+  ±largest value, or after an overflow. Once poisoned, the shipped baseline's\n+  steps cost 30–100 times a clean one's.\n+- The estimate comes from the case's drawn parameters\n+  ([benchmark_suite.py](../benchmark_suite.py)), never from a timing, so a plan\n+  is the same for champion and entry and for every run with the same seed.\n+\n+An entry that is as slow as the baseline on poisoned inputs while its champion\n+is fast there pays for it on every such case.\n+\n+## Legacy workloads\n+\n+Without a suite, the full entry measures twelve classes, three per kernel:\n \n | Kernel | Classes | Default work per class |\n | --- | --- | --- |\n@@ -84,7 +147,14 @@ BENCH_SEED=42 BENCH_CPU=3 python gate.py --slot full --bench my-entry\n ```\n \n Choose a CPU that exists on your host. Repeat with other seeds and inspect every\n-class; fixed-seed improvements may not generalise. `BENCH_CPU=` removes pinning\n+class; fixed-seed improvements may not generalise. To time on the public suite, as\n+the paid board is timed on its private one:\n+\n+```bash\n+GATE_FULL_SUITE=suites/public-v2.json BENCH_SEED=42 python gate.py --slot full --bench my-entry\n+```\n+\n+Look at every cell, and at several seeds: each seed draws different cases. `BENCH_CPU=` removes pinning\n and can increase noise. `BENCH_ROUNDS` and `BENCH_PAIRS` change measurement work;\n local overrides do not change the server configuration.\n "},{"sha":"92fc83970bc10e3c8378ec76cb98bf773111a38b","filename":"docs/OPERATIONS.md","status":"modified","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/docs%2FOPERATIONS.md","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/docs%2FOPERATIONS.md","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/docs%2FOPERATIONS.md?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -184,6 +184,38 @@ the current champion's exact ID. The next attempt uses the remaining champion\n or shipped reference. Run gate workers on one host per shared queue; the host\n lock is not a distributed lock.\n \n+## Scoring the full board on a private suite\n+\n+`GATE_FULL_SUITE` switches the full entry's inputs from the legacy classes to a\n+suite's cases ([Benchmarking](BENCHMARKING.md#suite-scoring)). The ratio, the\n+verdict's fields and admission stay the legacy ones, so the validator and the\n+boards need no change. Unset, nothing changes.\n+\n+1. Keep the private suite file outside the checkout, readable only by the gate's\n+   account (for example `/etc/floatlib/suites/scoring.json`, mode 0600). Never commit\n+   it to this repository. Its hash enters the verifier fingerprint; its contents\n+   reach only the bench processes, through `BENCH_PLAN`.\n+2. Check that it loads and draws:\n+   `python -c \"import benchmark_suite as b; b.make_plan(b.load('<path>'), 1, 500000)\"`.\n+3. Raise the time limits. A suite run times about 200 cases, and a bench process\n+   takes about 1.5–2× a legacy one. Use `GATE_BUDGET_SECONDS=900` and\n+   `VERIFY_TOTAL_TIMEOUT=2700`, then re-check them against a real gate run on the\n+   validator.\n+4. Re-time the paid kings on the suite before switching, to check that the current\n+   champion builds and benchmarks on it (or its slot would pause) and to know their\n+   ratios on it. `validator/tools/kings.py --out <empty dir>` writes each king's file\n+   and the one it beat, and prints one gate command per king. Run them with\n+   `GATE_FULL_SUITE` set in that shell only. They wait for the gate lock and write\n+   verdicts, never the store. The kings, their ranks and their pay do not change.\n+   Do not use `reverify.py` for this: it would requeue every accepted entry.\n+5. Set `GATE_FULL_SUITE` in the worker's environment and restart the gate worker.\n+   The formula is the same, but on harder inputs the same entry gets a different\n+   ratio, so ratios from before and after the switch should not be ranked against\n+   each other. The champion stays; later entries are timed against it on the suite.\n+\n+To retire a private suite's draws, change its `version`; old verdicts keep the hash\n+they were scored under.\n+\n ## Provenance and explicit reverification\n \n Verifier fingerprints and incumbent binary hashes record provenance. Changes are"},{"sha":"7011ecf7a172f6b1ddbeb325ac2161561a4ada16","filename":"fingerprint.py","status":"modified","additions":8,"deletions":1,"changes":9,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/fingerprint.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/fingerprint.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/fingerprint.py?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -14,6 +14,8 @@\n import os\n from pathlib import Path\n \n+import benchmark_suite\n+\n HERE = Path(__file__).resolve().parent\n LIB = HERE / \"lean\"\n \n@@ -22,6 +24,7 @@\n     [\n         \"gate.py\",\n         \"fingerprint.py\",\n+        \"benchmark_suite.py\",\n         \"lean/lakefile.lean\",\n         \"lean/lake-manifest.json\",\n         \"lean/lean-toolchain\",\n@@ -34,7 +37,8 @@\n         if p.name != \"Micro.lean\"\n     ]\n )\n-# Settings that change what a ratio means; the host-only ones (BENCH_CPU, caps) stay out.\n+# Settings that change what a ratio means; the host-only ones (BENCH_CPU, caps) stay out. The\n+# suite file GATE_FULL_SUITE names counts by its hash, so a private suite's contents stay private.\n KNOBS = {\"BENCH_PAIRS\": \"500000\", \"BENCH_ROUNDS\": \"25\", \"BENCH_INNER\": \"3\"}\n \n \n@@ -44,6 +48,9 @@ def current() -> str:\n         name: hashlib.sha256((HERE / name).read_bytes()).hexdigest() for name in PINNED\n     }\n     parts |= {f\"env:{k}\": os.environ.get(k, default) for k, default in KNOBS.items()}\n+    suite = benchmark_suite.file_sha256()\n+    if suite is not None:\n+        parts[\"suite\"] = suite\n     return hashlib.sha256(json.dumps(parts, sort_keys=True).encode()).hexdigest()\n \n "},{"sha":"88894a8f77ab037fe0113d3a5a4e082838dce080","filename":"gate.py","status":"modified","additions":53,"deletions":3,"changes":56,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/gate.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/gate.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/gate.py?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -19,6 +19,7 @@\n \n from loguru import logger\n \n+import benchmark_suite\n import fingerprint as verifier\n \n HERE = Path(__file__).resolve().parent\n@@ -121,6 +122,7 @@ def incumbent(slot: str) -> Path:\n             \"bench/BenchTensor.lean\",\n             \"bench/BenchBmm.lean\",\n             \"bench/BenchFull.lean\",\n+            \"bench/BenchSuite.lean\",\n             \"contract/ContractTensor.lean\",\n         ),\n         contract=\"ContractTensor\",\n@@ -223,8 +225,10 @@ class Verdict:\n     ratio: float | None = None\n     classes: dict[str, dict[str, float]] = field(default_factory=dict)\n     # Per round, [incumbent ns, submission ns] summed over the timed classes: the paired evidence\n-    # statistical admission resamples (validator/admission.py).\n+    # statistical admission resamples (validator/admission.py). Under a suite the same, summed\n+    # over its timed cases; `suite` names the suite (version and file hash), never its contents.\n     rounds: list[list[int]] = field(default_factory=list)\n+    suite: dict = field(default_factory=dict)\n     incumbent_sha256: str = \"\"\n     # The champion's Kernel.lean, hashed: a promotion changes it and starts a fresh board, while a\n     # bench or gate hotfix (a new incumbent binary, a new fingerprint) does not.\n@@ -292,6 +296,15 @@ def overfile(code: int) -> bool:\n OVER_DISK = 253\n \n \n+def suite_masks(hidden: tuple[Path, ...]) -> list[Path]:\n+    # GATE_FULL_SUITE as named and as resolved, unless a tmpfs in `hidden` already covers it.\n+    name = os.environ.get(\"GATE_FULL_SUITE\")\n+    if not name:\n+        return []\n+    paths = {Path(name).absolute(), Path(name).resolve()}\n+    return sorted(p for p in paths if p.is_file() and not any(p.is_relative_to(h) for h in hidden))\n+\n+\n def run(\n     cmd: list[str],\n     timeout: float,\n@@ -308,6 +321,10 @@ def run(\n     box += [\"--tmpfs\", str(home), \"--ro-bind\", str(ELAN), str(ELAN)]\n     box += [\"--tmpfs\", str(HERE), \"--ro-bind\", str(LIB), str(LIB)]\n     box += [\"--ro-bind-try\", str(pinned), str(pinned)]\n+    # The private suite is the gate's alone: its plan reaches a bench through BENCH_PLAN, so no\n+    # build or bench needs the file, wherever the operator keeps it.\n+    for path in suite_masks((home, HERE, Path(\"/tmp\"))):\n+        box += [\"--ro-bind\", \"/dev/null\", str(path)]\n     # The user's runtime dir holds its D-Bus and systemd sockets.\n     if (runtime := os.environ.get(\"XDG_RUNTIME_DIR\")) and Path(runtime).is_dir():\n         box += [\"--tmpfs\", runtime]\n@@ -573,11 +590,17 @@ def axioms(src: Path, v: Verdict) -> str | None:\n     return f\"extra axioms {sorted(found - AXIOMS)}\" if found - AXIOMS else None\n \n \n-def bench(binary: Path, seed: int, build: str) -> dict[str, tuple[int, int]] | str:\n+def bench(\n+    binary: Path, seed: int, build: str, plan: str | None = None\n+) -> dict[str, tuple[int, int]] | str:\n     # One bench process: class -> (best ns, checksum), or the failure text; the submission's own\n     # (built in its layer) count against its time budget, the pinned incumbent's do not.\n     # A panic aborts the process, so a kernel cannot print into the output the gate parses.\n+    # `plan` is a suite plan's JSON (the full entry under GATE_FULL_SUITE); its cases replace the\n+    # legacy classes.\n     env_extra = {\"BENCH_SEED\": str(seed), \"BENCH_PAIRS\": str(_PAIRS), \"LEAN_ABORT_ON_PANIC\": \"1\"}\n+    if plan is not None:\n+        env_extra[\"BENCH_PLAN\"] = plan\n     pin_cpu = [\"taskset\", \"-c\", _BENCH_CPU] if _BENCH_CPU and shutil.which(\"taskset\") else []\n     code, out = (own if build else run)(\n         pin_cpu + [str(binary)],\n@@ -608,13 +631,20 @@ def score(src: Path, v: Verdict) -> str | None:\n     v.seed = int(os.environ.get(\"BENCH_SEED\", secrets.randbelow(2**32)))\n     logger.info(f\"[score] seed={v.seed} pairs={_PAIRS} rounds={_ROUNDS} cpu={_BENCH_CPU or 'any'}\")\n     slot = SLOTS[v.slot]\n+    # The full entry under a suite: a fresh plan of cases from the seed, kept out of the verdict.\n+    spec = benchmark_suite.load() if v.slot == \"full\" else None\n+    plan = benchmark_suite.make_plan(spec, v.seed, _PAIRS) if spec else None\n+    extra = {\"plan\": json.dumps(plan, separators=(\",\", \":\"))} if plan else {}\n+    expected = {c[\"name\"] for c in plan[\"cases\"]} if plan else set()\n+    if spec:\n+        logger.info(f\"[score] suite {spec['version']} ({len(expected)} cases)\")\n     runs: dict[str, list[dict[str, tuple[int, int]]]] = {\"inc\": [], \"sub\": []}\n     for r in range(_ROUNDS):\n         order = [(\"inc\", slot.pinned, \"\"), (\"sub\", BUILD / \"bin\" / slot.bench, \"read\")]\n         for who, binary, build in order if r % 2 == 0 else order[::-1]:\n             progress(\"reference-benchmark\" if who == \"inc\" else \"challenger\")\n             try:\n-                res = bench(binary, v.seed, build)\n+                res = bench(binary, v.seed, build, **extra)\n             except Exception as exc:\n                 if who != \"inc\":\n                     raise\n@@ -635,6 +665,15 @@ def score(src: Path, v: Verdict) -> str | None:\n                 v.incumbent_failed = True\n                 v.reference_failure_phase = \"reference-benchmark\"\n                 return \"gate error: the incumbent's benchmark output is incomplete\"\n+            if plan and (\n+                res.keys() != expected\n+                or any(ns <= 0 for c in plan[\"cases\"] if c[\"timed\"] for ns in [res[c[\"name\"]][0]])\n+            ):\n+                if who != \"inc\":\n+                    return \"the entry's bench did not time every case of the suite\"\n+                v.incumbent_failed = True\n+                v.reference_failure_phase = \"reference-benchmark\"\n+                return \"gate error: the incumbent's suite output is incomplete\"\n             runs[who].append(res)\n             if who == \"inc\" and len(runs[who]) == _ROUNDS:\n                 v.reference_complete = True\n@@ -643,6 +682,17 @@ def score(src: Path, v: Verdict) -> str | None:\n     for name, (_, want) in inc[0].items():\n         if any(s.get(name, (0, None))[1] != want for s in sub):\n             return f\"checksum mismatch on class {name}: the submission disagrees with the incumbent\"\n+    if plan:\n+        v.ratio, v.classes, v.rounds = benchmark_suite.summarise(spec, plan, inc, sub)\n+        v.suite = {\"version\": spec[\"version\"], \"sha256\": spec[\"sha256\"]}\n+        for name, c in v.classes.items():\n+            logger.info(\n+                f\"[score] {name:16} inc {c['incumbent_ns']:.2f} ns  \"\n+                f\"sub {c['submission_ns']:.2f} ns  \"\n+                f\"ratio {c['ratio']:.3f}  spread {c['spread_inc']:.3f}/{c['spread_sub']:.3f}\"\n+            )\n+        logger.info(f\"[score] ratio {v.ratio:.3f} of the incumbent over all timed cases\")\n+        return None\n     total_inc = total_sub = 0\n     for name in inc[0]:\n         best_i, best_s = min(x[name][0] for x in inc), min(x[name][0] for x in sub)"},{"sha":"f194149e286d91efed71a29c6ea7402c8349e1a6","filename":"lean/bench/BenchSuite.lean","status":"added","additions":251,"deletions":0,"changes":251,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/lean%2Fbench%2FBenchSuite.lean","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/lean%2Fbench%2FBenchSuite.lean","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/lean%2Fbench%2FBenchSuite.lean?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -0,0 +1,251 @@\n+import BenchBmm\n+import Lean.Data.Json\n+\n+/-!\n+# The suite benchmark: the full entry timed on cases drawn from a suite\n+\n+`benchmark_suite.py` draws every case (its kind of input, its parameters and its size) and the gate\n+hands the plan over in `BENCH_PLAN`; this module only turns a case into operands and times one\n+kernel over them. Operands are built before the clock starts. Every value comes from a SplitMix64\n+finaliser over a counter, so a case is the same on both sides of a round, and each property (a\n+value's magnitude, sign, fraction, whether it is zero, subnormal or special) has its own stream.\n+\n+A case's operands are ordinary normal values unless a rule picks a position, in this order:\n+\n+- special values (±∞, NaN, ±largest finite, subnormals, ±0) at a rate, on a stride, in bursts or\n+  at the ends of each row;\n+- zeros (+0, -0, either, or tiny \"leaked\" normals), alone or in runs;\n+- subnormals, in blocks.\n+\n+Ordinary values have a uniform or geometric (\"normal-like\") exponent around a centre, an optional\n+per-block scale, a fraction rounded to fewer bits, and can repeat from a small codebook. For `add`\n+and `mul` the second operand can be tied to the first: equal, negated, nearly cancelling, constant,\n+an identity, or a set number of binades below it.\n+\n+Each case prints `name timed ns checksum`, the line format of every other bench.\n+-/\n+\n+namespace Bench.Suite\n+open FloatLib.Floats Competition\n+open FloatLib.Floats.Formats.BinaryInterchange\n+open Lean\n+\n+structure Case where\n+  name : String\n+  kernel : String\n+  timed : Bool\n+  seed : Nat\n+  mag : Nat\n+  center : Nat\n+  spread : Nat\n+  positive : Nat\n+  mantBits : Nat\n+  codebook : Nat\n+  scaleBlock : Nat\n+  scaleShift : Nat\n+  zeroPct : Nat\n+  zeroCluster : Nat\n+  zeroKind : Nat\n+  subPct : Nat\n+  subBlock : Nat\n+  specRate : Nat\n+  specPlace : Nat\n+  specPeriod : Nat\n+  specBurst : Nat\n+  specMask : Nat\n+  relation : Nat\n+  relParam : Nat\n+  length : Nat\n+  m : Nat\n+  n : Nat\n+  p : Nat\n+  batch : Nat\n+  work : Nat\n+  deriving FromJson\n+\n+structure Plan where\n+  version : String\n+  cases : Array Case\n+  deriving FromJson\n+\n+/-- SplitMix64 finaliser over a counter: one independent word per (seed, index, stream). -/\n+@[inline] def word (seed index stream : Nat) : UInt32 :=\n+  let z := UInt64.ofNat seed + UInt64.ofNat index * 0x9e3779b97f4a7c15 +\n+    UInt64.ofNat stream * 0xd1b54a32d192ed03\n+  let z := (z ^^^ (z >>> 30)) * 0xbf58476d1ce4e5b9\n+  let z := (z ^^^ (z >>> 27)) * 0x94d049bb133111eb\n+  (z ^^^ (z >>> 31)).toUInt32\n+\n+/-- Stream `k` of operand `role` (0 the first operand or matrix, 1 the second). -/\n+@[inline] def draw (c : Case) (i role k : Nat) : UInt32 := word c.seed i (role * 16 + k)\n+\n+@[inline] def pct (w : UInt32) : Nat := w.toNat % 100\n+\n+@[inline] def perLakh (w : UInt32) : Nat := w.toNat % 100000\n+\n+/-- Trailing zero bits, 32 for zero: k with probability 2^-(k+1), a geometric magnitude. -/\n+def ctz (w : UInt32) : Nat := Id.run do\n+  for k in [0:32] do\n+    if (w >>> UInt32.ofNat k) &&& 1 == 1 then return k\n+  return 32\n+\n+/-- A biased exponent clamped to the normal range. -/\n+@[inline] def clampExp (e : Int) : UInt32 := UInt32.ofNat (max 1 (min 254 e)).toNat\n+\n+/-- An ordinary normal value: index `j` draws its magnitude, sign and fraction (a codebook reuses a\n+few `j`), position `i` its block's scale. -/\n+def ordinary (c : Case) (i j role : Nat) : UInt32 :=\n+  let w := draw c j role 1\n+  let centre : Int := Int.ofNat c.center\n+  let e : Int := if c.mag == 1 then centre - Int.ofNat (min (ctz w) c.spread)\n+    else centre - Int.ofNat c.spread + Int.ofNat (w.toNat % (2 * c.spread + 1))\n+  let shift : Int := if c.scaleBlock == 0 then 0\n+    else Int.ofNat ((draw c (i / c.scaleBlock) role 2).toNat % (2 * c.scaleShift + 1)) -\n+      Int.ofNat c.scaleShift\n+  let keep : UInt32 := if c.mantBits ≥ 23 then 0x7fffff\n+    else (0x7fffff : UInt32) ^^^ (((1 : UInt32) <<< UInt32.ofNat (23 - c.mantBits)) - 1)\n+  let frac := draw c j role 3 &&& keep\n+  let sign : UInt32 := if pct (draw c j role 4) < c.positive then 0 else 0x80000000\n+  sign ||| (clampExp (e + shift) <<< 23) ||| frac\n+\n+/-- The `r`-th set bit of the five-bit special-kinds mask (NaN when the mask is empty). -/\n+def nthKind (mask r : Nat) : Nat := Id.run do\n+  let mut seen := 0\n+  for b in [0:5] do\n+    if (mask >>> b) % 2 == 1 then\n+      if seen == r then return b\n+      seen := seen + 1\n+  return 1\n+\n+def special (c : Case) (i role : Nat) : UInt32 :=\n+  let count := (List.range 5).countP fun b => (c.specMask >>> b) % 2 == 1\n+  let kind := nthKind c.specMask ((draw c i role 5).toNat % max 1 count)\n+  let sign : UInt32 := draw c i role 6 &&& 0x80000000\n+  let low := draw c i role 7 &&& 0x7fffff\n+  match kind with\n+  | 0 => sign ||| 0x7f800000\n+  | 1 => sign ||| 0x7f800000 ||| (low ||| 1)\n+  | 2 => sign ||| 0x7f7fffff\n+  | 3 => sign ||| (low ||| 1)\n+  | _ => sign\n+\n+/-- Whether position `i` (in rows of `row`) holds a special value. -/\n+def isSpecial (c : Case) (i role row : Nat) : Bool :=\n+  c.specRate > 0 && match c.specPlace with\n+  | 1 => (i + c.seed + 7 * role) % c.specPeriod == 0\n+  | 2 => perLakh (draw c (i / c.specBurst) role 8) < c.specRate\n+  | 3 => (i % row == 0 || i % row == row - 1) && perLakh (draw c i role 9) < c.specRate\n+  | _ => perLakh (draw c i role 9) < c.specRate\n+\n+def zero (c : Case) (i role : Nat) : UInt32 :=\n+  let w := draw c i role 10\n+  match c.zeroKind with\n+  | 1 => 0x80000000\n+  | 2 => w &&& 0x80000000\n+  | 3 => (w &&& (0x807fffff : UInt32)) ||| (UInt32.ofNat (1 + w.toNat % 30) <<< 23)\n+  | _ => 0\n+\n+/-- Operand `role`'s value at position `i`, in rows of `row` values. -/\n+def element (c : Case) (i role row : Nat) : UInt32 :=\n+  if c.mag == 2 then draw c i role 0\n+  else if isSpecial c i role row then special c i role\n+  else if c.zeroPct > 0 && pct (draw c (i / c.zeroCluster) role 11) < c.zeroPct then\n+    zero c i role\n+  else if c.subPct > 0 && pct (draw c (i / c.subBlock) role 12) < c.subPct then\n+    (draw c i role 13 &&& (0x807fffff : UInt32)) ||| 1\n+  else\n+    let j := if c.codebook > 0 then (draw c i role 14).toNat % c.codebook else i\n+    ordinary c i j role\n+\n+/-- The second operand of a scalar step, tied to the first by the case's relation. -/\n+def partner (c : Case) (i : Nat) (a : UInt32) : UInt32 :=\n+  let w := draw c i 1 15\n+  match c.relation with\n+  | 1 => a\n+  | 2 => a ^^^ 0x80000000\n+  | 3 | 7 =>\n+    let mask : UInt32 := ((1 : UInt32) <<< UInt32.ofNat (min 23 c.relParam)) - 1\n+    let b := (a &&& ~~~mask) ||| (w &&& mask)\n+    if c.relation == 3 then b ^^^ 0x80000000 else b\n+  | 4 => element c 0 1 31\n+  | 5 =>\n+    if pct w < c.relParam then\n+      if c.kernel == \"add\" then w &&& 0x80000000 else (w &&& 0x80000000) ||| 0x3f800000\n+    else element c i 1 31\n+  | 6 =>\n+    let ea := (a >>> 23) &&& 0xff\n+    if ea == 0 || ea == 255 then element c i 1 31\n+    else (w &&& (0x807fffff : UInt32)) ||| (clampExp (Int.ofNat ea.toNat - Int.ofNat c.relParam) <<< 23)\n+  | _ => element c i 1 31\n+\n+@[inline] def float (w : UInt32) : Binary32 := Configured.NativeFPU.ofBinary32Bits w\n+\n+/-- A checksum sweep that doubles as warm-up, then the fastest of `inner` timed sweeps. -/\n+def measure (c : Case) (inner : Nat) (pass : UInt32 → IO UInt32) : IO Unit := do\n+  let checksum ← pass 0\n+  let mut ns := 0\n+  if c.timed then\n+    for r in [0:inner] do\n+      let t0 ← IO.monoNanosNow\n+      let sink ← pass (UInt32.ofNat (r + 1))\n+      let elapsed := (← IO.monoNanosNow) - t0\n+      if sink == 0xffffffff then IO.println \"unlikely\"   -- keeps `sink` observed\n+      ns := if ns == 0 || elapsed < ns then elapsed else ns\n+  IO.println s!\"{c.name} {c.timed} {ns} {checksum}\"\n+\n+def runScalar (c : Case) (inner : Nat) (kernel : Binary32 → Binary32 → Binary32) : IO Unit := do\n+  let xs := Array.ofFn (n := c.work) fun i =>\n+    let a := element c i.val 0 31\n+    (float a, float (partner c i.val a))\n+  measure c inner fun seed => do\n+    let mut sink := seed\n+    for (a, b) in xs do\n+      sink := (sink ^^^ (kernel a b).raw.1) * 16777619\n+    return sink\n+\n+def runSum (c : Case) (inner : Nat)\n+    (kernel : {n : Nat} → Vector Binary32 n → Binary32) : IO Unit := do\n+  let xs := Array.ofFn (n := c.batch) fun b =>\n+    Vector.ofFn (n := c.length) fun i => float (element c (b.val * c.length + i.val) 0 c.length)\n+  measure c inner fun seed => do\n+    let mut sink := seed\n+    for x in xs do\n+      sink := (sink ^^^ (kernel x).raw.1) * 16777619\n+    return sink\n+\n+def runBmm (c : Case) (inner : Nat)\n+    (kernel : (batch m n p : Nat) → Vector Binary32 (batch * m * n) →\n+      Vector Binary32 (batch * n * p) → Vector Binary32 (batch * m * p)) : IO Unit := do\n+  let a := Vector.ofFn (n := c.batch * c.m * c.n) fun i => float (element c i.val 0 c.n)\n+  let b := Vector.ofFn (n := c.batch * c.n * c.p) fun i => float (element c i.val 1 c.p)\n+  measure c inner fun seed => do\n+    let mut sink := seed\n+    for x in (kernel c.batch c.m c.n c.p a b).toArray do\n+      sink := (sink ^^^ x.raw.1) * 16777619\n+    return sink\n+\n+def run (add mul : Binary32 → Binary32 → Binary32)\n+    (sum : {n : Nat} → Vector Binary32 n → Binary32)\n+    (bmm : (batch m n p : Nat) → Vector Binary32 (batch * m * n) →\n+      Vector Binary32 (batch * n * p) → Vector Binary32 (batch * m * p)) : IO UInt32 := do\n+  let some text ← IO.getEnv \"BENCH_PLAN\"\n+    | throw (IO.userError \"BENCH_PLAN is required for the suite benchmark\")\n+  let plan ← match Json.parse text >>= fromJson? (α := Plan) with\n+    | .ok p => pure p\n+    | .error e => throw (IO.userError s!\"invalid BENCH_PLAN: {e}\")\n+  if plan.version != \"suite-v2\" then throw (IO.userError \"unsupported benchmark plan\")\n+  let inner ← envNat \"BENCH_INNER\" 3\n+  if inner == 0 then throw (IO.userError \"BENCH_INNER must be positive\")\n+  for c in plan.cases do\n+    if c.work == 0 || c.length == 0 || c.batch == 0 || c.specPeriod == 0 || c.specBurst == 0\n+        || c.zeroCluster == 0 || c.subBlock == 0 then\n+      throw (IO.userError s!\"empty benchmark case {c.name}\")\n+    match c.kernel with\n+    | \"add\" => runScalar c inner add\n+    | \"mul\" => runScalar c inner mul\n+    | \"sum\" => runSum c inner sum\n+    | \"bmm\" => runBmm c inner bmm\n+    | _ => throw (IO.userError \"unknown benchmark kernel\")\n+  return 0\n+\n+end Bench.Suite"},{"sha":"132b4b3ad0284421aecf109fba264954156ed5d1","filename":"lean/bench/MainFull.lean","status":"modified","additions":8,"deletions":3,"changes":11,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/lean%2Fbench%2FMainFull.lean","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/lean%2Fbench%2FMainFull.lean","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/lean%2Fbench%2FMainFull.lean?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -1,7 +1,12 @@\n import BenchFull\n+import BenchSuite\n import Submission\n \n-/-! The full entry's bench binary: all four kernels of `Submission`, nothing else. -/\n+/-! The full entry's bench binary: all four kernels of `Submission`, nothing else. With a plan in\n+`BENCH_PLAN` it times the suite's cases (`BenchSuite`), without one the legacy classes. -/\n \n-def main : IO UInt32 :=\n-  Bench.runFull Submission.add Submission.mul Submission.sum Submission.bmm\n+def main : IO UInt32 := do\n+  if (← IO.getEnv \"BENCH_PLAN\").isSome then\n+    Bench.Suite.run Submission.add Submission.mul Submission.sum Submission.bmm\n+  else\n+    Bench.runFull Submission.add Submission.mul Submission.sum Submission.bmm"},{"sha":"d83eb03671cd749f99476ebb37ae41e279988f5c","filename":"lean/lakefile.lean","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/lean%2Flakefile.lean","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/lean%2Flakefile.lean","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/lean%2Flakefile.lean?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -44,7 +44,7 @@ lean_lib BenchCore where\n   srcDir := \"bench\"\n   -- BenchDivSqrt and BenchTensor are separate so the add, mul and fma binaries compile exactly as\n   -- calibrated.\n-  roots := #[`Bench, `BenchDivSqrt, `BenchTensor, `BenchBmm, `BenchFull]\n+  roots := #[`Bench, `BenchDivSqrt, `BenchTensor, `BenchBmm, `BenchFull, `BenchSuite]\n \n lean_exe bench where\n   srcDir := \"bench\""},{"sha":"96827e216273c3de9b4bd6fd953586a0b1314a92","filename":"suites/public-v2.json","status":"added","additions":99,"deletions":0,"changes":99,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/suites%2Fpublic-v2.json","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/suites%2Fpublic-v2.json","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/suites%2Fpublic-v2.json?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -0,0 +1,99 @@\n+{\n+  \"version\": \"public-v2\",\n+  \"description\": \"The public suite: the kinds of input the full entry is scored on, for local tuning. The paid board is scored on a private suite with the same groups and other families, parameters and sizes.\",\n+  \"work\": {\"add\": 12, \"mul\": 12, \"sum\": 12, \"bmm\": 12},\n+  \"fallback_cost\": {\"add\": 80, \"mul\": 160, \"sum\": 64, \"bmm\": 48},\n+  \"sizes\": {\n+    \"sum\": [\n+      {\"length\": {\"loguniform\": [1, 64]}},\n+      {\"length\": {\"loguniform\": [64, 1024]}},\n+      {\"length\": {\"loguniform\": [1024, 16384]}}\n+    ],\n+    \"bmm\": [\n+      {\"m\": {\"loguniform\": [1, 16]}, \"n\": {\"loguniform\": [1, 64]}, \"p\": {\"loguniform\": [1, 16]}},\n+      {\"m\": [16, 64], \"n\": [16, 128], \"p\": [16, 64]},\n+      {\"m\": {\"loguniform\": [1, 256]}, \"n\": {\"loguniform\": [1, 64]}, \"p\": {\"loguniform\": [1, 8]}},\n+      {\"m\": {\"loguniform\": [1, 8]}, \"n\": {\"loguniform\": [64, 512]}, \"p\": {\"loguniform\": [1, 8]}}\n+    ]\n+  },\n+  \"groups\": [\n+    {\n+      \"name\": \"dense\",\n+      \"cases\": 6,\n+      \"families\": [\n+        {\"magnitude\": \"uniform\", \"center\": [124, 130], \"spread\": [1, 3]},\n+        {\"magnitude\": \"uniform\", \"center\": [64, 190], \"spread\": [20, 60]},\n+        {\"magnitude\": \"uniform\", \"center\": 127, \"spread\": [30, 100], \"positive\": {\"choices\": [50, 100]}}\n+      ]\n+    },\n+    {\n+      \"name\": \"ml\",\n+      \"cases\": 8,\n+      \"families\": [\n+        {\"magnitude\": \"geometric\", \"center\": [118, 132], \"spread\": [12, 24]},\n+        {\"magnitude\": \"geometric\", \"center\": [115, 123], \"spread\": [8, 16]},\n+        {\"magnitude\": \"geometric\", \"center\": [88, 106], \"spread\": [8, 20]},\n+        {\"magnitude\": \"geometric\", \"center\": [110, 135], \"spread\": [6, 14], \"scale_block\": {\"choices\": [16, 64, 256]}, \"scale_shift\": [4, 20]},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [10, 20], \"mantissa_bits\": 7},\n+        {\"magnitude\": \"geometric\", \"center\": [113, 141], \"spread\": [6, 14], \"mantissa_bits\": 10},\n+        {\"magnitude\": \"uniform\", \"center\": [118, 126], \"spread\": [1, 4], \"codebook\": {\"choices\": [16, 256]}},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 126], \"spread\": [16, 30], \"positive\": 100}\n+      ]\n+    },\n+    {\n+      \"name\": \"sparse\",\n+      \"cases\": 6,\n+      \"families\": [\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"positive\": 100, \"zero_pct\": [35, 65]},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"zero_pct\": [70, 95], \"zero_cluster\": {\"choices\": [1, 4, 16]}, \"zero_kind\": \"signed\"},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"zero_pct\": [30, 60], \"zero_kind\": \"leak\"},\n+        {\"magnitude\": \"uniform\", \"center\": [120, 134], \"spread\": [2, 8], \"zero_pct\": [1, 10]}\n+      ]\n+    },\n+    {\n+      \"name\": \"specials\",\n+      \"cases\": 6,\n+      \"families\": [\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"special_rate\": [10, 1000], \"specials\": [\"inf\", \"nan\"]},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"special_rate\": 1, \"special_place\": \"stride\", \"special_period\": {\"choices\": [17, 64, 100, 333, 1024]}, \"specials\": [\"nan\", \"inf\", \"max\"]},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"special_rate\": [500, 5000], \"special_place\": \"burst\", \"special_burst\": {\"choices\": [4, 32, 256]}},\n+        {\"magnitude\": \"uniform\", \"center\": [120, 134], \"spread\": [2, 8], \"special_rate\": [20000, 100000], \"special_place\": \"edge\"},\n+        {\"magnitude\": \"uniform\", \"center\": [120, 134], \"spread\": [2, 8], \"special_rate\": [5000, 30000]},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"special_rate\": [5000, 50000], \"specials\": [\"zero\"]}\n+      ]\n+    },\n+    {\n+      \"name\": \"subnormal\",\n+      \"cases\": 4,\n+      \"families\": [\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"sub_pct\": [5, 30], \"sub_block\": {\"choices\": [8, 64, 512]}},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"sub_pct\": [1, 10]},\n+        {\"magnitude\": \"geometric\", \"center\": [5, 25], \"spread\": [5, 20]},\n+        {\"magnitude\": \"uniform\", \"center\": [11, 30], \"spread\": [1, 10]}\n+      ]\n+    },\n+    {\n+      \"name\": \"paired\",\n+      \"kernels\": [\"add\", \"mul\"],\n+      \"cases\": 8,\n+      \"families\": [\n+        {\"magnitude\": \"uniform\", \"center\": [100, 150], \"spread\": [1, 10], \"relation\": \"cancel\", \"relation_param\": [0, 12]},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"relation\": \"near\", \"relation_param\": [0, 12]},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"relation\": \"equal\"},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"relation\": \"negate\"},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"relation\": \"identity\", \"relation_param\": [5, 50]},\n+        {\"magnitude\": \"uniform\", \"center\": [110, 140], \"spread\": [1, 6], \"relation\": \"offset\", \"relation_param\": {\"choices\": [1, 8, 23, 24, 25, 30, 60]}},\n+        {\"magnitude\": \"geometric\", \"center\": [118, 130], \"spread\": [8, 20], \"relation\": \"broadcast\"}\n+      ]\n+    },\n+    {\n+      \"name\": \"extremes\",\n+      \"cases\": 4,\n+      \"families\": [\n+        {\"magnitude\": \"uniform\", \"center\": [230, 250], \"spread\": [1, 6]},\n+        {\"magnitude\": \"uniform\", \"center\": 127, \"spread\": 126},\n+        {\"magnitude\": \"uniform\", \"center\": 127, \"spread\": 4, \"scale_block\": {\"choices\": [1, 8]}, \"scale_shift\": [60, 110]}\n+      ]\n+    }\n+  ]\n+}"},{"sha":"e9e62bd12103610b921dc8a0eb49a988be024f9f","filename":"tests/test_benchmark_suite.py","status":"added","additions":333,"deletions":0,"changes":333,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/tests%2Ftest_benchmark_suite.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/tests%2Ftest_benchmark_suite.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/tests%2Ftest_benchmark_suite.py?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -0,0 +1,333 @@\n+\"\"\"Suites and their plans: what a suite file may say, what a plan draws, what a verdict keeps.\"\"\"\n+\n+from __future__ import annotations\n+\n+import copy\n+import json\n+import math\n+from pathlib import Path\n+\n+import pytest\n+\n+import benchmark_suite as bs\n+import fingerprint\n+import gate\n+\n+PUBLIC = Path(__file__).resolve().parents[1] / \"suites\" / \"public-v2.json\"\n+\n+\n+@pytest.fixture\n+def spec() -> dict:\n+    return bs.load(PUBLIC)\n+\n+\n+def test_the_public_suite_loads_and_covers_every_kernel(spec):\n+    cells = bs.cells(spec)\n+    assert {c.split(\":\")[0] for c in cells} == set(bs.KERNELS)\n+    assert len(cells) == len(set(cells))\n+\n+\n+def test_plans_are_reproducible_and_change_with_the_seed(spec):\n+    assert bs.make_plan(spec, 7, 500_000) == bs.make_plan(spec, 7, 500_000)\n+    assert bs.make_plan(spec, 7, 500_000) != bs.make_plan(spec, 8, 500_000)\n+\n+\n+def test_every_cell_gets_its_cases_and_every_kernel_a_checksum_case(spec):\n+    plan = bs.make_plan(spec, 1, 500_000)\n+    names = [c[\"name\"] for c in plan[\"cases\"]]\n+    assert len(names) == len(set(names))\n+    timed = {c[\"name\"].rsplit(\":\", 1)[0] for c in plan[\"cases\"] if c[\"timed\"]}\n+    assert timed == set(bs.cells(spec))\n+    assert {c[\"name\"] for c in plan[\"cases\"] if not c[\"timed\"]} == {\n+        f\"{k}:check\" for k in bs.KERNELS\n+    }\n+\n+\n+def test_each_kernel_spends_at_most_its_work_budget_and_clean_cases_all_of_theirs(spec):\n+    plan = bs.make_plan(spec, 3, 500_000)\n+    for kernel in bs.KERNELS:\n+        timed = [c for c in plan[\"cases\"] if c[\"kernel\"] == kernel and c[\"timed\"]]\n+        budget = spec[\"work\"][kernel] * 500_000\n+        assert 0.5 * budget <= sum(c[\"work\"] for c in timed) <= 1.3 * budget, kernel\n+        clean = [c for c in timed if bs.slow_share(c) == 0]\n+        per_case = budget / len(timed)\n+        assert clean and all(0.5 * per_case <= c[\"work\"] <= 2 * per_case for c in clean), kernel\n+\n+\n+def _case(kernel: str, **params) -> dict:\n+    # One drawn case with the defaults' encoding, a size and the given overrides.\n+    size = {\"length\": 1000, \"m\": 1, \"n\": 1, \"p\": 1, \"batch\": 100, \"work\": 100_000}\n+    if kernel == \"bmm\":\n+        size = {\"length\": 1, \"m\": 32, \"n\": 64, \"p\": 32, \"batch\": 1, \"work\": 32 * 64 * 32}\n+    return {\"name\": f\"{kernel}:t:0\", \"kernel\": kernel, **bs._encode(bs.DEFAULTS, kernel), **size,\n+            **params}  # fmt: skip\n+\n+\n+def test_slow_share_follows_where_accumulations_are_poisoned():\n+    assert bs.slow_share(_case(\"sum\")) == 0\n+    # A NaN on every eighth position poisons nearly all of a 1000-long sum, but a ±0 does not.\n+    nan_stride = {\"specRate\": 1, \"specPlace\": 1, \"specPeriod\": 8, \"specMask\": bs.SPECIALS[\"nan\"]}\n+    assert bs.slow_share(_case(\"sum\", **nan_stride)) > 0.95\n+    assert bs.slow_share(_case(\"sum\", **{**nan_stride, \"specMask\": bs.SPECIALS[\"zero\"]})) == 0\n+    # One NaN in a million: rare in a 1000-long sum, so little of it is slow.\n+    assert bs.slow_share(_case(\"sum\", specRate=1)) < 0.01\n+    # Every value near the largest finite one: sums overflow at once; ordinary values never do.\n+    assert bs.slow_share(_case(\"sum\", center=253, spread=1)) > 0.95\n+    assert bs.slow_share(_case(\"bmm\", center=200, spread=2)) > 0.95\n+    assert bs.slow_share(_case(\"bmm\", center=127, spread=20)) == 0\n+    # No product overflows at exponent 189, but a 173-long dot product of them does.\n+    assert bs.slow_share(_case(\"bmm\", center=189, spread=1, n=173)) > 0.5\n+    assert bs.slow_share(_case(\"bmm\", center=189, spread=1, n=2)) < 0.05\n+    # The whole exponent range: one huge addend does not overflow a short sum, many do a long one.\n+    assert bs.slow_share(_case(\"sum\", center=127, spread=126, length=300)) < 0.05\n+    assert bs.slow_share(_case(\"sum\", center=127, spread=126, length=4000)) > 0.5\n+    # For add and mul, the share is the share of special operands.\n+    assert math.isclose(bs.slow_share(_case(\"mul\", specRate=1000)), 0.01 * 3 / 5)\n+\n+\n+def test_a_slow_case_gets_fewer_steps_so_it_takes_about_as_long_as_a_clean_one(spec):\n+    clean = bs._equal_time(_case(\"sum\"), spec, 100_000)\n+    poisoned = bs._equal_time(\n+        _case(\"sum\", specRate=1, specPlace=1, specPeriod=8, specMask=bs.SPECIALS[\"nan\"]),\n+        spec, 100_000,\n+    )  # fmt: skip\n+    assert clean[\"work\"] == 100_000\n+    # Whole vectors only: its estimated time is between half and all of a clean case's.\n+    cost = 1 + spec[\"fallback_cost\"][\"sum\"] * bs.slow_share(poisoned)\n+    assert 50_000 <= poisoned[\"work\"] * cost <= 100_000\n+    assert poisoned[\"length\"] == 1000\n+\n+\n+@pytest.mark.parametrize(\"work\", [1, 1_000, 30_000])\n+def test_small_budgets_still_draw_nonempty_cases(spec, work):\n+    for case in bs.make_plan(spec, 5, work)[\"cases\"]:\n+        assert case[\"work\"] >= 1 and case[\"batch\"] >= 1 and case[\"length\"] >= 1\n+\n+\n+def test_drawn_sizes_vary_across_seeds(spec):\n+    lengths = {\n+        c[\"length\"]\n+        for seed in range(20)\n+        for c in bs.make_plan(spec, seed, 500_000)[\"cases\"]\n+        if c[\"kernel\"] == \"sum\"\n+    }\n+    shapes = {\n+        (c[\"m\"], c[\"n\"], c[\"p\"])\n+        for seed in range(20)\n+        for c in bs.make_plan(spec, seed, 500_000)[\"cases\"]\n+        if c[\"kernel\"] == \"bmm\"\n+    }\n+    assert len(lengths) > 100 and len(shapes) > 100\n+    assert min(lengths) < 8 and max(lengths) > 4096\n+\n+\n+def test_relations_apply_to_scalar_kernels_only(spec):\n+    plan = bs.make_plan(spec, 11, 500_000)\n+    assert all(c[\"relation\"] == 0 for c in plan[\"cases\"] if c[\"kernel\"] in (\"sum\", \"bmm\"))\n+    assert any(c[\"relation\"] != 0 for c in plan[\"cases\"] if c[\"kernel\"] in (\"add\", \"mul\"))\n+\n+\n+def test_draw_forms():\n+    import random\n+\n+    rng = random.Random(0)\n+    assert bs.draw(rng, 5) == 5\n+    assert all(3 <= bs.draw(rng, [3, 9]) <= 9 for _ in range(50))\n+    assert bs.draw(rng, {\"choices\": [\"a\"]}) == \"a\"\n+    assert all(10 <= bs.draw(rng, {\"loguniform\": [10, 1000]}) <= 1000 for _ in range(50))\n+\n+\n+@pytest.mark.parametrize(\n+    \"breakage\",\n+    [\n+        lambda s: s.pop(\"version\"),\n+        # Weights would say the score is not total time over total time.\n+        lambda s: s.update(kernel_weights=dict.fromkeys(bs.KERNELS, 1)),\n+        lambda s: s[\"groups\"][0].update(weight=2),\n+        lambda s: s[\"work\"].update(add=0),\n+        lambda s: s.pop(\"fallback_cost\"),\n+        lambda s: s[\"fallback_cost\"].update(sum=-1),\n+        lambda s: s[\"groups\"].append(copy.deepcopy(s[\"groups\"][0])),\n+        lambda s: s[\"groups\"][0].update(name=\"check\"),\n+        lambda s: s[\"groups\"][0].update(name=\"a:b\"),\n+        lambda s: s[\"groups\"][0][\"families\"][0].update(colour=\"red\"),\n+        lambda s: s[\"groups\"][0].update(cases=0),\n+        lambda s: s[\"sizes\"].pop(\"sum\"),\n+        lambda s: s.update(groups=[g for g in s[\"groups\"] if \"kernels\" in g]),\n+    ],\n+)\n+def test_a_broken_suite_is_refused(breakage):\n+    spec = json.loads(PUBLIC.read_text())\n+    breakage(spec)\n+    with pytest.raises(bs.SuiteError):\n+        bs.validate(spec)\n+\n+\n+def test_a_parameter_drawn_out_of_range_is_refused(spec):\n+    bad = copy.deepcopy(spec)\n+    bad[\"groups\"][0][\"families\"] = [{\"center\": [250, 300]}]\n+    with pytest.raises(bs.SuiteError):\n+        for seed in range(10):\n+            bs.make_plan(bad, seed, 500_000)\n+\n+\n+def test_without_a_suite_the_gate_keeps_the_legacy_bench(monkeypatch):\n+    monkeypatch.delenv(\"GATE_FULL_SUITE\", raising=False)\n+    assert bs.load() is None and bs.file_sha256() is None\n+\n+\n+def test_the_suite_counts_in_the_fingerprint_by_hash(monkeypatch, tmp_path):\n+    monkeypatch.delenv(\"GATE_FULL_SUITE\", raising=False)\n+    legacy = fingerprint.current()\n+    monkeypatch.setenv(\"GATE_FULL_SUITE\", str(PUBLIC))\n+    public = fingerprint.current()\n+    other = tmp_path / \"other.json\"\n+    other.write_text(PUBLIC.read_text().replace('\"public-v2\"', '\"other-v2\"'))\n+    monkeypatch.setenv(\"GATE_FULL_SUITE\", str(other))\n+    assert len({legacy, public, fingerprint.current()}) == 3\n+\n+\n+def _fake_bench(plan_speed):\n+    # A bench whose times are each case's work times a speed that depends on who runs it.\n+    def bench(binary, seed, build, plan=None):\n+        cases = json.loads(plan)[\"cases\"]\n+        return {\n+            c[\"name\"]: (int(c[\"work\"] * plan_speed(c, bool(build))) if c[\"timed\"] else 0, 99)\n+            for c in cases\n+        }\n+\n+    return bench\n+\n+\n+def test_the_gate_scores_a_suite_like_the_legacy_classes_and_keeps_the_plan_out(monkeypatch):\n+    monkeypatch.setenv(\"GATE_FULL_SUITE\", str(PUBLIC))\n+    monkeypatch.setattr(gate, \"_ROUNDS\", 3)\n+    monkeypatch.setattr(gate, \"_PAIRS\", 20_000)\n+\n+    # Twice as fast everywhere except specials, where it is four times slower.\n+    def speed(case, entry):\n+        if not entry:\n+            return 10.0\n+        return 40.0 if \":specials:\" in case[\"name\"] else 5.0\n+\n+    monkeypatch.setattr(gate, \"bench\", _fake_bench(speed))\n+    v = gate.Verdict(submission=\"probe\", slot=\"full\")\n+    assert gate.score(Path(\"Kernel.lean\"), v) is None\n+    spec = bs.load(PUBLIC)\n+    assert set(v.classes) == set(bs.cells(spec))\n+    # Total time over total time: the specials cases count by the time they take.\n+    timed = [c for c in bs.make_plan(spec, v.seed, 20_000)[\"cases\"] if c[\"timed\"]]\n+    inc = sum(int(c[\"work\"] * 10.0) for c in timed)\n+    sub = sum(int(c[\"work\"] * speed(c, True)) for c in timed)\n+    assert math.isclose(v.ratio, sub / inc)\n+    assert math.isclose(v.classes[\"sum:specials\"][\"ratio\"], 4.0, rel_tol=1e-3)\n+    assert math.isclose(v.classes[\"sum:ml\"][\"incumbent_ns\"], 10.0, rel_tol=1e-3)\n+    # The paired evidence admission reads is the legacy one: per round, the two totals.\n+    assert v.rounds == [[inc, sub]] * 3\n+    published = json.dumps(v.__dict__)\n+    # Results are public, the plan is not: no parameters, sizes, per-case seeds or cases.\n+    for secret in (\"center\", \"spread\", \"specRate\", \"length\", \"batch\", \"work\", \"sum:ml:0\"):\n+        assert f'\"{secret}\"' not in published\n+    assert v.suite == {\"version\": \"public-v2\", \"sha256\": spec[\"sha256\"]}\n+\n+\n+def test_a_missing_case_rejects_the_entry_but_pauses_on_the_incumbent(monkeypatch):\n+    monkeypatch.setenv(\"GATE_FULL_SUITE\", str(PUBLIC))\n+    monkeypatch.setattr(gate, \"_ROUNDS\", 2)\n+    monkeypatch.setattr(gate, \"_PAIRS\", 20_000)\n+    full = _fake_bench(lambda c, entry: 10.0)\n+\n+    def drops(entry_side):\n+        def bench(binary, seed, build, plan=None):\n+            res = full(binary, seed, build, plan)\n+            if bool(build) == entry_side:\n+                res.pop(next(iter(res)))\n+            return res\n+\n+        return bench\n+\n+    monkeypatch.setattr(gate, \"bench\", drops(True))\n+    v = gate.Verdict(submission=\"probe\", slot=\"full\")\n+    assert \"every case\" in gate.score(Path(\"Kernel.lean\"), v) and not v.incumbent_failed\n+    monkeypatch.setattr(gate, \"bench\", drops(False))\n+    v = gate.Verdict(submission=\"probe\", slot=\"full\")\n+    assert gate.score(Path(\"Kernel.lean\"), v).startswith(\"gate error\") and v.incumbent_failed\n+\n+\n+def test_a_checksum_mismatch_on_the_check_case_rejects(monkeypatch):\n+    monkeypatch.setenv(\"GATE_FULL_SUITE\", str(PUBLIC))\n+    monkeypatch.setattr(gate, \"_ROUNDS\", 2)\n+    monkeypatch.setattr(gate, \"_PAIRS\", 20_000)\n+    full = _fake_bench(lambda c, entry: 10.0)\n+\n+    def bench(binary, seed, build, plan=None):\n+        res = full(binary, seed, build, plan)\n+        if build:\n+            res[\"mul:check\"] = (0, 98)\n+        return res\n+\n+    monkeypatch.setattr(gate, \"bench\", bench)\n+    v = gate.Verdict(submission=\"probe\", slot=\"full\")\n+    assert \"checksum mismatch on class mul:check\" in gate.score(Path(\"Kernel.lean\"), v)\n+\n+\n+def test_practice_slots_ignore_the_suite(monkeypatch):\n+    monkeypatch.setenv(\"GATE_FULL_SUITE\", str(PUBLIC))\n+    monkeypatch.setattr(gate, \"_ROUNDS\", 2)\n+    seen = []\n+\n+    def bench(binary, seed, build, plan=None):\n+        seen.append(plan)\n+        return {\"near-one\": (100, 7)}\n+\n+    monkeypatch.setattr(gate, \"bench\", bench)\n+    v = gate.Verdict(submission=\"probe\", slot=\"add\")\n+    assert gate.score(Path(\"Kernel.lean\"), v) is None and seen == [None] * 4 and not v.suite\n+\n+\n+def _suite_verdict(monkeypatch, entry_speed) -> gate.Verdict:\n+    # A gate verdict scored on the public suite with a fake bench.\n+    monkeypatch.setenv(\"GATE_FULL_SUITE\", str(PUBLIC))\n+    monkeypatch.setattr(gate, \"_ROUNDS\", 6)\n+    monkeypatch.setattr(\n+        gate, \"bench\", _fake_bench(lambda c, entry: entry_speed(c) if entry else 10.0)\n+    )\n+    v = gate.Verdict(submission=\"probe\", slot=\"full\", passed=True)\n+    assert gate.score(Path(\"Kernel.lean\"), v) is None\n+    return v\n+\n+\n+@pytest.mark.parametrize(\n+    (\"speed\", \"promoted\"),\n+    [\n+        (lambda c: 8.0, True),\n+        # Faster on most cases, but slow enough on specials that the total is above the bar.\n+        (lambda c: 60.0 if \":specials:\" in c[\"name\"] else 8.0, False),\n+    ],\n+)\n+def test_the_worker_and_the_weight_setter_judge_suite_verdicts_alike(\n+    monkeypatch, tmp_path, speed, promoted\n+):\n+    import datetime as dt\n+    from dataclasses import asdict\n+    from types import SimpleNamespace\n+\n+    import admission\n+    from db import models\n+    from db.scoring import evidence_of\n+    from service import worker\n+\n+    path = tmp_path / \"verdict.json\"\n+    path.write_text(json.dumps(asdict(_suite_verdict(monkeypatch, speed))))\n+    fields = worker.recorded(path)\n+    at = dt.datetime(2026, 10, 1, tzinfo=dt.timezone.utc)\n+    assert worker.beats_champion(SimpleNamespace(id=7, hotkey=\"hk\", submitted_at=at), fields) is (\n+        promoted\n+    )\n+    row = models.Submission(\n+        id=7, hotkey=\"hk\", submitted_at=at, ratio=fields[\"ratio\"], rounds=fields[\"rounds\"],\n+        report=fields[\"report\"],\n+    )  # fmt: skip\n+    e = evidence_of(row)\n+    assert len(e.rounds) == 6\n+    assert (admission.assess(e, 0.97).outcome == \"qualifies\") is promoted"},{"sha":"99f5cfc1a3d67fab7d26307cec0b96fc5667610a","filename":"tests/test_kings_tool.py","status":"added","additions":62,"deletions":0,"changes":62,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/tests%2Ftest_kings_tool.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/tests%2Ftest_kings_tool.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/tests%2Ftest_kings_tool.py?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -0,0 +1,62 @@\n+\"\"\"The kings export: each paid champion's file and the exact source it beat, read-only.\"\"\"\n+\n+from __future__ import annotations\n+\n+import datetime as dt\n+import hashlib\n+import sys\n+from pathlib import Path\n+\n+import db as store_pkg\n+from db import models\n+\n+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"validator\" / \"tools\"))\n+import kings  # noqa: E402\n+\n+\n+def _promote(store, hotkey: str, kernel: bytes, beat_sha: str, *, demoted: bool = False) -> int:\n+    # An accepted full entry with its file, promoted after beating the source hashed `beat_sha`.\n+    sub_id, _ = store.submissions.add(hotkey, hashlib.sha256(kernel).hexdigest(), \"full\", kernel)\n+    with store_pkg.session_scope(store.sessions) as session:\n+        row = session.get(models.Submission, sub_id)\n+        row.state, row.ratio, row.champion_sha256 = \"accepted\", 0.9, beat_sha\n+        session.add(\n+            models.Promotion(\n+                slot=\"full\",\n+                submission_id=sub_id,\n+                champion_sha256=hashlib.sha256(kernel).hexdigest(),\n+                demoted_at=dt.datetime.now(dt.timezone.utc) if demoted else None,\n+            )\n+        )\n+    return sub_id\n+\n+\n+def test_kings_are_written_with_what_each_beat(store, tmp_path):\n+    shipped = hashlib.sha256(kings.SHIPPED.read_bytes()).hexdigest()\n+    a = _promote(store, \"hk-a\", b\"-- A\", shipped)\n+    b = _promote(store, \"hk-b\", b\"-- B\", hashlib.sha256(b\"-- A\").hexdigest())\n+    c = _promote(store, \"hk-c\", b\"-- C\", hashlib.sha256(b\"-- B\").hexdigest(), demoted=True)\n+    d = _promote(store, \"hk-d\", b\"-- D\", hashlib.sha256(b\"-- C\").hexdigest())\n+    e = _promote(store, \"hk-e\", b\"-- E\", hashlib.sha256(b\"-- D\").hexdigest())\n+    written = kings.export(store, tmp_path)\n+    # Newest first, demoted ones skipped, as many as are paid.\n+    assert [k[\"id\"] for k in written] == [e, d, b]\n+    assert c and a\n+    files = {k[\"id\"]: k[\"dir\"] for k in written}\n+    assert (files[e] / \"Kernel.lean\").read_bytes() == b\"-- E\"\n+    assert (files[e] / \"beat\" / \"Kernel.lean\").read_bytes() == b\"-- D\"\n+    # D beat C, since demoted: still the file it was timed against.\n+    assert (files[d] / \"beat\" / \"Kernel.lean\").read_bytes() == b\"-- C\"\n+    assert (files[b] / \"beat\" / \"Kernel.lean\").read_bytes() == b\"-- A\"\n+\n+\n+def test_the_first_king_beat_the_shipped_incumbent(store, tmp_path):\n+    shipped = hashlib.sha256(kings.SHIPPED.read_bytes()).hexdigest()\n+    a = _promote(store, \"hk-a\", b\"-- A\", shipped)\n+    (k,) = kings.export(store, tmp_path)\n+    assert k[\"id\"] == a and k[\"beat\"] == \"shipped\"\n+    assert (k[\"dir\"] / \"beat\" / \"Kernel.lean\").read_bytes() == kings.SHIPPED.read_bytes()\n+\n+\n+def test_nothing_is_written_without_a_promotion(store, tmp_path):\n+    assert kings.export(store, tmp_path) == []"},{"sha":"c4f4e06fbdd7eb8d47b5837d25995a1bb36d70f0","filename":"tests/test_sandbox_suite_mask.py","status":"added","additions":57,"deletions":0,"changes":57,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/tests%2Ftest_sandbox_suite_mask.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/tests%2Ftest_sandbox_suite_mask.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/tests%2Ftest_sandbox_suite_mask.py?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -0,0 +1,57 @@\n+\"\"\"The private suite file is the gate's alone: every build and bench sandbox masks it.\"\"\"\n+\n+from __future__ import annotations\n+\n+import subprocess\n+from pathlib import Path\n+\n+import gate\n+\n+\n+def test_the_suite_file_is_masked_unless_a_tmpfs_already_hides_it(monkeypatch, tmp_path):\n+    suite = tmp_path / \"suites\" / \"scoring.json\"\n+    suite.parent.mkdir()\n+    suite.write_text(\"{}\")\n+    link = tmp_path / \"current.json\"\n+    link.symlink_to(suite)\n+    monkeypatch.delenv(\"GATE_FULL_SUITE\", raising=False)\n+    assert gate.suite_masks(()) == []\n+    monkeypatch.setenv(\"GATE_FULL_SUITE\", str(link))\n+    # Both the name the operator gave and the file it points to.\n+    assert gate.suite_masks((Path(\"/nonexistent\"),)) == sorted([link, suite])\n+    assert gate.suite_masks((tmp_path,)) == []\n+    monkeypatch.setenv(\"GATE_FULL_SUITE\", str(tmp_path / \"missing.json\"))\n+    assert gate.suite_masks(()) == []\n+\n+\n+def test_every_sandboxed_command_binds_dev_null_over_the_suite(monkeypatch):\n+    seen: dict = {}\n+\n+    def masks(hidden):\n+        seen[\"hidden\"] = hidden\n+        return [Path(\"/etc/floatlib/suites/scoring.json\")]\n+\n+    class Done(Exception):\n+        pass\n+\n+    def popen(argv, **kw):\n+        seen[\"argv\"] = argv\n+        raise Done\n+\n+    monkeypatch.setattr(gate, \"suite_masks\", masks)\n+    monkeypatch.setattr(gate, \"_SANDBOX\", True)\n+    monkeypatch.setattr(gate, \"limits\", lambda mb: [])\n+    monkeypatch.setattr(gate, \"wipe\", lambda path: None)\n+    monkeypatch.setattr(gate.shutil, \"copytree\", lambda *a, **k: None)\n+    monkeypatch.setattr(subprocess, \"Popen\", popen)\n+    try:\n+        gate.run([\"true\"], 1)\n+    except Done:\n+        pass\n+    argv = seen[\"argv\"]\n+    i = argv.index(\"/etc/floatlib/suites/scoring.json\")\n+    assert argv[i - 2 : i] == [\"--ro-bind\", \"/dev/null\"]\n+    # After the read-only root it overrides, and inside the sandbox, before the command.\n+    end = len(argv) - 1 - argv[::-1].index(\"--\")\n+    assert argv[end + 1 :] == [\"true\"] and argv.index(\"/\") < i < end\n+    assert Path(\"/tmp\") in seen[\"hidden\"] and Path.home() in seen[\"hidden\"]"},{"sha":"3a80111c464b833ccdb2972dd046faac2ed7c5c2","filename":"validator/tools/kings.py","status":"added","additions":102,"deletions":0,"changes":102,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/a0e80de64aa5394a42b1c9a237c15047ec766f73/validator%2Ftools%2Fkings.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/a0e80de64aa5394a42b1c9a237c15047ec766f73/validator%2Ftools%2Fkings.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/validator%2Ftools%2Fkings.py?ref=a0e80de64aa5394a42b1c9a237c15047ec766f73","patch":"@@ -0,0 +1,102 @@\n+#!/usr/bin/env python3\n+\"\"\"Write the paid kings' Kernel.lean and the champion each beat, to re-time them on a new bench.\n+\n+Read-only. For each of the full slot's paid champions, newest first, it writes\n+<out>/<rank>-<id>/Kernel.lean, and <out>/<rank>-<id>/beat/Kernel.lean: the source whose sha256 the\n+king's own verdict recorded as its champion, an earlier promoted submission or the shipped\n+incumbent. It then prints the gate command that times each king against what it beat. The gate\n+takes the host lock, so a run waits for the worker's current verification and writes its verdict\n+under results/, never to the store.\n+\n+    set -a; . ./.env; set +a\n+    .venv/bin/python validator/tools/kings.py --out /tmp/kings\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import argparse\n+import hashlib\n+import shlex\n+import sys\n+from pathlib import Path\n+\n+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))\n+\n+import db  # noqa: E402\n+from reward import RANK_SHARES  # noqa: E402\n+\n+ROOT = Path(__file__).resolve().parents[2]\n+SHIPPED = ROOT / \"kernels\" / \"full\" / \"incumbent\" / \"Kernel.lean\"\n+\n+\n+def export(store, out: Path, slot: str = \"full\") -> list[dict]:\n+    # Writes each paid king and the source it beat under `out`; returns what was written.\n+    chain = store.submissions.champions(slot)\n+    by_sha = {promotion.champion_sha256: row.id for row, promotion in chain}\n+    kings = [(row, p) for row, p in chain if p.demoted_at is None][: len(RANK_SHARES)]\n+    written = []\n+    for rank, (row, promotion) in enumerate(kings, start=1):\n+        kernel = store.submissions.kernel(row.id)\n+        if kernel is None:\n+            raise SystemExit(f\"king {row.id} has no stored Kernel.lean\")\n+        beat_id = by_sha.get(row.champion_sha256 or \"\")\n+        if beat_id is not None:\n+            beat = store.submissions.kernel(beat_id)\n+        elif hashlib.sha256(SHIPPED.read_bytes()).hexdigest() == row.champion_sha256:\n+            beat = SHIPPED.read_bytes()\n+        else:\n+            raise SystemExit(\n+                f\"king {row.id} beat {row.champion_sha256}, which is neither a promoted \"\n+                \"submission nor the shipped incumbent\"\n+            )\n+        if beat is None:\n+            raise SystemExit(f\"king {row.id} beat submission {beat_id}, which has no stored file\")\n+        home = out / f\"{rank}-{row.id}\"\n+        (home / \"beat\").mkdir(parents=True, exist_ok=True)\n+        (home / \"Kernel.lean\").write_bytes(kernel)\n+        (home / \"beat\" / \"Kernel.lean\").write_bytes(beat)\n+        written.append(\n+            {\n+                \"rank\": rank,\n+                \"id\": row.id,\n+                \"hotkey\": row.hotkey,\n+                \"ratio\": row.ratio,\n+                \"beat\": beat_id if beat_id is not None else \"shipped\",\n+                \"dir\": home,\n+                \"champion_sha256\": promotion.champion_sha256,\n+            }\n+        )\n+    return written\n+\n+\n+def main() -> int:\n+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n+    parser.add_argument(\"--out\", required=True, type=Path, help=\"a new or empty directory\")\n+    args = parser.parse_args()\n+    if args.out.exists() and any(args.out.iterdir()):\n+        parser.error(f\"{args.out} is not empty\")\n+    store = db.connect()\n+    try:\n+        kings = export(store, args.out)\n+    finally:\n+        store.close()\n+    if not kings:\n+        print(\"no promoted champion: the shipped incumbent holds the slot\")\n+        return 0\n+    for k in kings:\n+        print(\n+            f\"rank {k['rank']}: submission {k['id']} ({k['hotkey'][:12]}…), ratio {k['ratio']}, \"\n+            f\"beat {k['beat']}\"\n+        )\n+    print(\"\\nTime each king against what it beat (one at a time; each waits for the gate lock):\")\n+    for k in kings:\n+        home = shlex.quote(str(k[\"dir\"]))\n+        print(\n+            f\"GATE_INCUMBENT_FULL={home}/beat/Kernel.lean .venv/bin/python gate.py --slot full \"\n+            f\"{home} --verdict {home}/verdict.json\"\n+        )\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())"}]}