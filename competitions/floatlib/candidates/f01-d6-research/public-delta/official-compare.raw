api.github.com/users/dendrite-belps/repos","events_url":"https://api.github.com/users/dendrite-belps/events{/privacy}","received_events_url":"https://api.github.com/users/dendrite-belps/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3e8015b3c904c2b3217e55b95f1aed59991148b6","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/3e8015b3c904c2b3217e55b95f1aed59991148b6","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/3e8015b3c904c2b3217e55b95f1aed59991148b6"}]},"status":"ahead","ahead_by":6,"behind_by":0,"total_commits":6,"commits":[{"sha":"a631d500381d89cc0a20a257e40e788c79787101","node_id":"C_kwDOU-E3Y9oAKGE2MzFkNTAwMzgxZDg5Y2MwYTIwYTI1N2U0MGU3ODhjNzk3ODcxMDE","commit":{"author":{"name":"rob-dendrite","email":"rg@dendrite.holdings","date":"2026-10-15T08:54:38Z"},"committer":{"name":"rob-dendrite","email":"rg@dendrite.holdings","date":"2026-10-15T08:54:38Z"},"message":"License the repository under MIT and carry FloatLib's, TorchLean's and Alembic's notices\n\nThe repository was public with no licence, while its kernels and contracts reproduce MIT-licensed\nFloatLib and TorchLean code whose notices must travel with it. LICENSE puts it under MIT,\nTHIRD_PARTY_NOTICES.md reproduces the upstream notices and lists what setup downloads, and\nREUSE.toml records each file's copyright and licence without touching the files: gate.py, the Lake\nfiles and the contract, verify and bench modules are hashed into the verifier fingerprint, and the\nshipped kernels are the champions the boards measure against. The fingerprint is unchanged.\nCI runs `reuse lint`, and the miner guide states the licence a submission is made under.\n\nCo-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>","tree":{"sha":"26a75ad38cb5240ed1a6606d85f1806848309f6b","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/git/tr