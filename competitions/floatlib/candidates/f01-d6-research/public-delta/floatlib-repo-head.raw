[{"sha":"1f5771b3e36a98f17fcac2c6d76aaa024b36aa37","node_id":"C_kwDOUa0K0doAKDFmNTc3MWIzZTM2YTk4ZjE3ZmNhYzJjNmQ3NmFhYTAyNGIzNmFhMzc","commit":{"author":{"name":"Robert joseph","email":"robujsph2001@gmail.com","date":"2026-10-13T20:12:10Z"},"committer":{"name":"Robert joseph","email":"robujsph2001@gmail.com","date":"2026-10-13T20:12:10Z"},"message":"Upgrade Lean 4.35 and harden numerical validation\n\nUpgrade Lean and mathlib to 4.35. Add exhaustive 16-bit and certified expm1/log1p validation, with reproducible MPFX comparisons.\n\nMake reference-checker failures fatal, handle nonfinite inputs correctly, and qualify comparison claims. Remove unused benchmark probes, duplicated source archives, and obsolete archive bookkeeping.","tree":{"sha":"cbc8ba6ccc80a990589a45d12fa29be6e99948e3","url":"https://api.github.com/repos/lean-dojo/FloatLib/git/trees/cbc8ba6ccc80a990589a45d12fa29be6e99948e3"},"url":"https://api.github.com/repos/lean-dojo/FloatLib/git/commits/1f5771b3e36a98f17fcac2c6d76aaa024b36aa37","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/lean-dojo/FloatLib/commits/1f5771b3e36a98f17fcac2c6d76aaa024b36aa37","html_url":"https://github.com/lean-dojo/FloatLib/commit/1f5771b3e36a98f17fcac2c6d76aaa024b36aa37","comments_url":"https://api.github.com/repos/lean-dojo/FloatLib/commits/1f5771b3e36a98f17fcac2c6d76aaa024b36aa37/comments","author":{"login":"Robertboy18","id":32393571,"node_id":"MDQ6VXNlcjMyMzkzNTcx","avatar_url":"https://avatars.githubusercontent.com/u/32393571?v=4","gravatar_id":"","url":"https://api.github.com/users/Robertboy18","html_url":"https://github.com/Robertboy18","followers_url":"https://api.github.com/users/Robertboy18/followers","following_url":"https://api.github.com/users/Robertboy18/following{/other_user}","gists_url":"https://api.github.com/users/Robertboy18/gists{/gist_id}","starred_url":"https://api.github.com/users/Robertboy18/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Robertboy18/subscriptions","organizations_url":"https://api.github.com/users/Robertboy18/orgs","repos_url":"https://api.github.com/users/Robertboy18/repos","events_url":"https://api.github.com/users/Robertboy18/events{/privacy}","received_events_url":"https://api.github.com/users/Robertboy18/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Robertboy18","id":32393571,"node_id":"MDQ6VXNlcjMyMzkzNTcx","avatar_url":"https://avatars.githubusercontent.com/u/32393571?v=4","gravatar_id":"","url":"https://api.github.com/users/Robertboy18","html_url":"https://github.com/Robertboy18","followers_url":"https://api.github.com/users/Robertboy18/followers","following_url":"https://api.github.com/users/Robertboy18/following{/other_user}","gists_url":"https://api.github.com/users/Robertboy18/gists{/gist_id}","starred_url":"https://api.github.com/users/Robertboy18/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Robertboy18/subscriptions","organizations_url":"https://api.github.com/users/Robertboy18/orgs","repos_url":"https://api.github.com/users/Robertboy18/repos","events_url":"https://api.github.com/users/Robertboy18/events{/privacy}","received_events_url":"https://api.github.com/users/Robertboy18/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"21865090ba7c1cd39381c198d5cdd8fb1d8728a3","url":"https://api.github.com/repos/lean-dojo/FloatLib/commits/21865090ba7c1cd39381c198d5cdd8fb1d8728a3","html_url":"https://github.com/lean-dojo/FloatLib/commit/21865090ba7c1cd39381c198d5cdd8fb1d8728a3"}]},{"sha":"21865090ba7c1cd39381c198d5cdd8fb1d8728a3","node_id":"C_kwDOUa0K0doAKDIxODY1MDkwYmE3YzFjZDM5MzgxYzE5OGQ1Y2RkOGZiMWQ4NzI4YTM","commit":{"author":{"name":"Robert joseph","email":"robujsph2001@gmail.com","date":"2026-10-09T04:08:30Z"},"committer":{"name":"Robert joseph","email":"robujsph2001@gmail.com","date":"2026-10-09T04:08:30Z"},"message":"Clean up site redirects and strengthen enclosure accuracy checks\n\nRemove legacy bookmark routes and unused hidden anchors while keeping\nredirects for moved sections and anchors used by current links. Delete\nthe changelog and the preview server's obsolete map-routing comment.\n\nRequire elementary Arb enclosures to satisfy a relative width limit as\nwell as contain the independent reference, so loose bounds fail the\nregression suite.\n\nValidation: full library and test builds, lint, architecture, public API,\nprivacy and trust checks, all 153 elementary Arb comparisons, strict\nguide compilation, and desktop/mobile browser checks passed. All cases\nalso passed a one-bit width allowance; degree 8 caused 133 of 153 to fail.","tree":{"sha":"928c6ccecbf6c7d0a333e2f75e1601e3b13cf4b2","url":"https://api.github.com/repos/lean-dojo/FloatLib/git/trees/928c6ccecbf6c7d0a333e2f75e1601e3b13cf4b2"},"url":"https://api.github.com/repos/lean-dojo/FloatLib/git/commits/21865090ba7c1cd39381c198d5cdd8fb1d8728a3","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/lean-dojo/FloatLib/commits/21865090ba7c1cd39381c198d5cdd8fb1d8728a3","html_url":"https://github.com/lean-dojo/FloatLib/commit/21865090ba7c1cd39381c198d5cdd8fb1d8728a3","comments_url":"https://api.github.com/repos/lean-dojo/FloatLib/commits/21865090ba7c1cd39381c198d5cdd8fb1d8728a3/comments","author":{"login":"Robertboy18","id":32393571,"node_id":"MDQ6VXNlcjMyMzkzNTcx","avatar_url":"https://avatars.githubusercontent.com/u/32393571?v=4","gravatar_id":"","url":"https://api.github.com/users/Robertboy18","html_url":"https://github.com/Robertboy18","followers_url":"https://api.github.com/users/Robertboy18/followers","following_url":"https://api.github.com/users/Robertboy18/following{/other_user}","gists_url":"https://api.github.com/users/Robertboy18/gists{/gist_id}","starred_url":"https://api.github.com/users/Robertboy18/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Robertboy18/subscriptions","organizations_url":"https://api.github.com/users/Robertboy18/orgs","repos_url":"https://api.github.com/users/Robertboy18/repos","events_url":"https://api.github.com/users/Robertboy18/events{/privacy}","received_events_url":"https://api.github.com/users/Robertboy18/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Robertboy18","id":32393571,"node_id":"MDQ6VXNlcjMyMzkzNTcx","avatar_url":"https://avatars.githubusercontent.com/u/32393571?v=4","gravatar_id":"","url":"https://api.github.com/users/Robertboy18","html_url":"https://github.com/Robertboy18","followers_url":"https://api.github.com/users/Robertboy18/followers","following_url":"https://api.github.com/users/Robertboy18/following{/other_user}","gists_url":"https://api.github.com/users/Robertboy18/gists{/gist_id}","starred_url":"https://api.github.com/users/Robertboy18/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Robertboy18/subscriptions","organizations_url":"https://api.github.com/users/Robertboy18/orgs","repos_url":"https://api.github.com/users/Robertboy18/repos","events_url":"https://api.github.com/users/Robertboy18/events{/privacy}","received_events_url":"https://api.github.com/users/Robertboy18/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"50262d4c263b2d12ecc2e30a959706db92d213da","url":"https://api.github.com/repos/lean-dojo/FloatLib/commits/50262d4c263b2d12ecc2e30a959706db92d213da","html_url":"https://github.com/lean-dojo/FloatLib/commit/50262d4c263b2d12ecc2e30a959706db92d213da"}]},{"sha":"50262d4c263b2d12ecc2e30a959706db92d213da","node_id":"C_kwDOUa0K0doAKDUwMjYyZDRjMjYzYjJkMTJlY2MyZTMwYTk1OTcwNmRiOTJkMjEzZGE","commit":{"author":{"name":"robert","email":"robujsph2001@gmail.com","date":"2026-10-08T21:25:19Z"},"committer":{"name":"robert","email":"robujsph2001@gmail.com","date":"2026-10-08T21:25:19Z"},"message":"Extend certified interval automation and transcendental support\n\nRegister built-in and user-defined enclosure procedures through\n@[interval_extension], backed by containment proofs and reevaluated\nduring subdivision. Support certified constants and arbitrary arity.\n\nAdd positive-base real powers, logarithms with a specified base, and\ninverse hyperbolic enclosures with explicit domain checks.\n\nGroup interval automation internals by responsibility, merge equality\nhelpers, remove redundant state and unused wrappers, and document the\nremaining definitions. Update the guide and regression coverage.\n\nValidation: full library and test builds, tests/verify.sh, 153 Arb\ncomparisons, 8192-bit interval proofs, guide compilation, and desktop\nand mobile browser checks passed.","tree":{"sha":"573ab9ba5c347e7366db7b01312366b77b694a8d","url":"https://api.github.com/repos/lean-dojo/FloatLib/git/trees/573ab9ba5c347e7366db7b01312366b77b694a8d"},"url":"https://api.github.com/repos/lean-dojo/FloatLib/git/commits/50262d4c263b2d12ecc2e30a959706db92d213da","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/lean-dojo/FloatLib/commits/50262d4c263b2d12ecc2e30a959706db92d213da","html_url":"https://github.com/lean-dojo/FloatLib/commit/50262d4c263b2d12ecc2e30a959706db92d213da","comments_url":"https://api.github.com/repos/lean-dojo/FloatLib/commits/50262d4c263b2d12ecc2e30a959706db92d213da/comments","author":{"login":"Robertboy18","id":32393571,"node_id":"MDQ6VXNlcjMyMzkzNTcx","avatar_url":"https://avatars.githubusercontent.com/u/32393571?v=4","gravatar_id":"","url":"https://api.github.com/users/Robertboy18","html_url":"https://github.com/Robertboy18","followers_url":"https://api.github.com/users/Robertboy18/followers","following_url":"https://api.github.com/users/Robertboy18/following{/other_user}","gists_ur