        "bytes": 254,
        "sha256": "7a12923b45f8d14ee690de5ac8ca97056c147e1d74de216b3cdbbf0835acd77a",
        "same0e8_97f_3d9": true,
        "same60f": false,
        "source": "def dot (n baseA baseB p : Nat) (A B : Array Binary32) : Binary32 :=\n  let result := dotLoop n baseA baseB p A B 0 (Float32.ofBits 0)\n  if hf : result.isNaN = false then ExecFloat.Binary.ofFloat32 result\n  else R7NaNReplay.replayEarly n baseA baseB p A B"
