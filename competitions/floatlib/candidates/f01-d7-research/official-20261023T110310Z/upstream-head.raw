{"sha":"4b7e83841cc0c32c6529f533923c73d33b5ecf97","node_id":"C_kwDOU-E3Y9oAKDRiN2U4Mzg0MWNjMGMzMmM2NTI5ZjUzMzkyM2M3M2QzM2I1ZWNmOTc","commit":{"author":{"name":"rob-dendrite","email":"rg@dendrite.holdings","date":"2026-10-22T15:23:13Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-22T15:23:13Z"},"message":"Merge pull request #19 from conjectures-io/fix/reject-identical-kernels\n\nReject copies of an accepted Kernel.lean before the gate","tree":{"sha":"2f58575488c5048539e364a8d0823717aa6eecd3","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/git/trees/2f58575488c5048539e364a8d0823717aa6eecd3"},"url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/git/commits/4b7e83841cc0c32c6529f533923c73d33b5ecf97","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq2iphCRC1aQ7uu5UhlAAAgfEQAGE4ou0oeTziYBQnLc33tTDc\n93YU+d4uZGx8hSCQ4zdakZyJWLroP/4/y7aWRDbUyaBdYCz8GHOQh+f1qEy0VdP1\npLcCsqxwE1jK/M4ZgV1XcKeqvDVg3E9AzbvEkDVm7JC7nwYyMJVCY2mAzuA3u/eD\nib27H0Jv3TTKrOuhrAJucyitI11mq4AxbPHm+iiDmL6tzpQVskaqP+EjmnJtqu+3\nQTwiv200WRTnkM5lh/XBgXCipukT+lpRSkn4dMIp3O1hjztkOv4miEnP8UlVcLvE\nv9yi3qG1yDCI10bYYU8SZig0B4yuUUQJhQAEAFueqWxxTsc3t9REqUSnYPVcwswJ\nY3YWXOqgcL6VxIfG17NOrrcSNtSRyvxXWaZw9d9Q6MBCFDrWxkooKX14tGOj8Kr2\nnOlikytukkDDNJCgBJjXF2ZWf+Cb6GZvlIGt5pLzV7KoqF2vPrzBxFFRFlsU7Qzf\n6kqDRuvw3v4CYeK7Tv+aI7vjeuRni77+Bukx3NDNfaiBbe3ce2XDfeF8/vAnOY2Z\ng/VaIClHxzOrUFU9+87dArLpUeyHgQe9dMLpXU+FtCzHoZoU68jUMgIvMTScrS1f\nixJEgPeyJ3J6Tj6zZgLBPY6kKg/OwZZYhkguMgn3QKAIZh7ahbmMx1U7EZJGuUfl\nu7ou3gEgKG4JtKy3ruz+\n=fDXG\n-----END PGP SIGNATURE-----\n","payload":"tree 2f58575488c5048539e364a8d0823717aa6eecd3\nparent a0e80de64aa5394a42b1c9a237c15047ec766f73\nparent eaa2fff38d11c09a572b53fda1510fb79c7edc44\nauthor rob-dendrite <rg@dendrite.holdings> 1792682593 +0200\ncommitter GitHub <noreply@github.com> 1792682593 +0200\n\nMerge pull request #19 from conjectures-io/fix/reject-identical-kernels\n\nReject copies of an accepted Kernel.lean before the gate","verified_at":"2026-10-22T15:23:14Z"}},"url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/4b7e83841cc0c32c6529f533923c73d33b5ecf97","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/4b7e83841cc0c32c6529f533923c73d33b5ecf97","comments_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/4b7e83841cc0c32c6529f533923c73d33b5ecf97/comments","author":{"login":"rob-dendrite","id":289653679,"node_id":"U_kgDOEUPDrw","avatar_url":"https://avatars.githubusercontent.com/u/289653679?v=4","gravatar_id":"","url":"https://api.github.com/users/rob-dendrite","html_url":"https://github.com/rob-dendrite","followers_url":"https://api.github.com/users/rob-dendrite/followers","following_url":"https://api.github.com/users/rob-dendrite/following{/other_user}","gists_url":"https://api.github.com/users/rob-dendrite/gists{/gist_id}","starred_url":"https://api.github.com/users/rob-dendrite/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rob-dendrite/subscriptions","organizations_url":"https://api.github.com/users/rob-dendrite/orgs","repos_url":"https://api.github.com/users/rob-dendrite/repos","events_url":"https://api.github.com/users/rob-dendrite/events{/privacy}","received_events_url":"https://api.github.com/users/rob-dendrite/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"a0e80de64aa5394a42b1c9a237c15047ec766f73","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/a0e80de64aa5394a42b1c9a237c15047ec766f73","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/a0e80de64aa5394a42b1c9a237c15047ec766f73"},{"sha":"eaa2fff38d11c09a572b53fda1510fb79c7edc44","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/commits/eaa2fff38d11c09a572b53fda1510fb79c7edc44","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/commit/eaa2fff38d11c09a572b53fda1510fb79c7edc44"}],"stats":{"total":207,"additions":204,"deletions":3},"files":[{"sha":"04c4e5f9dcf30e0ffd61cb37e71c0b96e74732c8","filename":"MANUAL.md","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/4b7e83841cc0c32c6529f533923c73d33b5ecf97/MANUAL.md","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/4b7e83841cc0c32c6529f533923c73d33b5ecf97/MANUAL.md","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/MANUAL.md?ref=4b7e83841cc0c32c6529f533923c73d33b5ecf97","patch":"@@ -178,6 +178,10 @@ most the promotion bar (default `0.97`, meaning at least 3% faster), and a\n statistical test of the paired benchmark rounds confirms a speed advantage.\n The test reduces the chance that timing noise causes a promotion; it does not eliminate measurement uncertainty.\n \n+A `Kernel.lean` identical to an earlier accepted submission in the same slot,\n+ignoring comments and whitespace, is rejected at intake without being timed: a\n+copy cannot win on noise. It spends the registration like any other rejection.\n+\n The latest three champions receive 60%, 30%, and 10% of the competition\n budget, excluding any explicitly removed by an operator. Empty ranks and unpaid\n shares go to treasury. One hotkey holding several ranks receives their combined"},{"sha":"e98c0b6a2660cf60b0153a965ca27f36ccf60d5e","filename":"tests/conftest.py","status":"modified","additions":4,"deletions":2,"changes":6,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/4b7e83841cc0c32c6529f533923c73d33b5ecf97/tests%2Fconftest.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/4b7e83841cc0c32c6529f533923c73d33b5ecf97/tests%2Fconftest.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/tests%2Fconftest.py?ref=4b7e83841cc0c32c6529f533923c73d33b5ecf97","patch":"@@ -218,11 +218,13 @@ def run() -> int:\n \n \n def kernel_file(tmp: Path, name: str, marker: str = \"\") -> Path:\n-    # A copy of the incumbent's Kernel.lean, with a marker line the stub gate reads.\n+    # A copy of the incumbent's Kernel.lean, with a marker the stub gate reads. The marker is code,\n+    # not a comment, so files with different markers are different entries, not copies.\n     d = tmp / name\n     d.mkdir(parents=True)\n     text = (REPO / \"kernels\" / \"add\" / \"incumbent\" / \"Kernel.lean\").read_text()\n-    (d / \"Kernel.lean\").write_text(text + (f\"\\n-- {marker}\\n\" if marker else \"\"))\n+    line = f'\\ndef stubMarker : String := \"{marker} \"\\n'\n+    (d / \"Kernel.lean\").write_text(text + (line if marker else \"\"))\n     return d\n \n "},{"sha":"d65c3cb9ca03d6d7d3ed85095d3886ad92906e8d","filename":"tests/test_duplicates.py","status":"added","additions":97,"deletions":0,"changes":97,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/4b7e83841cc0c32c6529f533923c73d33b5ecf97/tests%2Ftest_duplicates.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/4b7e83841cc0c32c6529f533923c73d33b5ecf97/tests%2Ftest_duplicates.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/tests%2Ftest_duplicates.py?ref=4b7e83841cc0c32c6529f533923c73d33b5ecf97","patch":"@@ -0,0 +1,97 @@\n+\"\"\"Copies of an accepted Kernel.lean are refused before the gate.\"\"\"\n+\n+from __future__ import annotations\n+\n+import hashlib\n+\n+from conftest import register\n+from service import duplicates, worker\n+\n+ORIGINAL = b\"\"\"-- a fast add\n+/-- Doc comment with a \"quote\" and -- dashes. /- nested -/ still inside -/\n+def add (x y : Float) : Float := x + y  -- trailing\n+def msg : String := \"keep -- this and /- this -/\"\n+\"\"\"\n+\n+\n+def add(store, name, body, slot=\"full\"):\n+    register(store, name, uid=len(name), block=1000 + sum(name.encode()))\n+    return store.submissions.add(name, hashlib.sha256(body).hexdigest(), slot, body)[0]\n+\n+\n+def test_normalising_strips_comments_and_whitespace_but_never_strings():\n+    text = duplicates.normalized(ORIGINAL.decode())\n+    assert text == (\n+        'def add (x y : Float) : Float := x + y def msg : String := \"keep -- this and /- this -/\"'\n+    )\n+    reflowed = b\"def add (x y : Float) : Float :=\\n    x + y\\n\\n\" + ORIGINAL.splitlines()[-1]\n+    assert duplicates.normalized_digest(reflowed) == duplicates.normalized_digest(ORIGINAL)\n+    # A change inside a string literal or in code is a different file.\n+    changed = ORIGINAL.replace(b\"keep -- this\", b\"keep -- that\")\n+    assert duplicates.normalized_digest(changed) != duplicates.normalized_digest(ORIGINAL)\n+    assert duplicates.normalized_digest(ORIGINAL.replace(b\"x + y\", b\"y + x\")) != (\n+        duplicates.normalized_digest(ORIGINAL)\n+    )\n+\n+\n+def test_an_unclosed_comment_or_a_quote_inside_one_cannot_hide_code():\n+    a = duplicates.normalized('/- a \"b -/ def f := 1 /- \"c -/ def g := 2')\n+    assert a == \"def f := 1 def g := 2\"\n+    assert duplicates.normalized(\"def f := 1 /- open\") == \"def f := 1\"\n+\n+\n+def test_copies_of_an_accepted_kernel_are_rejected_without_a_gate_run(\n+    store, settings, stub_gate, monkeypatch\n+):\n+    body = b\"RATIO=0.95 -- the original\\n\"\n+    first = add(store, \"first\", body)\n+    assert worker.drain(store, settings) == 1\n+    assert store.submissions.get(first).state == \"accepted\"\n+\n+    gated = []\n+    original = worker.run_gate\n+\n+    def counting(directory, verdict, slot, env):\n+        gated.append(int(directory.name))\n+        return original(directory, verdict, slot, env)\n+\n+    monkeypatch.setattr(worker, \"run_gate\", counting)\n+    same = add(store, \"same\", body)\n+    recommented = add(store, \"recommented\", b\"RATIO=0.95   -- copied, nothing changed\\n\\n\")\n+    different = add(store, \"different\", b\"RATIO=0.96\\n\")\n+    assert worker.drain(store, settings) == 3\n+    for sub_id in (same, recommented):\n+        row = store.submissions.get(sub_id)\n+        assert row.state == \"rejected\" and row.stage == \"intake\"\n+        assert f\"identical to accepted submission {first}\" in row.reason\n+    # Only the genuinely different file reached the gate.\n+    assert gated == [different]\n+    assert store.submissions.get(different).state == \"accepted\"\n+\n+\n+def test_a_copy_of_a_rejected_kernel_still_goes_through_the_gate(store, settings, stub_gate):\n+    first = add(store, \"first\", b\"REJECT\\n\")\n+    assert worker.drain(store, settings) == 1\n+    assert store.submissions.get(first).state == \"rejected\"\n+    again = add(store, \"again\", b\"REJECT -- try again\\n\")\n+    assert worker.drain(store, settings) == 1\n+    row = store.submissions.get(again)\n+    assert row.state == \"rejected\" and row.stage != \"intake\"\n+\n+\n+def test_a_re_verified_copy_accepted_before_the_rule_is_not_rejected(\n+    store, settings, stub_gate, monkeypatch\n+):\n+    # Two identical entries accepted before this rule existed, like PROD's #155 and #165.\n+    with monkeypatch.context() as before_the_rule:\n+        before_the_rule.setattr(duplicates, \"identical_to\", lambda store, sub: None)\n+        first = add(store, \"first\", b\"RATIO=0.95\\n\")\n+        copy = add(store, \"copy\", b\"RATIO=0.95 -- copy\\n\")\n+        assert worker.drain(store, settings) == 2\n+    # Re-verifying the copy (reverify.py requeues accepted entries) gates it again as before.\n+    store.submissions.requeue(copy)\n+    assert store.submissions.get(copy).state == \"queued\"\n+    assert worker.drain(store, settings) == 1\n+    row = store.submissions.get(copy)\n+    assert row.state == \"accepted\" and row.stage == \"score\"\n+    assert store.submissions.get(first).state == \"accepted\""},{"sha":"0f3e3604d17b5ca917b2af8e1293da67c67bf107","filename":"validator/db/submissions.py","status":"modified","additions":14,"deletions":0,"changes":14,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/4b7e83841cc0c32c6529f533923c73d33b5ecf97/validator%2Fdb%2Fsubmissions.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/4b7e83841cc0c32c6529f533923c73d33b5ecf97/validator%2Fdb%2Fsubmissions.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/validator%2Fdb%2Fsubmissions.py?ref=4b7e83841cc0c32c6529f533923c73d33b5ecf97","patch":"@@ -257,6 +257,20 @@ def gate_crashed(\n             )\n             return row.state\n \n+    def accepted_before(self, slot: str, sub_id: int) -> list[tuple[int, str]]:\n+        # The slot's accepted submissions older than `sub_id`, oldest first: (id, digest).\n+        with session_scope(self._sessions) as session:\n+            rows = session.execute(\n+                select(models.Submission.id, models.Submission.digest)\n+                .where(\n+                    models.Submission.slot == slot,\n+                    models.Submission.state == SubmissionState.ACCEPTED.value,\n+                    models.Submission.id < sub_id,\n+                )\n+                .order_by(models.Submission.id)\n+            ).all()\n+            return [(int(i), str(d)) for i, d in rows]\n+\n     def kernel(self, sub_id: int) -> bytes | None:\n         # The submission's Kernel.lean from the store; None for one queued before it kept files.\n         with session_scope(self._sessions) as session:"},{"sha":"5e19047bb8c05bac1638970fe7fffcad63baf397","filename":"validator/service/duplicates.py","status":"added","additions":63,"deletions":0,"changes":63,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/4b7e83841cc0c32c6529f533923c73d33b5ecf97/validator%2Fservice%2Fduplicates.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/4b7e83841cc0c32c6529f533923c73d33b5ecf97/validator%2Fservice%2Fduplicates.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/validator%2Fservice%2Fduplicates.py?ref=4b7e83841cc0c32c6529f533923c73d33b5ecf97","patch":"@@ -0,0 +1,63 @@\n+\"\"\"Copies of an accepted Kernel.lean: refused before the gate, so timing noise cannot crown one.\n+\n+The same file from another hotkey, or with only comments and whitespace changed, times like the\n+original; on a noisy benchmark one copy in a few still lands under the promotion bar against its\n+own source. A submission whose normalised source matches an earlier accepted submission in its\n+slot is rejected at intake. Comments are stripped (nested block and doc comments included, string\n+literals untouched) and whitespace collapsed; renamed identifiers or reordered code are not caught.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import hashlib\n+import re\n+\n+from db import Store, models\n+\n+# In code: a string literal (kept whole), a block comment's start, or a line comment.\n+_CODE = re.compile(r'\"(?:\\\\.|[^\"\\\\])*\"|/-|--[^\\n]*')\n+# Inside a block comment: a nested start or an end; quotes and dashes are just comment text.\n+_COMMENT = re.compile(r\"/-|-/\")\n+\n+\n+def normalized(source: str) -> str:\n+    # The source without comments, its whitespace collapsed to single spaces.\n+    kept, pos, depth = [], 0, 0\n+    while True:\n+        if depth == 0:\n+            m = _CODE.search(source, pos)\n+            if m is None:\n+                kept.append(source[pos:])\n+                break\n+            if m.group().startswith('\"'):\n+                kept.append(source[pos : m.end()])\n+            else:\n+                kept.append(source[pos : m.start()])\n+                depth = 1 if m.group() == \"/-\" else 0\n+            pos = m.end()\n+        else:\n+            m = _COMMENT.search(source, pos)\n+            if m is None:\n+                break  # an unclosed comment runs to the end of the file\n+            depth += 1 if m.group() == \"/-\" else -1\n+            pos = m.end()\n+    return \" \".join(\"\".join(kept).split())\n+\n+\n+def normalized_digest(kernel: bytes) -> str:\n+    return hashlib.sha256(normalized(kernel.decode(\"utf-8\", \"replace\")).encode()).hexdigest()\n+\n+\n+def identical_to(store: Store, sub: models.Submission) -> int | None:\n+    # The earliest accepted submission in the slot whose normalised Kernel.lean matches this one's.\n+    mine = store.submissions.kernel(sub.id)\n+    if mine is None:\n+        return None\n+    digest = normalized_digest(mine)\n+    for other_id, other_digest in store.submissions.accepted_before(sub.slot, sub.id):\n+        if other_digest == sub.digest:\n+            return other_id\n+        other = store.submissions.kernel(other_id)\n+        if other is not None and normalized_digest(other) == digest:\n+            return other_id\n+    return None"},{"sha":"99b1a1ff1b4fd21588011f6c530676e8b96c5777","filename":"validator/service/worker.py","status":"modified","additions":22,"deletions":1,"changes":23,"blob_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/blob/4b7e83841cc0c32c6529f533923c73d33b5ecf97/validator%2Fservice%2Fworker.py","raw_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/raw/4b7e83841cc0c32c6529f533923c73d33b5ecf97/validator%2Fservice%2Fworker.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/contents/validator%2Fservice%2Fworker.py?ref=4b7e83841cc0c32c6529f533923c73d33b5ecf97","patch":"@@ -24,7 +24,7 @@\n from db import SubmissionState, models\n from db.drift import observe\n \n-from . import storage\n+from . import duplicates, storage\n from .settings import PROMOTION_BAR, Settings, load\n \n VALIDATOR = Path(__file__).resolve().parent.parent\n@@ -182,6 +182,27 @@ def score_one(store: db.Store, settings: Settings, sub: models.Submission) -> st\n     events = get_events()\n     who = {\"submission_id\": sub.id, \"hotkey\": sub.hotkey, \"slot\": sub.slot}\n     pause = store.pauses.all().get(sub.slot)\n+    # A copy of an accepted entry is refused before its first gate run. A re-verification (it has\n+    # finished before, e.g. a champion requeued by reverify.py) and a paused challenger are not.\n+    first_run = sub.finished_at is None and not (pause and pause.challenger_id == sub.id)\n+    twin = duplicates.identical_to(store, sub) if first_run else None\n+    if twin is not None:\n+        reason = (\n+            f\"identical to accepted submission {twin}: the same Kernel.lean up to comments and \"\n+            \"whitespace\"\n+        )\n+        report = {\"submission\": str(sub.id), \"stage\": \"intake\", \"passed\": False, \"reason\": reason}\n+        final = store.submissions.finish(\n+            sub.id,\n+            SubmissionState.REJECTED,\n+            expected_attempt=sub.verification_attempt,\n+            stage=\"intake\",\n+            reason=reason,\n+            report=json.dumps(report),\n+        )\n+        events.emit(\"warning\", \"gate_verdict\", **who, state=final, stage=\"intake\", reason=reason)\n+        logger.info(f\"[worker] submission {sub.id} {final}: {reason}\")\n+        return final\n     reference = store.submissions.champion(sub.slot, before=sub.id)\n     with tempfile.TemporaryDirectory(prefix=f\"gate-{sub.id}-\") as tmp:\n         verdict = Path(tmp) / \"verdict.json\""}]}