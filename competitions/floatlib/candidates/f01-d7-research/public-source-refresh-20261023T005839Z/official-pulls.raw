[{"url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/pulls/19","id":4969795177,"node_id":"PR_kwDOU-E3Y88AAAABKDkOaQ","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/pull/19","diff_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/pull/19.diff","patch_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/pull/19.patch","issue_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/issues/19","number":19,"state":"closed","locked":false,"title":"Reject copies of an accepted Kernel.lean before the gate","user":{"login":"rob-dendrite","id":289653679,"node_id":"U_kgDOEUPDrw","avatar_url":"https://avatars.githubusercontent.com/u/289653679?v=4","gravatar_id":"","url":"https://api.github.com/users/rob-dendrite","html_url":"https://github.com/rob-dendrite","followers_url":"https://api.github.com/users/rob-dendrite/followers","following_url":"https://api.github.com/users/rob-dendrite/following{/other_user}","gists_url":"https://api.github.com/users/rob-dendrite/gists{/gist_id}","starred_url":"https://api.github.com/users/rob-dendrite/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rob-dendrite/subscriptions","organizations_url":"https://api.github.com/users/rob-dendrite/orgs","repos_url":"https://api.github.com/users/rob-dendrite/repos","events_url":"https://api.github.com/users/rob-dendrite/events{/privacy}","received_events_url":"https://api.github.com/users/rob-dendrite/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"Identical kernels from different hotkeys were promoted over their own source on timing noise: on PROD #165 is byte-identical to #155 and was promoted at 0.934 against it, and the same files have been resubmitted by 15 and 7 hotkeys. The worker now rejects, at intake and without a gate run, a submission whose Kernel.lean matches an earlier accepted one in its slot once comments (nested block and doc comments included, string literals untouched) are stripped and whitespace collapsed. The reason names the original. A re-verification or a paused challenger is never refused this way, so entries accepted before the rule keep their standing when reverified.\n\nThe test helper's marker becomes a string declaration, not a comment, so stub entries with different markers stay different files.","created_at":"2026-10-22T15:22:22Z","updated_at":"2026-10-22T15:23:14Z","closed_at":"2026-10-22T15:23:13Z","merged_at":"2026-10-22T15:23:13Z","merge_commit_sha":"4b7e83841cc0c32c6529f533923c73d33b5ecf97","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[],"milestone":null,"draft":false,"commits_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/pulls/19/commits","review_comments_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/pulls/19/comments","review_comment_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/pulls/comments{/number}","comments_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/issues/19/comments","statuses_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/statuses/eaa2fff38d11c09a572b53fda1510fb79c7edc44","head":{"label":"conjectures-io:fix/reject-identical-kernels","ref":"fix/reject-identical-kernels","sha":"eaa2fff38d11c09a572b53fda1510fb79c7edc44","user":{"login":"conjectures-io","id":309972092,"node_id":"O_kgDOEnnMfA","avatar_url":"https://avatars.githubusercontent.com/u/309972092?v=4","gravatar_id":"","url":"https://api.github.com/users/conjectures-io","html_url":"https://github.com/conjectures-io","followers_url":"https://api.github.com/users/conjectures-io/followers","following_url":"https://api.github.com/users/conjectures-io/following{/other_user}","gists_url":"https://api.github.com/