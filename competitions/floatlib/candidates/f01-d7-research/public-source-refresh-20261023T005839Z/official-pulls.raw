3:19Z","pushed_at":"2026-10-22T15:48:18Z","git_url":"git://github.com/conjectures-io/conjectures-optimisation-float-kernels.git","ssh_url":"git@github.com:conjectures-io/conjectures-optimisation-float-kernels.git","clone_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels.git","svn_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels","homepage":null,"size":1079,"stargazers_count":0,"watchers_count":0,"language":"Python","has_issues":true,"has_projects":true,"has_downloads":false,"has_wiki":false,"has_pages":false,"has_discussions":false,"forks_count":0,"mirror_url":null,"archived":false,"disabled":false,"open_issues_count":0,"license":{"key":"mit","name":"MIT License","spdx_id":"MIT","url":"https://api.github.com/licenses/mit","node_id":"MDc6TGljZW5zZTEz"},"allow_forking":true,"is_template":false,"web_commit_signoff_required":false,"has_pull_requests":true,"pull_request_creation_policy":"all","topics":[],"visibility":"public","forks":0,"open_issues":0,"watchers":0,"default_branch":"main"}},"_links":{"self":{"href":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/pulls/19"},"html":{"href":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/pull/19"},"issue":{"href":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/issues/19"},"comments":{"href":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/issues/19/comments"},"review_comments":{"href":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/pulls/19/comments"},"review_comment":{"href":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/pulls/comments{/number}"},"commits":{"href":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/pulls/19/commits"},"statuses":{"href":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/statuses/eaa2fff38d11c09a572b53fda1510fb79c7edc44"}},"author_association":"CONTRIBUTOR","auto_merge":null,"assignee":null,"active_lock_reason":null},{"url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/pulls/18","id":4968268934,"node_id":"PR_kwDOU-E3Y88AAAABKCHEhg","html_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/pull/18","diff_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/pull/18.diff","patch_url":"https://github.com/conjectures-io/conjectures-optimisation-float-kernels/pull/18.patch","issue_url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/issues/18","number":18,"state":"closed","locked":false,"title":"Hide the private suite file from every build and bench sandbox","user":{"login":"rob-dendrite","id":289653679,"node_id":"U_kgDOEUPDrw","avatar_url":"https://avatars.githubusercontent.com/u/289653679?v=4","gravatar_id":"","url":"https://api.github.com/users/rob-dendrite","html_url":"https://github.com/rob-dendrite","followers_url":"https://api.github.com/users/rob-dendrite/followers","following_url":"https://api.github.com/users/rob-dendrite/following{/other_user}","gists_url":"https://api.github.com/users/rob-dendrite/gists{/gist_id}","starred_url":"https://api.github.com/users/rob-dendrite/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rob-dendrite/subscriptions","organizations_url":"https://api.github.com/users/rob-dendrite/orgs","repos_url":"https://api.github.com/users/rob-dendrite/repos","events_url":"https://api.github.com/users/rob-dendrite/events{/privacy}","received_events_url":"https://api.github.com/users/rob-dendrite/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"## What and why\n\nThe gate's sandbox binds `/` read-only and hides only `$HOME`, the checkout and the runtime dir behind tmpfs. A private suite kept where OPERATIONS suggests, `/etc/floatlib/suites/scoring.json` with mode 0600, is owned by the gate's own user, so a build or bench inside the sandbox could read it.\n\nThe policy's banned tokens (`IO`, `include_str`, macros, `#eval`, `unsafe`, `extern`…) stop the known ways a `Kernel.lean` reads files. But that's a blacklist, and the file should not be visible at all. Benches get their cases through `BENCH_PLAN`, so nothing in the sandbox needs it.\n\nThis should land before PROD sets `GATE_FULL_SUITE`.\n\n## What changes\n\n- **`gate.py`**: `run()` binds `/dev/null` over `GATE_FULL_SUITE`, both as named and as resolved through symlinks. It skips paths already under the `$HOME`, checkout or `/tmp` tmpfs, where a mount point may not exist.\n- **`tests/test_sandbox_suite_mask.py`**: covers which paths are masked, and that every sandboxed command carries the mask after the read-only root and before the command.\n\n## Checks\n\n- `ruff check .` and `ruff format --check .`: clean.\n- `pytest -q` against Postgres 17: 271 passed, 7 skipped.\n- Real `bwrap` on a dev machine, with `--ro-bind / /` and `--unshare-all`:\n  - without the mask, a 0600 file owned by the user is readable inside;\n  - with it, the file reads as empty, or permission is denied inside a 0700 directory;\n  - the file is unchanged outside.\n\n## Deploy / operator steps\n\nPull `main` in the PROD checkout as the gate's user and reload the gate worker. Unset, `GATE_FULL_SUITE` changes nothing.\n\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n","created_at":"2026-10-22T13:34:06Z","updated_at":"2026-10-22T13:38:20Z","closed_at":"2026-10-22T13:38:20Z","merged_at":"2026-10-22T13:38:20Z","merge_commit_sha":"a0e80de64aa5394a42b1c9a237c15047ec766f73","assignees":[],"requested_reviewers":[],"requested_teams":[],"labels":[{"id":12566616691,"node_id":"LA_kwDOU-E3Y88AAAAC7Qdacw","url":"https://api.github.com/repos/conjectures-io/conjectures-optimisation-float-kernels/labels/bug","name":"bug","color":"d73a4a","default":true,"descrip