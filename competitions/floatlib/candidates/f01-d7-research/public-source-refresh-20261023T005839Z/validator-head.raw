s:\n       - name: Token from the release GitHub App\n         id: app\n         if: steps.diff.outputs.needed == 'true' && vars.RELEASE_APP_ID != ''\n-        uses: actions/create-github-app-token@d72941d797fd3113feb6b93fd0dec494b13a2547 # v1.12.0\n+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0\n         with:\n           app-id: ${{ vars.RELEASE_APP_ID }}\n           private-key: ${{ secrets.RELEASE_APP_KEY }}"},{"sha":"7c8d3ce404495364ed9bed51e85702bfa69cee0c","filename":".github/workflows/ci.yml","status":"modified","additions":11,"deletions":11,"changes":22,"blob_url":"https://github.com/conjectures-io/conjectures-validator/blob/e78afe97f93cbdae1f65f354a8e8d12b355f2020/.github%2Fworkflows%2Fci.yml","raw_url":"https://github.com/conjectures-io/conjectures-validator/raw/e78afe97f93cbdae1f65f354a8e8d12b355f2020/.github%2Fworkflows%2Fci.yml","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-validator/contents/.github%2Fworkflows%2Fci.yml?ref=e78afe97f93cbdae1f65f354a8e8d12b355f2020","patch":"@@ -49,7 +49,7 @@ jobs:\n     if: github.event_name == 'pull_request' && github.base_ref == 'main'\n     runs-on: ubuntu-latest\n     steps:\n-      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n         with:\n           ref: ${{ github.event.pull_request.head.sha }}\n           fetch-depth: 0\n@@ -89,9 +89,9 @@ jobs:\n     name: ruff\n     runs-on: ubuntu-latest\n     steps:\n-      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n \n-      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0\n+      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0\n         with:\n           python-version: ${{ env.PYTHON_VERSION }}\n \n@@ -141,9 +141,9 @@ jobs:\n     # a server before tests/database_guard.py has proved which one it is.\n \n     steps:\n-      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n \n-      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0\n+      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0\n         with:\n           python-version: ${{ env.PYTHON_VERSION }}\n           cache: pip\n@@ -349,9 +349,9 @@ jobs:\n           --health-retries 10\n \n     steps:\n-      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n \n-      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0\n+      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0\n         with:\n           python-version: ${{ env.PYTHON_VERSION }}\n           cache: pip\n@@ -378,8 +378,8 @@ jobs:\n     name: Collatz statement checks\n     runs-on: ubuntu-latest\n     steps:\n-      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n-      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0\n+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n+      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0\n         with:\n           python-version: \"3.12\"\n       - run: python staged/collatz-partials-20261012/check_semantics.py\n@@ -403,7 +403,7 @@ jobs:\n       (needs.release-source.result == 'success' || needs.release-source.result == 'skipped')\n     runs-on: ubuntu-latest\n     steps:\n-      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n \n       - name: Name the tested tree\n         id: tree\n@@ -415,7 +415,7 @@ jobs:\n           echo \"tree=$tree\" >> \"$GITHUB_OUTPUT\"\n           echo \"All gates passed on tree \\`$tree\\`.\" >> \"$GITHUB_STEP_SUMMARY\"\n \n-      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n+      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n         with:\n           name: ci-passed-${{ steps.tree.outputs.tree }}\n           path: tested.txt"},{"sha":"2eed8099ca187b184fe8eaf7f39f8fc41ffb6d09","filename":".github/workflows/deploy.yml","status":"modified","additions":5,"deletions":5,"changes":10,"blob_url":"https://github.com/conjectures-io/conjectures-validator/blob/e78afe97f93cbdae1f65f354a8e8d12b355f2020/.github%2Fworkflows%2Fdeploy.yml","raw_url":"https://github.com/conjectures-io/conjectures-validator/raw/e78afe97f93cbdae1f65f354a8e8d12b355f2020/.github%2Fworkflows%2Fdeploy.yml","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-validator/contents/.github%2Fworkflows%2Fdeploy.yml?ref=e78afe97f93cbdae1f65f354a8e8d12b355f2020","patch":"@@ -69,7 +69,7 @@ jobs:\n     outputs:\n       run_ci: ${{ steps.lookup.outputs.run_ci }}\n     steps:\n-      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n \n       - name: Look for a green run that tested this commit\n         id: lookup\n@@ -132,7 +132,7 @@ jobs:\n       scope: ${{ steps.scope.outputs.scope }}\n       gated: ${{ steps.scope.outputs.gated }}\n     steps:\n-      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n         with:\n           fetch-depth: 0\n \n@@ -359,7 +359,7 @@ jobs:\n       - name: Token from the release GitHub App\n         id: app\n         if: vars.RELEASE_APP_ID != ''\n-        uses: actions/create-github-app-token@d72941d797fd3113feb6b93fd0dec494b13a2547 # v1.12.0\n+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0\n         with:\n           app-id: ${{ vars.RELEASE_APP_ID }}\n           private-key: ${{ secrets.RELEASE_APP_KEY }}\n@@ -406,13 +406,13 @@ jobs:\n       - name: Token from the release GitHub App\n         id: app\n         if: vars.RELEASE_APP_ID != ''\n-        uses: actions/create-github-app-token@d72941d797fd3113feb6b93fd0dec494b13a2547 # v1.12.0\n+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0\n         with:\n           app-id: ${{ vars.RELEASE_APP_ID }}\n           private-key: ${{ secrets.RELEASE_APP_KEY }}\n \n       # The commit and the rollback tag were resolved and checked by `plan`.\n-      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0\n+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n         with:\n           ref: main\n           fetch-depth: 0"},{"sha":"a140c71dfc0df167a6b5ea85a242bad049141b74","filename":"docs/COMPETITION_API.md","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/conjectures-io/conjectures-validator/blob/e78afe97f93cbdae1f65f354a8e8d12b355f2020/docs%2FCOMPETITION_API.md","raw_url":"https://github.com/conjectures-io/conjectures-validator/raw/e78afe97f93cbdae1f65f354a8e8d12b355f2020/docs%2FCOMPETITION_API.md","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-validator/contents/docs%2FCOMPETITION_API.md?ref=e78afe97f93cbdae1f65f354a8e8d12b355f2020","patch":"@@ -1073,9 +1073,9 @@ into ratios against today's champion. Use `/champions`'s `current` field to dist\n \n ### GET `/v1/competitions/{board}/champions`\n \n-Every submission the board promoted, newest first, without pagination: `[{submission, hotkey, ratio, speedup_vs_shipped, promoted_at, demoted_at, current, rank, rank_share}]`. `ratio` is against the champion it took over from: its total time over that champion's, so lower is faster.\n+Every submission the board promoted, newest first, without pagination: `[{submission, hotkey, ratio, speedup_vs_shipped, speedup_basis, promoted_at, demoted_at, current, rank, rank_share}]`. `ratio` is against the champion it took over from: its total time over that champion's, so lower is faster.\n \n-`speedup_vs_shipped` is the shipped kernels' time over this champion's, so higher is faster: 1 divided by the product of the ratios along the chain of code each champion was timed against, ending at the shipped code the first promotion was timed against. The chain follows hashes, not promotion order, because after a demotion the next challenger is timed against the older champion the board fell back to. It is null when the chain is broken (a missing ratio, or a reference that is neither shipped nor an earlier promotion). Each link is its own bench run, so it is an estimate whose noise grows with the chain; clients should read it rather than multiply ratios themselves. A newer promotion supersedes a champion without demoting it, and `demoted_at` records an explicit operator demotion, which hands the board back to the newest earlier champion not demoted -- so `current` says who holds the board.\n+`speedup_vs_shipped` is the shipped kernels' time over this champion's, so higher is faster: 1 divided by the product of the ratios along the chain of code each champion was timed against, ending at the shipped code the first promotion was timed against. The chain follows hashes, not promotion order, because after a demotion the next challenger is timed against the older champion the board fell back to. It is null when the chain is broken (a missing ratio, or a reference that is neither shipped nor an earlier promotion). A chain never crosses a benchmark change: each ratio is timed on one benchmark (the legacy classes, or a suite), so a champion timed on a suite against a legacy-timed one has no speed-up unless an operator has recorded a measured anchor for it on that suite, from which later champions on the same suite chain. `speedup_basis` names the benchmark the figure is on (`legacy`, or the suite's version) and is null with it; figures on different bases are not comparable. Each link is its own bench run, so it is an estimate whose noise grows with the chain; clients should read it rather than multiply ratios themselves. A newer promotion supersedes a champion without demoting it, and `demoted_at` records an explicit operator demotion, which hands the board back to the newest earlier champion not demoted -- so `current` says who holds the board.\n \n `rank` is the reward rank (1 is the current champion), and `rank_share` is that rank's fraction of the slot winner share. These use the latest published `policy.rank_shares` and the current non-demoted promotion history. Missing ranks are not redistributed; a hotkey can hold multiple ranks. Both fields are null for older champions, unpaid practice boards, and publications without a valid rank policy. They describe the reward rule, not proof that an on-chain payout has occurred; pause withholding and the competition's emission share apply separately.\n "},{"sha":"bbcac103dec0d74e1a2a706099db739659409052","filename":"docs/openapi.json","status":"modified","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/conjectures-io/conjectures-validator/blob/e78afe97f93cbdae1f65f354a8e8d12b355f2020/docs%2Fopenapi.json","raw_url":"https://github.com/conjectures-io/conjectures-validator/raw/e78afe97f93cbdae1f65f354a8e8d12b355f2020/docs%2Fopenapi.json","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-validator/contents/docs%2Fopenapi.json?ref=e78afe97f93cbdae1f65f354a8e8d12b355f2020","patch":"@@ -1751,6 +1751,17 @@\n             ],\n             \"title\": \"Ratio\"\n           },\n+          \"speedup_basis\": {\n+            \"anyOf\": [\n+              {\n+                \"type\": \"string\"\n+              },\n+              {\n+                \"type\": \"null\"\n+              }\n+            ],\n+            \"title\": \"Speedup Basis\"\n+          },\n           \"speedup_vs_shipped\": {\n             \"anyOf\": [\n               {"},{"sha":"79804bfa53b818297cea005e6012160a25557973","filename":"submission_api/floatlib_store.py","status":"modified","additions":58,"deletions":8,"changes":66,"blob_url":"https://github.com/conjectures-io/conjectures-validator/blob/e78afe97f93cbdae1f65f354a8e8d12b355f2020/submission_api%2Ffloatlib_store.py","raw_url":"https://github.com/conjectures-io/conjectures-validator/raw/e78afe97f93cbdae1f65f354a8e8d12b355f2020/submission_api%2Ffloatlib_store.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-validator/contents/submission_api%2Ffloatlib_store.py?ref=e78afe97f93cbdae1f65f354a8e8d12b355f2020","patch":"@@ -14,6 +14,8 @@\n \n from __future__ import annotations\n \n+import json\n+\n from sqlalchemy import text\n \n from submission_api.errors import ServiceUnavailable\n@@ -89,16 +91,52 @@ async def promotions(session, slot):\n         text(\"\"\"\n         SELECT p.id AS promotion_id, p.promoted_at, p.demoted_at,\n                p.champion_sha256 AS promoted_sha256, s.id, s.hotkey, s.ratio,\n-               s.champion_sha256 AS timed_against\n+               s.champion_sha256 AS timed_against, s.report\n         FROM promotions p JOIN submissions s ON s.id = p.submission_id\n         WHERE p.slot = :slot ORDER BY p.id DESC\n     \"\"\"),\n         {\"slot\": slot},\n     )\n-    return [dict(row) for row in rows.mappings()]\n-\n-\n-def speedups(history):\n+    history = []\n+    for row in rows.mappings():\n+        promotion = dict(row)\n+        promotion[\"benchmark\"] = benchmark_of(promotion.pop(\"report\"))\n+        history.append(promotion)\n+    return history\n+\n+\n+# The fixed twelve classes FloatLib scored on before its suites: what a verdict without a suite\n+# was timed on.\n+LEGACY = \"legacy\"\n+\n+# Measured speed-ups over the shipped kernels, by benchmark and the promoted Kernel.lean's sha256.\n+# A benchmark change breaks the chain of ratios (each link is timed on one benchmark); an anchor\n+# restarts it on the new one: that promotion's speed-up is the measured value, and later\n+# promotions on the same benchmark chain from it. Each is one operator bench run of the kernel\n+# against the shipped one on that benchmark, recorded here with how it was measured.\n+SPEEDUP_ANCHORS: dict[tuple[str, str], float] = {\n+    # #265, the first champion timed on this suite, against the shipped kernels on it: one PROD\n+    # gate --bench run per seed on 2026-10-22, ratios 0.4615 (11), 0.4459 (23), 0.4506 (37);\n+    # 1 / their geometric mean.\n+    (\n+        \"scoring-v2-2026-10\",\n+        \"494ebfa20c8d8f0f6b93eac4684579f6382f8ee21b767c787b9da924d15fc5fe\",\n+    ): 2.209,\n+}\n+\n+\n+def benchmark_of(report):\n+    \"\"\"The benchmark a verdict was timed on: its suite's version, or `LEGACY` without one.\"\"\"\n+    try:\n+        suite = json.loads(report).get(\"suite\") if report else None\n+    except (ValueError, AttributeError):\n+        suite = None\n+    if isinstance(suite, dict) and suite.get(\"version\"):\n+        return str(suite[\"version\"])\n+    return LEGACY\n+\n+\n+def speedups(history, anchors=None):\n     \"\"\"Each promotion's speed-up over the shipped kernels, by promotion id; None where unknown.\n \n     `ratio` is the promoted submission's total time over the code it was timed against\n@@ -109,16 +147,27 @@ def speedups(history):\n     shipped code, which the first promotion was timed against. The speed-up is 1 / the product of\n     the ratios along it.\n \n+    Every link must be timed on the promotion's own benchmark (`benchmark`): a ratio from a\n+    suite times nothing on the legacy classes, so a chain does not cross a benchmark change.\n+    There, an anchor in `anchors` (default `SPEEDUP_ANCHORS`) restarts it with a measured value;\n+    without one the promotion and those chained from it have none.\n+\n     None when the chain cannot be followed: a missing ratio, a reference that is neither shipped\n-    nor an earlier promotion. Each link is a separate bench run, so the product is an estimate\n-    whose noise compounds with the chain's length.\n+    nor an earlier promotion, or a parent on another benchmark with no anchor. Each link is a\n+    separate bench run, so the product is an estimate whose noise compounds with the chain's length.\n     \"\"\"\n     if not history:\n         return {}\n+    anchors = SPEEDUP_ANCHORS if anchors is None else anchors\n     ordered = sorted(history, key=lambda p: p[\"promotion_id\"])\n     shipped = ordered[0][\"timed_against\"]\n     result = {}\n     for index, promotion in enumerate(ordered):\n+        benchmark = promotion.get(\"benchmark\", LEGACY)\n+        anchored = anchors.get((benchmark, promotion[\"promoted_sha256\"]))\n+        if anchored is not None:\n+            result[promotion[\"promotion_id\"]] = anchored\n+            continue\n         ratio = promotion[\"ratio\"]\n         reference = promotion[\"timed_against\"]\n         if ratio is None or ratio <= 0 or reference is None or shipped is None:\n@@ -131,7 +180,8 @@ def speedups(history):\n                 (p for p in reversed(ordered[:index]) if p[\"promoted_sha256\"] == reference),\n                 None,\n             )\n-            base = None if parent is None else result.get(parent[\"promotion_id\"])\n+            same = parent is not None and parent.get(\"benchmark\", LEGACY) == benchmark\n+            base = result.get(parent[\"promotion_id\"]) if same else None\n         result[promotion[\"promotion_id\"]] = None if base is None else base / ratio\n     return result\n "},{"sha":"82434f1b0f32ca1ab308a1712eea83dd1fa08284","filename":"submission_api/routers/floatlib.py","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/conjectures-io/conjectures-validator/blob/e78afe97f93cbdae1f65f354a8e8d12b355f2020/submission_api%2Frouters%2Ffloatlib.py","raw_url":"https://github.com/conjectures-io/conjectures-validator/raw/e78afe97f93cbdae1f65f354a8e8d12b355f2020/submission_api%2Frouters%2Ffloatlib.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-validator/contents/submission_api%2Frouters%2Ffloatlib.py?ref=e78afe97f93cbdae1f65f354a8e8d12b355f2020","patch":"@@ -354,6 +354,7 @@ async def champions(board: BoardPath, services: ServicesDep, session: Competitio\n             hotkey=p[\"hotkey\"],\n             ratio=p[\"ratio\"],\n             speedup_vs_shipped=speedups.get(p[\"promotion_id\"]),\n+            speedup_basis=p[\"benchmark\"] if speedups.get(p[\"promotion_id\"]) is not None else None,\n             promoted_at=iso(p[\"promoted_at\"]),\n             demoted_at=iso(p[\"demoted_at\"]) if p[\"demoted_at\"] is not None else None,\n             current=current is not None and p[\"promotion_id\"] == current[\"promotion_id\"],"},{"sha":"c0fc12e786e74c6f5155da091bfa1014b7ba2709","filename":"submission_api/schemas_floatlib.py","status":"modified","additions":6,"deletions":2,"changes":8,"blob_url":"https://github.com/conjectures-io/conjectures-validator/blob/e78afe97f93cbdae1f65f354a8e8d12b355f2020/submission_api%2Fschemas_floatlib.py","raw_url":"https://github.com/conjectures-io/conjectures-validator/raw/e78afe97f93cbdae1f65f354a8e8d12b355f2020/submission_api%2Fschemas_floatlib.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-validator/contents/submission_api%2Fschemas_floatlib.py?ref=e78afe97f93cbdae1f65f354a8e8d12b355f2020","patch":"@@ -101,9 +101,13 @@ class Champion(BaseModel):\n     # Against the champion it took over from: its total time over that champion's, lower faster.\n     ratio: float | None = None\n     # Shipped kernels' time over this champion's, higher faster: 1 / the product of the ratios\n-    # along the chain of champions each was timed against. Null when that chain is broken. Each\n-    # link is its own bench run, so this is an estimate. See `floatlib_store.speedups`.\n+    # along the chain of champions each was timed against. Null when that chain is broken,\n+    # including where it would cross a benchmark change with no measured anchor. Each link is its\n+    # own bench run, so this is an estimate. See `floatlib_store.speedups`.\n     speedup_vs_shipped: float | None = None\n+    # The benchmark `speedup_vs_shipped` is measured on: \"legacy\" for the fixed classes, otherwise\n+    # the suite's version. Figures on different benchmarks are not comparable. Null with it.\n+    speedup_basis: str | None = None\n     promoted_at: str\n     # Set only when its own bench failed too often and it was demoted.\n     demoted_at: str | None = None"},{"sha":"0a6aa99fcb42082ac28d8dd70ab0d46d85b49689","filename":"tests/test_floatlib_api.py","status":"modified","additions":46,"deletions":0,"changes":46,"blob_url":"https://github.com/conjectures-io/conjectures-validator/blob/e78afe97f93cbdae1f65f354a8e8d12b355f2020/tests%2Ftest_floatlib_api.py","raw_url":"https://github.com/conjectures-io/conjectures-validator/raw/e78afe97f93cbdae1f65f354a8e8d12b355f2020/tests%2Ftest_floatlib_api.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-validator/contents/tests%2Ftest_floatlib_api.py?ref=e78afe97f93cbdae1f65f354a8e8d12b355f2020","patch":"@@ -34,6 +34,7 @@\n     UnknownCompetition,\n )\n from submission_api.dependencies import get_services\n+from submission_api import floatlib_store as store_module\n from submission_api.errors import ApiError, api_error_handler\n from submission_api.routers import competition_reads, competitions as intake, floatlib\n from submission_api.settings import SettingsError\n@@ -483,6 +484,7 @@ def test_champions_lists_every_champion_and_marks_the_one_holding_the_board(floa\n         \"ratio\": 0.8,\n         # Timed against the shipped code: 1 / 0.8.\n         \"speedup_vs_shipped\": 1.25,\n+        \"speedup_basis\": \"legacy\",\n         \"promoted_at\": \"2026-10-08T10:05:00Z\",\n         \"demoted_at\": None,\n         \"current\": True,\n@@ -531,6 +533,50 @@ def test_speedup_follows_the_code_each_champion_was_timed_against(floatlib_db):\n     assert {c[\"submission\"]: c[\"speedup_vs_shipped\"] for c in broken.json()}[3] is None\n \n \n+def test_a_speedup_does_not_chain_across_a_benchmark_change(floatlib_db, monkeypatch):\n+    \"\"\"Bob was timed on a suite against Alice's legacy-timed code: his ratio says nothing about\n+    the legacy classes, so without a measured anchor he has no speed-up; with one, he and the\n+    suite champions after him do, labelled with the suite.\"\"\"\n+    suite = json.dumps({\"suite\": {\"version\": \"scoring-v2-test\", \"sha256\": \"e\" * 64}})\n+    execute(\n+        floatlib_db,\n+        \"UPDATE submissions SET report = :report WHERE id IN (2, 3)\",\n+        report=suite,\n+    )\n+    execute(\n+        floatlib_db,\n+        \"INSERT INTO promotions (slot, submission_id, champion_sha256, promoted_at) \"\n+        \"VALUES ('full', 2, :digest, :at)\",\n+        digest=\"2\" * 64,\n+        at=T0 + timedelta(hours=1),\n+    )\n+    execute(\n+        floatlib_db,\n+        \"UPDATE submissions SET champion_sha256 = :bob, ratio = 0.5 WHERE id = 3\",\n+        bob=\"2\" * 64,\n+    )\n+    execute(\n+        floatlib_db,\n+        \"INSERT INTO promotions (slot, submission_id, champion_sha256, promoted_at) \"\n+        \"VALUES ('full', 3, :digest, :at)\",\n+        digest=\"3\" * 64,\n+        at=T0 + timedelta(hours=2),\n+    )\n+    (response,) = read(floatlib_db, \"/v1/competitions/floatlib/champions\")\n+    by_id = {c[\"submission\"]: c for c in response.json()}\n+    assert (by_id[1][\"speedup_vs_shipped\"], by_id[1][\"speedup_basis\"]) == (1.25, \"legacy\")\n+    for sub in (2, 3):\n+        assert (by_id[sub][\"speedup_vs_shipped\"], by_id[sub][\"speedup_basis\"]) == (None, None)\n+\n+    monkeypatch.setattr(store_module, \"SPEEDUP_ANCHORS\", {(\"scoring-v2-test\", \"2\" * 64): 3.0})\n+    (anchored,) = read(floatlib_db, \"/v1/competitions/floatlib/champions\")\n+    by_id = {c[\"submission\"]: c for c in anchored.json()}\n+    assert (by_id[2][\"speedup_vs_shipped\"], by_id[2][\"speedup_basis\"]) == (3.0, \"scoring-v2-test\")\n+    assert by_id[3][\"speedup_vs_shipped\"] == pytest.approx(3.0 / 0.5)\n+    assert by_id[3][\"speedup_basis\"] == \"scoring-v2-test\"\n+    assert by_id[1][\"speedup_vs_shipped\"] == 1.25\n+\n+\n def test_a_submission_reads_in_floatlibs_shape_and_only_under_its_own_slot(floatlib_db):\n     view, report, elsewhere = read(\n         floatlib_db,"},{"sha":"0f43e9f59b5733ba2ce7652a9a88b1bf6d70ee4d","filename":"tests/test_floatlib_speedups.py","status":"added","additions":82,"deletions":0,"changes":82,"blob_url":"https://github.com/conjectures-io/conjectures-validator/blob/e78afe97f93cbdae1f65f354a8e8d12b355f2020/tests%2Ftest_floatlib_speedups.py","raw_url":"https://github.com/conjectures-io/conjectures-validator/raw/e78afe97f93cbdae1f65f354a8e8d12b355f2020/tests%2Ftest_floatlib_speedups.py","contents_url":"https://api.github.com/repos/conjectures-io/conjectures-validator/contents/tests%2Ftest_floatlib_speedups.py?ref=e78afe97f93cbdae1f65f354a8e8d12b355f2020","patch":"@@ -0,0 +1,82 @@\n+\"\"\"FloatLib's speed-up chain: one benchmark per chain, restarted on a new one only by an anchor.\"\"\"\n+\n+from __future__ import annotations\n+\n+import json\n+\n+import pytest\n+\n+pytest.importorskip(\"sqlalchemy\", reason=\"the FloatLib store needs sqlalchemy\")\n+\n+from submission_api.floatlib_store import (  # noqa: E402\n+    LEGACY,\n+    SPEEDUP_ANCHORS,\n+    benchmark_of,\n+    speedups,\n+)\n+\n+SHIPPED = \"0\" * 64\n+SUITE = \"scoring-v2-test\"\n+\n+\n+def promotion(pid, sha, timed_against, ratio, benchmark=LEGACY):\n+    return {\n+        \"promotion_id\": pid,\n+        \"promoted_sha256\": sha,\n+        \"timed_against\": timed_against,\n+        \"ratio\": ratio,\n+        \"benchmark\": benchmark,\n+    }\n+\n+\n+# Two legacy promotions, then three on a suite: the first suite one was timed against the last\n+# legacy champion, like PROD's #265 against #174.\n+HISTORY = [\n+    promotion(1, \"a\", SHIPPED, 0.5),\n+    promotion(2, \"b\", \"a\", 0.8),\n+    promotion(3, \"c\", \"b\", 0.03, SUITE),\n+    promotion(4, \"d\", \"c\", 0.75, SUITE),\n+    promotion(5, \"e\", \"d\", 0.8, SUITE),\n+]\n+\n+\n+def test_legacy_chains_are_unchanged_and_a_cross_benchmark_link_breaks_the_chain():\n+    result = speedups(HISTORY, anchors={})\n+    assert result[1] == pytest.approx(2.0)\n+    assert result[2] == pytest.approx(2.0 / 0.8)\n+    # Not 2.5 / 0.03 / 0.75 / 0.8 = 138.9: ratios from two benchmarks do not multiply.\n+    assert result[3] is None and result[4] is None and result[5] is None\n+\n+\n+def test_an_anchor_restarts_the_chain_on_the_new_benchmark():\n+    result = speedups(HISTORY, anchors={(SUITE, \"c\"): 2.2})\n+    assert result[2] == pytest.approx(2.5)\n+    assert result[3] == pytest.approx(2.2)\n+    assert result[4] == pytest.approx(2.2 / 0.75)\n+    assert result[5] == pytest.approx(2.2 / 0.75 / 0.8)\n+    # An anchor for another benchmark, or another kernel, changes nothing.\n+    assert speedups(HISTORY, anchors={(\"other-suite\", \"c\"): 2.2})[3] is None\n+    assert speedups(HISTORY, anchors={(SUITE, \"b\"): 2.2})[3] is None\n+\n+\n+def test_a_suite_promotion_timed_against_the_shipped_code_needs_no_anchor():\n+    history = [promotion(1, \"a\", SHIPPED, 0.4, SUITE), promotion(2, \"b\", \"a\", 0.5, SUITE)]\n+    result = speedups(history, anchors={})\n+    assert result == {1: pytest.approx(2.5), 2: pytest.approx(5.0)}\n+\n+\n+def test_the_benchmark_is_read_from_the_verdict():\n+    assert benchmark_of(json.dumps({\"suite\": {\"version\": SUITE, \"sha256\": \"f\" * 64}})) == SUITE\n+    assert benchmark_of(json.dumps({\"stage\": \"score\", \"ratio\": 0.9})) == LEGACY\n+    assert benchmark_of(json.dumps({\"suite\": {}})) == LEGACY\n+    assert benchmark_of(None) == LEGACY\n+    assert benchmark_of(\"not json\") == LEGACY\n+    assert benchmark_of(\"[1, 2]\") == LEGACY\n+\n+\n+def test_every_recorded_anchor_names_a_suite_and_a_kernel_hash():\n+    # A typo here would silently leave a chain broken; a legacy anchor would mask the legacy chain.\n+    for (benchmark, sha256), value in SPEEDUP_ANCHORS.items():\n+        assert benchmark != LEGACY and benchmark\n+        assert len(sha256) == 64 and all(c in \"0123456789abcdef\" for c in sha256)\n+        assert 0 < value < 10_000"}]}