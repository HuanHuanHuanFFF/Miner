+def samePaddedWidth (p : Nat) : Prop := 4*((p+3)/4) = 2*((p+1)/2)
+
+theorem samePaddedWidth_small (p : Nat) (hp : 3≤p ∧ p≤8) :
+    samePaddedWidth p ↔ p=3 ∨ p=4 ∨ p=7 ∨ p=8 := by
+  unfold samePaddedWidth
+  omega
