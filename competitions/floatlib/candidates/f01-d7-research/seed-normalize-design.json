  "proof_signatures": {
    "D7SeedNormalize.add_posZero_of_not_snan": {
      "block_line": 190,
      "declaration": "theorem add_posZero_of_not_snan (q : Competition.Binary32)\n    (hq : Model.isSNaN (ExecFloat.Binary.toModel q) = false) :\n    ExecFloat.add Competition.posZero q = normalizeProductSeedRaw q := by\n  cases hn : (ExecFloat.Binary.toFloat32 q).isNaN with\n  | false => exact add_posZero_of_not_nan q hn\n  | true =>\n      have hnan : Model.isNaN (ExecFloat.Binary.toModel q) = true :=\n        (toFloat32_isNaN q).symm.trans hn\n      exact (exec_posZero_add_quiet q hnan hq).trans\n        (normalizeProductSeedRaw_of_nan q hnan).symm",
      "new_integration": "NOT_RUN"
    },
    "D7SeedNormalize.exec_mul_not_snan": {
      "block_line": 201,
      "declaration": "theorem exec_mul_not_snan (x y : Competition.Binary32) :\n    Model.isSNaN (ExecFloat.Binary.toModel (ExecFloat.mul x y)) = false := by\n  rw [R7W01.exec_toModel_mul]\n  exact R7W01.mul32_not_snan _ _",
      "new_integration": "NOT_RUN"
    },
    "D7SeedNormalize.add_posZero_mul": {
      "block_line": 207,
      "declaration": "theorem add_posZero_mul (x y : Competition.Binary32) :\n    ExecFloat.add Competition.posZero (ExecFloat.mul x y) =\n      normalizeProductSeedRaw (ExecFloat.mul x y) :=\n  add_posZero_of_not_snan _ (exec_mul_not_snan x y)",
      "new_integration": "NOT_RUN"
    },
    "D7SeedNormalize.add_posZero_mul_raw_conditional": {
      "block_line": 217,
      "declaration": "theorem add_posZero_mul_raw_conditional (x y : Competition.Binary32) :\n    (ExecFloat.add Competition.posZero (ExecFloat.mul x y)).raw.1 =\n      if (ExecFloat.mul x y).raw.1 == (0x80000000 : UInt32)\n      then (0 : UInt32) else (ExecFloat.mul x y).raw.1 := by\n  rw [add_posZero_mul, normalizeProductSeedRaw_raw]",
      "new_integration": "NOT_RUN"
    },
    "D7SeedNormalize.submission_add_posZero_mul": {
      "block_line": 223,
      "declaration": "theorem submission_add_posZero_mul (x y : Competition.Binary32) :\n    Submission.add Competition.posZero (Submission.mul x y) =\n      normalizeProductSeedRaw (Submission.mul x y) := by\n  simpa only [Submission.add_eq, Submission.mul_eq] using add_posZero_mul x y",
      "new_integration": "NOT_RUN"
    },
    "D7SeedNormalize.normalize_submission_mul_eq_add": {
      "block_line": 228,
      "declaration": "theorem normalize_submission_mul_eq_add (x y : Competition.Binary32) :\n    normalizeProductSeedRaw (Submission.mul x y) =\n      Submission.add Competition.posZero (Submission.mul x y) :=\n  (submission_add_posZero_mul x y).symm",
      "new_integration": "NOT_RUN"
    },
    "D7SeedNormalize.submission_add_posZero_mul_raw_conditional": {
      "block_line": 233,
      "declaration": "theorem submission_add_posZero_mul_raw_conditional (x y : Competition.Binary32) :\n    (Submission.add Competition.posZero (Submission.mul x y)).raw.1 =\n      if (Submission.mul x y).raw.1 == (0x80000000 : UInt32)\n      then (0 : UInt32) else (Submission.mul x y).raw.1 := by\n  simpa only [Submission.add_eq, Submission.mul_eq] using\n    add_posZero_mul_raw_conditional x y",
      "new_integration": "NOT_RUN"
    }
  },
