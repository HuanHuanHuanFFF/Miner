theorem c3_write_post {input : Slice Std.U8} {out out1 : Slice Std.U32}
    {pos d ntok ntok1 end1 a : Std.Usize} {full : Nat} {v : Std.U32}
    (hout : input.length ≤ out.length) (hntok : ntok.val ≤ pos.val)
    (hdec : LZ77.decode (toks out ntok.val) = some ((bytes input).take pos.val))
    (hf3 : 3 ≤ full) (hf258 : full ≤ 258)
    (hd1 : 1 ≤ d.val) (hd32 : d.val ≤ 32768) (hdpos : d.val ≤ pos.val)
    (hfull : pos.val + full ≤ input.length)
    (hm : Matches input a.val pos.val full) (ha : a.val = pos.val - d.val)
    (hout1 : out1 = out.set ntok v) (hv : v.val = LZ77.mkMatch d.val full)
    (hntok1 : ntok1.val = ntok.val + 1) (hend1 : end1.val = pos.val + full) :
    pos.val < end1.val ∧ end1.val ≤ input.length ∧ ntok1.val ≤ end1.val ∧
    out1.length = out.length ∧
    LZ77.decode (toks out1 ntok1.val) = some ((bytes input).take end1.val) := by
  have hidx : ntok.val < out.length := by omega
  have hm' : Matches input (pos.val - d.val) pos.val full := by
    rw [← ha]
    exact hm
  refine ⟨by omega, by omega, by omega, ?_, ?_⟩
  · rw [hout1]
    simp only [Std.Slice.set_length]
  · rw [hout1, hntok1, hend1]
    exact emit_match input out ntok pos.val d.val full v hdec hidx hd1 hdpos hd32
      hf3 hf258 hfull hm' hv

theorem c3_cap_spec (rem : Std.Usize) :
    (if rem < 258#usize then ok rem else ok 258#usize) ⦃ fun cap =>
      cap.val ≤ 258 ∧ cap.val ≤ rem.val ⦄ := by
  split <;> simp only [Std.WP.spec_ok] <;> scalar_tac

@[local step]
theorem c3_emit_step_spec (input : Slice Std.U8) (out : Slice Std.U32)
    (pos d l lits ntok : Std.Usize)
    (hout : input.length ≤ out.length) (hpos : pos.val < input.length)
    (hntok : ntok.val ≤ pos.val)
    (hdec : LZ77.decode (toks out ntok.val) = some ((bytes input).take pos.val)) :
    slot.c3_emit_step input out pos d l lits ntok ⦃ fun r =>
      pos.val < r.1.2.val ∧ r.1.2.val ≤ input.length ∧ r.1.1.val ≤ r.1.2.val ∧
      r.2.length = out.length ∧
      LZ77.decode (toks r.2 r.1.1.val) = some ((bytes input).take r.1.2.val) ⦄ := by
  rw [slot.c3_emit_step]
  have hmax : input.length ≤ Std.Usize.max := Std.Slice.length_ineq input
  step*
  -- The real proof1 goal stops at this exact cap bind. The inferred argument
  -- avoids referencing the inaccessible name generated by step* for rem.
  apply Std.WP.spec_bind (c3_cap_spec _)
  intro cap hcap
  obtain ⟨hcap258, hcaprem⟩ := hcap
  have hcap_end : pos.val + cap.val + 8 ≤ input.length := by scalar_tac
  step*
  all_goals first
    | (match goal with
       | hm : Matches input _ pos.val ?full |- _ =>
         apply c3_write_post (input := input) (out := out) (pos := pos)
           (d := d) (full := full) (ntok := ntok)
         all_goals first | assumption | (simp only [LZ77.mkMatch, LZ77.MATCH_BASE]; scalar_tac))
    | (exact ⟨by scalar_tac, by scalar_tac, by scalar_tac,
          by assumption, by assumption⟩)
    | (apply Std.WP.spec_mono (emit_step_spec input out pos d _ lits ntok
          hout hpos hntok hdec)
       intro r hr
       exact hr)
    | (apply Std.WP.spec_mono (emit_lits_spec input out pos lits ntok
          hout (by omega) hntok hdec)
       rintro ⟨⟨t, k⟩, o⟩ ⟨h1, h2, h3, h4, h5⟩
       exact ⟨by omega, h2, h3, h4, h5⟩)

