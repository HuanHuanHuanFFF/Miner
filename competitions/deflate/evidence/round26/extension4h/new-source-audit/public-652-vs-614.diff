+pub fn d_filt(s: &[u8], i: usize, b8: u64, best: usize) -> (usize, u64, u64) {
+    if best < 7 {
+        (0, b8, 1u64 << ((56 - 8 * best) % 64))
+    } else if best < 8 {
+        (0, b8, 1)
+    } else {
+        let w = best - 7;
+        (w, be8(s, i + w), 1)
+    }
