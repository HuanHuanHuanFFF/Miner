+                }
+                while step > 0 && p < lim {
+                    nt = u118_put_lit(input, out, nt, p);
+                    p += 1;
+                    step -= 1;
+                }
+                if ins < p {
+                    ins = p;
+                }
+            }
+        }
+    }
+    while p < n {
+        nt = u118_put_lit(input, out, nt, p);
+        p += 1;
+    }
+    nt
