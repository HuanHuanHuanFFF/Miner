+pub fn r107_c_probe(input:&[u8],cache:&mut[u32;8192],stats:&mut[u32;128])->usize {
+ if input.len()>32768 {return 0;}
+ let mut temp=[0u32;32768];
+ let nt=fx0_run::<4096,16384,2,258>(input,&mut temp,6);
+ if nt>8192 {return 0;}
+ let mut i=0usize;
+ while i<nt && i<8192 {
+  let t=temp[i%32768];
+  if t>=16777216 {
+   let m=(t as usize).wrapping_sub(16777216);
+   let l=(m%256)+3;let d=((m/256)%32768)+1;
+   cache[i%8192]=(l+d*512) as u32;r107_c_add(stats,l,d);
+  } else {cache[i%8192]=1;}
+  i+=1;
+ }
+ input.len()
+}
