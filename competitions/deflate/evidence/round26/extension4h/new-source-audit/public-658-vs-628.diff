+        while p < lim && fuel > 0 {
+            fuel -= 1;
+            while ins < p {
+                u118_insert(input, &mut head, &mut prev, ins, mask);
+                ins += 1;
+            }
+            // `ins == p` here (a match leaves `ins = end = p`, literals leave `ins = p`)
+            let hc = u118_insert(input, &mut head, &mut prev, p, mask);
+            ins = p + 1;
