+                    }
+                    let g = u118_find(input, &prev, q, hq, have, minl, ldep, nice, 1, hlit);
+                    if g.0 >= minl && u118_gain(g.0, g.1, hlit) > u118_gain(l, d, hlit) {
+                        nt = u118_put_lit(input, out, nt, p);
+                        p = q;
+                        l = g.0;
+                        d = g.1;
+                    } else {
