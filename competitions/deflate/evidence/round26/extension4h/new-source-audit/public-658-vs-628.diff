+                                if g2.0 >= minl && u118_gain(g2.0, g2.1, hlit) > u118_gain(l, d, hlit) + u118_L2B {
+                                    nt = u118_put_lit(input, out, nt, p);
+                                    nt = u118_put_lit(input, out, nt, p + 1);
+                                    p = q2;
+                                    l = g2.0;
+                                    d = g2.1;
+                                    go = 1;
+                                }
+                            }
+                        }
+                    }
+                }
+                // Fold earlier tokens into this match while their bytes also match at d.
+                let mut back = 0usize;
+                while back < u118_BACKTOK && nt > 0 && nt <= out.len() && l < 258 && d < p {
+                    let t = out[nt - 1];
+                    if t < 256 && input[p - 1] == input[p - 1 - d] {
+                        p -= 1;
+                        nt -= 1;
+                        l += 1;
+                        back += 1;
+                    } else if t >= 16777216 {
+                        let w = ((t - 16777216) % 256 + 3) as usize;
+                        if l + w <= 258 && w <= p && d <= p - w && u118_same(input, p - w - d, p - w, w) == 1 {
+                            p -= w;
+                            nt -= 1;
+                            l += w;
+                            back += 1;
+                        } else {
+                            let r = u118_part_merge(input, out, &prev, nt, p, l, d, t, w);
+                            p = r.0;
+                            l = r.1;
+                            back = u118_BACKTOK;
+                        }
+                    } else {
+                        back = u118_BACKTOK;
+                    }
+                }
+                let r = u118_put_match(input, out, nt, p, d, l);
+                nt = r.0;
+                let end = r.1;
+                // Chain the first u118_INS_MAX and the last u118_TAIL positions inside the match.
+                let mut stop = end;
+                // wrapping: u118_same code as `+` here (no overflow on any real input), total in the model
+                if stop > ins.wrapping_add(insm) {
+                    stop = ins.wrapping_add(insm);
+                }
+                if stop > lim {
+                    stop = lim;
+                }
+                while ins < stop {
+                    u118_insert(input, &mut head, &mut prev, ins, mask);
+                    ins += 1;
+                }
+                if stride > 0 {
+                    // `ins + u118_TAIL + stride < end`, with the bound computed once (total in the model)
+                    let e2 = end.saturating_sub(u118_TAIL.saturating_add(stride));
+                    while ins < e2 && ins < lim {
+                        u118_insert(input, &mut head, &mut prev, ins, mask);
+                        ins += stride;
+                    }
+                }
+                if ins.wrapping_add(u118_TAIL) < end {
+                    ins = end - u118_TAIL;
+                }
+                while ins < end && ins < lim {
+                    u118_insert(input, &mut head, &mut prev, ins, mask);
+                    ins += 1;
+                }
+                if ins < end {
+                    ins = end;
+                }
+                p = end;
+                miss = 0;
+            } else {
+                nt = u118_put_lit(input, out, nt, p);
+                p += 1;
+                miss += 1;
+                let mut step = miss >> skip;
+                if step > skcap {
