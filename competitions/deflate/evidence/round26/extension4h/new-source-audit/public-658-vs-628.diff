+    let a = ((x & 0x00FF00FF00FF00FF) << 8) | ((x >> 8) & 0x00FF00FF00FF00FF);
+    let b = ((a & 0x0000FFFF0000FFFF) << 16) | ((a >> 16) & 0x0000FFFF0000FFFF);
+    let c = (b << 32) | (b >> 32);
+    ((c | 1).leading_zeros() / 8) as usize
+}
