+/// Best match at `p` longer than `have` and at least `minl` long; (0, 0) when none.
+
+#[inline(always)]
+pub fn u118_find<const W: usize>(s: &[u8], prev: &[u32; W], p: usize, st: usize, have: usize, minl: usize, depth: usize, nice: usize, gm: usize, hlit: i32) -> (usize, usize) {
+    let n = s.len();
+    let mut cap = n - p;
+    if cap > 258 {
+        cap = 258;
+    }
+    let mut lo = have;
+    if lo + 1 < minl {
+        lo = minl - 1;
+    }
+    let f = u118_walk(s, prev, p, st, cap, lo, depth, nice, gm, hlit);
+    let mut l = f.0;
+    if f.1 == 0 {
+        l = 0;
+    }
+    (l, f.1)
+}
