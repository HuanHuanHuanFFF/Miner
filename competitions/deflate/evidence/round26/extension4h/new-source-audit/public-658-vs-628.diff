+pub fn r107_cached<const B:usize,const DB:u32>(input:&[u8],out:&mut[u32])->usize{
+ let mut cache=[0u32;8192];let mut stats=[0u32;128];let p=r107_c_probe(input,&mut cache,&mut stats);
+ if p>=input.len(){
+  let mut q=[0usize;320];r107_c_table::<B,DB>(&stats,&mut q);
+  let r=r107_c_replay(input,out,&cache,&q);
+  if r.1<input.len(){fallback(input,out)}else{r.0}
+ }else{fallback(input,out)}
+}
