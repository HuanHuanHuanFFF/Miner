+pub fn r109_rawscan<const H:usize,const MODE:usize>(s:&[u8],out:&mut[u32]){
+ let mut head=[0u32;H];let mut p=1usize;
+ if s.len()>=3{
+  let half=(s.len()-1)/2;
+  while p<s.len()-2{
+   let x=(s[p]as u32)|((s[p+1]as u32)<<8)|((s[p+2]as u32)<<16);
