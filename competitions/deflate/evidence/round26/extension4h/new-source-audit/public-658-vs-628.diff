+                miss = 0;
+            } else {
+                nt = fx0_put_lit(input, out, nt, p);
+                p += 1;
+                miss += 1;
+                let mut step = miss >> skip;
+                if step > skcap {
+                    step = skcap;
+                }
+                while step > 0 && p < lim {
+                    nt = fx0_put_lit(input, out, nt, p);
+                    p += 1;
+                    step -= 1;
+                }
+                if ins < p {
+                    ins = p;
+                }
+            }
+        }
+    }
+    while p < n {
+        nt = fx0_put_lit(input, out, nt, p);
+        p += 1;
+    }
+    nt
