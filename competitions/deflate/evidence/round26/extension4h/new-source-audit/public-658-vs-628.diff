+    let n = input.len();
+    let mut nt = 0usize;
+    let mut p = 0usize;
+    let mask = MASK;
+    let minl = MINL;
+    let depth = DEPTH;
+    let lazy = LAZY;
+    let skip = SKIP;
+    let skcap = CAP;
+    let nice = STOP;
+    let ldep = LD;
+    let insm = INS;
+    let stride = STR;
+    let hlit = LIT;
