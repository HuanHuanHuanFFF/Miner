+/// Put position `i` at the head of its chain (key = first four bytes under `mask`);
+/// returns the previous head.
+
+#[inline(always)]
+pub fn u118_insert<const H: usize, const W: usize>(s: &[u8], head: &mut [u32; H], prev: &mut [u32; W], i: usize, mask: u32) -> usize {
+    let k = (u118_be4(s, i) & mask) as u64;
+    let a = (k.wrapping_mul(0x9E37_79B9_7F4A_7C15) >> (64 - u118_HB)) as usize % H;
+    let old = head[a];
+    prev[i % W] = old;
+    head[a] = i as u32;
+    old as usize
+}
