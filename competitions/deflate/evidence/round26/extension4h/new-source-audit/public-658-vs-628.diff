+pub fn r107_c_add(stats:&mut[u32;128],l:usize,d:usize){
+ let a=o_a_sh_lc(l)%29;let b=o_a_sh_dc(d)%30;
+ stats[a]=stats[a].wrapping_add(1);stats[29+a]=stats[29+a].wrapping_add(l as u32);
+ stats[64+b]=stats[64+b].wrapping_add(1);stats[96+b]=stats[96+b].wrapping_add(l as u32);
+}
+
+pub fn r107_c_table<const B:usize,const DB:u32>(stats:&[u32;128],q:&mut[usize;320]){
+ let lb=[3usize,4,5,6,7,8,9,10,11,13,15,17,19,23,27,31,35,43,51,59,67,83,99,115,131,163,195,227,258];
+ let mut best=0usize;let mut c=0usize;
+ while c<29{
+  let begin=lb[c];let end=if c<28{lb[c+1]}else{259};
+  let mut waste=(stats[29+c]as usize).wrapping_sub(best.wrapping_mul(stats[c]as usize));
+  if best==0{waste=waste.saturating_sub(4usize.wrapping_mul(stats[c]as usize));}
+  let keep=if waste>B{1}else{0};
+  o_a_sh_fill(q,begin,end,best,keep);
+  if keep==1{best=end.wrapping_sub(1);}
+  c+=1;
+ }
+ c=0;
+ while c<30{
+  let gain=stats[96+c].saturating_sub(4u32.wrapping_mul(stats[64+c]));
+  q[259+c]=if gain<=DB{1}else{0};c+=1;
+ }
+}
