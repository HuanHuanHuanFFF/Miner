lemma r28MulIndex (a b c t:Nat) (ha:a<b) (ht:t<c):a*c+t<b*c:=by
 have hh:(a+1)*c<=b*c:=Nat.mul_le_mul_right c (Nat.succ_le_of_lt ha)
 rw[Nat.add_mul,Nat.one_mul]at hh
 omega

